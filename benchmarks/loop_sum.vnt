# Shared C/Rust/VNT workload: 20 rounds of 1,000,000 integer iterations.
# Function locals exercise the native unboxed-scalar backend.
# Final checksum: 499999500000.
fun add_value(accumulator, value) {
    return accumulator + value
}

fun run_benchmark() {
    round = 0
    i = 0
    total = 0
    while round < 20 {
        i = 0
        total = 0
        while i < 1000000 {
            total = add_value(total, i)
            i = i + 1
        }
        round = round + 1
    }
    print(total)
}
run_benchmark()
