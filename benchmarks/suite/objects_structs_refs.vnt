struct Vec2 {
    x,
    y
}
fun sum8(a, b, c, d, e, f, g, h) {
    return a + b + c + d + e + f + g + h
}
x = 10
p = &x
print(*p)
*p = 42
point = Vec2()
point.x = 12
point.y = 30
print(point.x + point.y)
print(sum8(1, 2, 3, 4, 5, 6, 7, 8))
print(ffi_int("kernel32.dll", "GetCurrentProcessId"))
print("OBJECTS_STRUCTS_REFS_OK")
