# VNT-native recursive-descent expression and program parser.
# The returned tree is an owned VNT object graph; it deliberately does not
# depend on the C AST allocator or compiler internals.

import "./lexer.vnt" as lexer

fun parser_append(values, value) {
    size = len(values)
    result = range(size + 1)
    i = 0
    while i < size {
        result[i] = values[i]
        i += 1
    }
    result[size] = value
    return result
}

fun make_node(kind: string) -> object {
    node = object()
    node.kind = kind
    return node
}

fun make_leaf(kind: string, value: string) -> object {
    node = make_node(kind)
    node.value = value
    return node
}

fun current(state: object) -> object {
    return state.tokens[state.index]
}

fun check(state: object, kind: string) -> bool {
    return current(state).kind == kind
}

fun parser_advance(state: object) -> object {
    token = current(state)
    if token.kind != "EOF" {
        state.index += 1
    }
    return token
}

fun match(state: object, kind: string) -> bool {
    if check(state, kind) {
        parser_advance(state)
        return true
    }
    return false
}

fun fail(state: object, message: string) {
    if state.error == "" {
        token = current(state)
        state.error = message + " at " + token.line + ":" + token.column
    }
}

fun note_operator(state: object) -> bool {
    state.operator_count += 1
    if state.operator_count > 256 {
        fail(state, "expression exceeds 256 operator nodes")
        return false
    }
    return true
}

fun decode_string(value: string) -> string {
    decoded = ""
    i = 0
    while i < len(value) {
        ch = value[i]
        if ch == "\\" && i + 1 < len(value) {
            i += 1
            escaped = value[i]
            if escaped == "n" {
                decoded = decoded + "\n"
            } else {
                if escaped == "r" {
                    decoded = decoded + "\r"
                } else {
                    if escaped == "t" {
                        decoded = decoded + "\t"
                    } else {
                        if escaped == "\\" || escaped == "\"" {
                            decoded = decoded + escaped
                        } else {
                            decoded = decoded + "\\" + escaped
                        }
                    }
                }
            }
        } else {
            decoded = decoded + ch
        }
        i += 1
    }
    return decoded
}

fun parse_call_arguments(state: object, name: string) -> object {
    args = []
    if !check(state, "RIGHT_PAREN") {
        parsing = true
        while parsing && state.error == "" {
            argument = parse_or(state)
            if state.error != "" {
                return make_node("ERROR")
            }
            args = parser_append(args, argument)
            if match(state, "COMMA") {
                if check(state, "RIGHT_PAREN") {
                    fail(state, "trailing comma in call")
                    return make_node("ERROR")
                }
            } else {
                parsing = false
            }
        }
    }
    if !match(state, "RIGHT_PAREN") {
        fail(state, "expected ')' after arguments")
        return make_node("ERROR")
    }
    node = make_node("CALL")
    node.name = name
    node.arguments = args
    return node
}

fun parse_primary(state: object) -> object {
    token = current(state)
    if match(state, "INTEGER") {
        return make_leaf("INTEGER", token.lexeme)
    }
    if match(state, "FLOAT") {
        return make_leaf("FLOAT", token.lexeme)
    }
    if match(state, "STRING") {
        return make_leaf("STRING", decode_string(token.lexeme))
    }
    if match(state, "IDENTIFIER") {
        if token.lexeme == "true" {
            return make_leaf("BOOLEAN", "true")
        }
        if token.lexeme == "false" {
            return make_leaf("BOOLEAN", "false")
        }
        if token.lexeme == "null" {
            return make_leaf("NULL", "null")
        }
        if match(state, "LEFT_PAREN") {
            return parse_call_arguments(state, token.lexeme)
        }
        return make_leaf("VARIABLE", token.lexeme)
    }
    if match(state, "LEFT_PAREN") {
        expression = parse_or(state)
        if !match(state, "RIGHT_PAREN") {
            fail(state, "expected ')'")
            return make_node("ERROR")
        }
        return expression
    }
    if match(state, "LEFT_BRACKET") {
        elements = []
        if !check(state, "RIGHT_BRACKET") {
            parsing = true
            while parsing && state.error == "" {
                element = parse_or(state)
                if state.error != "" {
                    return make_node("ERROR")
                }
                elements = parser_append(elements, element)
                if match(state, "COMMA") {
                    if check(state, "RIGHT_BRACKET") {
                        parsing = false
                    }
                } else {
                    parsing = false
                }
            }
        }
        if !match(state, "RIGHT_BRACKET") {
            fail(state, "expected ']' after array elements")
            return make_node("ERROR")
        }
        node = make_node("ARRAY")
        node.elements = elements
        return node
    }
    fail(state, "expected expression")
    return make_node("ERROR")
}

fun parse_postfix(state: object) -> object {
    expression = parse_primary(state)
    while state.error == "" {
        if match(state, "LEFT_BRACKET") {
            if !note_operator(state) { return make_node("ERROR") }
            index = parse_or(state)
            if !match(state, "RIGHT_BRACKET") {
                fail(state, "expected ']' after index")
                return make_node("ERROR")
            }
            node = make_node("INDEX")
            node.object = expression
            node.index = index
            expression = node
        } else {
            if match(state, "DOT") {
                if !note_operator(state) { return make_node("ERROR") }
                if !check(state, "IDENTIFIER") {
                    fail(state, "expected member name after '.'")
                    return make_node("ERROR")
                }
                member = parser_advance(state)
                node = make_node("MEMBER")
                node.object = expression
                node.member = member.lexeme
                expression = node
            } else {
                if check(state, "LEFT_PAREN") && expression.kind == "MEMBER" && expression.object.kind == "VARIABLE" {
                    parser_advance(state)
                    qualified_name = expression.object.value + "__" + expression.member
                    expression = parse_call_arguments(state, qualified_name)
                } else {
                    break
                }
            }
        }
    }
    return expression
}

fun parse_unary(state: object) -> object {
    if check(state, "BANG") || check(state, "MINUS") || check(state, "AMPERSAND") || check(state, "STAR") {
        if state.nesting_depth >= 256 {
            fail(state, "unary operator nesting exceeds 256 levels")
            return make_node("ERROR")
        }
        state.nesting_depth += 1
        operator = parser_advance(state)
        operand = parse_unary(state)
        state.nesting_depth -= 1
        node = make_node("UNARY")
        node.operator = operator.lexeme
        node.operand = operand
        return node
    }
    return parse_postfix(state)
}

fun parse_multiplication(state: object) -> object {
    left = parse_unary(state)
    while check(state, "STAR") || check(state, "SLASH") || check(state, "PERCENT") {
        if !note_operator(state) { return make_node("ERROR") }
        operator = parser_advance(state)
        right = parse_unary(state)
        node = make_node("BINARY")
        node.operator = operator.lexeme
        node.left = left
        node.right = right
        left = node
    }
    return left
}

fun parse_addition(state: object) -> object {
    left = parse_multiplication(state)
    while check(state, "PLUS") || check(state, "MINUS") {
        if !note_operator(state) { return make_node("ERROR") }
        operator = parser_advance(state)
        right = parse_multiplication(state)
        node = make_node("BINARY")
        node.operator = operator.lexeme
        node.left = left
        node.right = right
        left = node
    }
    return left
}

fun parse_comparison(state: object) -> object {
    left = parse_addition(state)
    while check(state, "GREATER") || check(state, "LESS") || check(state, "GREATER_EQUAL") || check(state, "LESS_EQUAL") {
        if !note_operator(state) { return make_node("ERROR") }
        operator = parser_advance(state)
        right = parse_addition(state)
        node = make_node("BINARY")
        node.operator = operator.lexeme
        node.left = left
        node.right = right
        left = node
    }
    return left
}

fun parse_equality(state: object) -> object {
    left = parse_comparison(state)
    while check(state, "EQUAL_EQUAL") || check(state, "BANG_EQUAL") {
        if !note_operator(state) { return make_node("ERROR") }
        operator = parser_advance(state)
        right = parse_comparison(state)
        node = make_node("BINARY")
        node.operator = operator.lexeme
        node.left = left
        node.right = right
        left = node
    }
    return left
}

fun parse_and(state: object) -> object {
    left = parse_equality(state)
    while state.error == "" && match(state, "AND_AND") {
        if !note_operator(state) { return make_node("ERROR") }
        right = parse_equality(state)
        node = make_node("BINARY")
        node.operator = "&&"
        node.left = left
        node.right = right
        left = node
    }
    return left
}

fun parse_or(state: object) -> object {
    if state.expression_depth == 0 {
        state.operator_count = 0
    }
    if state.nesting_depth >= 256 {
        fail(state, "expression nesting exceeds 256 levels")
        return make_node("ERROR")
    }
    state.expression_depth += 1
    state.nesting_depth += 1
    left = parse_and(state)
    while state.error == "" && match(state, "OR_OR") {
        if !note_operator(state) {
            state.nesting_depth -= 1
            state.expression_depth -= 1
            return make_node("ERROR")
        }
        right = parse_and(state)
        node = make_node("BINARY")
        node.operator = "||"
        node.left = left
        node.right = right
        left = node
    }
    state.nesting_depth -= 1
    state.expression_depth -= 1
    return left
}

export fun parse(source: string) -> object {
    scanned = lexer.lex(source)
    result = object()
    result.ok = false
    result.error = ""
    result.expression = make_node("ERROR")
    if !scanned.ok {
        if len(scanned.errors) > 0 {
            result.error = scanned.errors[0]
        } else {
            result.error = "lexical analysis failed"
        }
        return result
    }

    state = object()
    state.tokens = scanned.tokens
    state.index = 0
    state.error = ""
    state.operator_count = 0
    state.nesting_depth = 0
    state.expression_depth = 0
    expression = parse_or(state)
    if state.error == "" && !check(state, "EOF") {
        fail(state, "unexpected token after expression")
    }
    result.error = state.error
    result.ok = state.error == ""
    if result.ok {
        result.expression = expression
    }
    return result
}


fun expect(state: object, kind: string, message: string) -> bool {
    if match(state, kind) {
        return true
    }
    fail(state, message)
    return false
}

fun parse_block(state: object) -> array {
    statements = []
    while !check(state, "RIGHT_BRACE") && !check(state, "EOF") && state.error == "" {
        statement = parse_statement(state)
        if state.error != "" {
            return []
        }
        statements = parser_append(statements, statement)
    }
    if !expect(state, "RIGHT_BRACE", "expected '}' to close block") {
        return []
    }
    return statements
}

fun parse_let_statement(state: object) -> object {
    parser_advance(state)
    if !expect(state, "IDENTIFIER", "expected variable name after 'let'") {
        return make_node("ERROR")
    }
    name = state.previous.lexeme
    if !expect(state, "COLON", "expected ':' after typed variable name") {
        return make_node("ERROR")
    }
    if !expect(state, "IDENTIFIER", "expected type name after ':'") {
        return make_node("ERROR")
    }
    declared_type = state.previous.lexeme
    if !expect(state, "EQUALS", "expected '=' after variable type") {
        return make_node("ERROR")
    }
    value = parse_or(state)
    node = make_node("VARIABLE_DECLARATION")
    node.name = name
    node.declared_type = declared_type
    node.value = value
    return node
}

fun parse_print_statement(state: object) -> object {
    parser_advance(state)
    if !expect(state, "LEFT_PAREN", "expected '(' after print") {
        return make_node("ERROR")
    }
    expression = parse_or(state)
    if !expect(state, "RIGHT_PAREN", "expected ')' after print expression") {
        return make_node("ERROR")
    }
    node = make_node("PRINT")
    node.expression = expression
    return node
}

fun parse_return_statement(state: object) -> object {
    keyword = parser_advance(state)
    expression = null
    if !check(state, "RIGHT_BRACE") && !check(state, "EOF") && current(state).line == keyword.line {
        expression = parse_or(state)
    }
    node = make_node("RETURN")
    node.expression = expression
    return node
}

fun parse_if_statement(state: object) -> object {
    parser_advance(state)
    condition = parse_or(state)
    if !expect(state, "LEFT_BRACE", "expected '{' after if condition") {
        return make_node("ERROR")
    }
    then_branch = parse_block(state)
    else_branch = []
    if state.error == "" && check(state, "IDENTIFIER") && current(state).lexeme == "else" {
        parser_advance(state)
        if check(state, "IDENTIFIER") && current(state).lexeme == "if" {
            else_branch = [parse_statement(state)]
        } else {
            if !expect(state, "LEFT_BRACE", "expected '{' or 'if' after else") {
                return make_node("ERROR")
            }
            else_branch = parse_block(state)
        }
    }
    node = make_node("IF")
    node.condition = condition
    node.then_branch = then_branch
    node.else_branch = else_branch
    return node
}

fun parse_while_statement(state: object) -> object {
    parser_advance(state)
    condition = parse_or(state)
    if !expect(state, "LEFT_BRACE", "expected '{' after while condition") {
        return make_node("ERROR")
    }
    body = parse_block(state)
    node = make_node("WHILE")
    node.condition = condition
    node.body = body
    return node
}

fun parse_for_statement(state: object) -> object {
    parser_advance(state)
    if !expect(state, "IDENTIFIER", "expected loop variable after 'for'") {
        return make_node("ERROR")
    }
    name = state.previous.lexeme
    if !check(state, "IDENTIFIER") || current(state).lexeme != "in" {
        fail(state, "expected 'in' after for variable")
        return make_node("ERROR")
    }
    parser_advance(state)
    iterable = parse_or(state)
    if !expect(state, "LEFT_BRACE", "expected '{' after for expression") {
        return make_node("ERROR")
    }
    body = parse_block(state)
    node = make_node("FOR")
    node.name = name
    node.iterable = iterable
    node.body = body
    return node
}

fun parse_function_statement(state: object, is_unsafe: bool) -> object {
    parser_advance(state)
    if !expect(state, "IDENTIFIER", "expected function name") {
        return make_node("ERROR")
    }
    name = state.previous.lexeme
    if !expect(state, "LEFT_PAREN", "expected '(' after function name") {
        return make_node("ERROR")
    }
    parameters = []
    if !check(state, "RIGHT_PAREN") {
        parsing = true
        while parsing && state.error == "" {
            if !expect(state, "IDENTIFIER", "expected parameter name") {
                return make_node("ERROR")
            }
            parameter = object()
            parameter.name = state.previous.lexeme
            parameter.type = null
            if match(state, "COLON") {
                if !expect(state, "IDENTIFIER", "expected parameter type after ':'") {
                    return make_node("ERROR")
                }
                parameter.type = state.previous.lexeme
            }
            parameters = parser_append(parameters, parameter)
            if match(state, "COMMA") {
                if check(state, "RIGHT_PAREN") {
                    fail(state, "trailing comma in parameter list")
                    return make_node("ERROR")
                }
            } else {
                parsing = false
            }
        }
    }
    if !expect(state, "RIGHT_PAREN", "expected ')' after parameters") {
        return make_node("ERROR")
    }
    return_type = null
    if match(state, "MINUS") {
        if !expect(state, "GREATER", "expected '>' after '-' in return type") {
            return make_node("ERROR")
        }
        if !expect(state, "IDENTIFIER", "expected function return type") {
            return make_node("ERROR")
        }
        return_type = state.previous.lexeme
    }
    if !expect(state, "LEFT_BRACE", "expected '{' before function body") {
        return make_node("ERROR")
    }
    body = parse_block(state)
    node = make_node("FUNCTION")
    node.name = name
    node.parameters = parameters
    node.return_type = return_type
    node.is_unsafe = is_unsafe
    node.body = body
    return node
}

fun parse_struct_statement(state: object) -> object {
    parser_advance(state)
    if !expect(state, "IDENTIFIER", "expected struct name") {
        return make_node("ERROR")
    }
    name = state.previous.lexeme
    if !expect(state, "LEFT_BRACE", "expected '{' after struct name") {
        return make_node("ERROR")
    }
    fields = []
    if !check(state, "RIGHT_BRACE") {
        parsing = true
        while parsing && state.error == "" {
            if !expect(state, "IDENTIFIER", "expected struct field name") {
                return make_node("ERROR")
            }
            fields = parser_append(fields, state.previous.lexeme)
            if match(state, "COMMA") {
                if check(state, "RIGHT_BRACE") {
                    parsing = false
                }
            } else {
                parsing = false
            }
        }
    }
    if !expect(state, "RIGHT_BRACE", "expected '}' after struct fields") {
        return make_node("ERROR")
    }
    node = make_node("STRUCT")
    node.name = name
    node.fields = fields
    return node
}

fun parse_asm_statement(state: object) -> object {
    parser_advance(state)
    is_volatile = false
    if check(state, "IDENTIFIER") && current(state).lexeme == "volatile" {
        parser_advance(state)
        is_volatile = true
    }
    if !expect(state, "LEFT_PAREN", "expected '(' after asm") {
        return make_node("ERROR")
    }
    if !expect(state, "STRING", "expected assembly template string") {
        return make_node("ERROR")
    }
    assembly = state.previous.lexeme
    if !expect(state, "RIGHT_PAREN", "expected ')' after assembly template") {
        return make_node("ERROR")
    }
    node = make_node("ASM")
    node.assembly = assembly
    node.is_volatile = is_volatile
    return node
}

fun compound_operator(kind: string) -> string {
    if kind == "PLUS_EQUALS" { return "+" }
    if kind == "MINUS_EQUALS" { return "-" }
    if kind == "STAR_EQUALS" { return "*" }
    if kind == "SLASH_EQUALS" { return "/" }
    return "%"
}

fun is_assignment_target(node: object) -> bool {
    return node.kind == "VARIABLE" || node.kind == "INDEX" || node.kind == "MEMBER"
}

fun parse_assignment_or_call(state: object) -> object {
    target = parse_or(state)
    if state.error != "" {
        return make_node("ERROR")
    }
    operator = current(state)
    if operator.kind == "EQUALS" || operator.kind == "PLUS_EQUALS" || operator.kind == "MINUS_EQUALS" || operator.kind == "STAR_EQUALS" || operator.kind == "SLASH_EQUALS" || operator.kind == "PERCENT_EQUALS" {
        if !is_assignment_target(target) {
            fail(state, "invalid assignment target")
            return make_node("ERROR")
        }
        parser_advance(state)
        value = parse_or(state)
        if operator.kind != "EQUALS" {
            binary = make_node("BINARY")
            binary.operator = compound_operator(operator.kind)
            binary.left = target
            binary.right = value
            value = binary
        }
        if target.kind == "VARIABLE" {
            node = make_node("VARIABLE_DECLARATION")
            node.name = target.value
            node.declared_type = null
            node.value = value
            return node
        }
        node = make_node("ASSIGNMENT")
        node.target = target
        node.value = value
        return node
    }
    if target.kind == "CALL" {
        return target
    }
    fail(state, "expected assignment operator or function call")
    return make_node("ERROR")
}

fun parse_statement(state: object) -> object {
    if state.nesting_depth >= 256 {
        fail(state, "statement nesting exceeds 256 levels")
        return make_node("ERROR")
    }
    state.nesting_depth += 1
    token = current(state)
    node = make_node("ERROR")
    if token.kind == "EOF" || token.kind == "RIGHT_BRACE" {
        fail(state, "expected statement")
    } else {
        if token.kind == "STAR" {
            target = parse_unary(state)
            operator = current(state)
            if operator.kind == "EQUALS" || operator.kind == "PLUS_EQUALS" || operator.kind == "MINUS_EQUALS" || operator.kind == "STAR_EQUALS" || operator.kind == "SLASH_EQUALS" || operator.kind == "PERCENT_EQUALS" {
                parser_advance(state)
                value = parse_or(state)
                if operator.kind != "EQUALS" {
                    binary = make_node("BINARY")
                    binary.operator = compound_operator(operator.kind)
                    binary.left = target
                    binary.right = value
                    value = binary
                }
                node = make_node("ASSIGNMENT")
                node.target = target
                node.value = value
            } else {
                fail(state, "expected assignment operator after dereference")
            }
        } else {
            if token.kind == "IDENTIFIER" && token.lexeme == "let" {
                node = parse_let_statement(state)
            } else {
                if token.kind == "IDENTIFIER" && token.lexeme == "print" {
                    node = parse_print_statement(state)
                } else {
                    if token.kind == "IDENTIFIER" && token.lexeme == "return" {
                        node = parse_return_statement(state)
                    } else {
                        if token.kind == "IDENTIFIER" && token.lexeme == "break" {
                            parser_advance(state)
                            node = make_node("BREAK")
                        } else {
                            if token.kind == "IDENTIFIER" && token.lexeme == "continue" {
                                parser_advance(state)
                                node = make_node("CONTINUE")
                            } else {
                                if token.kind == "IDENTIFIER" && token.lexeme == "if" {
                                    node = parse_if_statement(state)
                                } else {
                                    if token.kind == "IDENTIFIER" && token.lexeme == "while" {
                                        node = parse_while_statement(state)
                                    } else {
                                        if token.kind == "IDENTIFIER" && token.lexeme == "for" {
                                            node = parse_for_statement(state)
                                        } else {
                                            if token.kind == "IDENTIFIER" && token.lexeme == "fun" {
                                                node = parse_function_statement(state, false)
                                            } else {
                                                if token.kind == "IDENTIFIER" && token.lexeme == "struct" {
                                                    node = parse_struct_statement(state)
                                                } else {
                                                    if token.kind == "IDENTIFIER" && token.lexeme == "unsafe" {
                                                        parser_advance(state)
                                                        if check(state, "IDENTIFIER") && current(state).lexeme == "fun" {
                                                            node = parse_function_statement(state, true)
                                                        } else {
                                                            if !expect(state, "LEFT_BRACE", "expected '{' or 'fun' after unsafe") {
                                                                node = make_node("ERROR")
                                                            } else {
                                                                body = parse_block(state)
                                                                node = make_node("UNSAFE")
                                                                node.body = body
                                                            }
                                                        }
                                                    } else {
                                                        if token.kind == "IDENTIFIER" && token.lexeme == "asm" {
                                                            node = parse_asm_statement(state)
                                                        } else {
                                                            if token.kind == "IDENTIFIER" {
                                                                node = parse_assignment_or_call(state)
                                                            } else {
                                                                fail(state, "expected a statement")
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    state.nesting_depth -= 1
    return node
}

export fun parse_program(source: string) -> object {
    scanned = lexer.lex(source)
    result = object()
    result.ok = false
    result.error = ""
    result.statements = []
    if !scanned.ok {
        if len(scanned.errors) > 0 {
            result.error = scanned.errors[0]
        } else {
            result.error = "lexical analysis failed"
        }
        return result
    }
    state = object()
    state.tokens = scanned.tokens
    state.index = 0
    state.error = ""
    state.operator_count = 0
    state.nesting_depth = 0
    state.expression_depth = 0
    while !check(state, "EOF") && state.error == "" {
        statement = parse_statement(state)
        if state.error == "" {
            result.statements = parser_append(result.statements, statement)
        }
    }
    result.error = state.error
    result.ok = state.error == ""
    return result
}
