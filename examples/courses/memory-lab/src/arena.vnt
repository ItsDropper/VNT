# Memory Lab arena: one owned allocation, aligned subregions, and explicit accounting.
# All raw memory access is confined to these functions.
import "../../../lib/std/mem.vnt" as mem
import "../../../lib/std/array.vnt" as arrays

let ml_base: ptr = null
let ml_capacity: int = 0
let ml_cursor: int = 0
let ml_payload: int = 0
let ml_padding: int = 0
let ml_count: int = 0
let ml_offsets: array = []
let ml_sizes: array = []
let ml_alignments: array = []
let ml_ids: array = []

export fun arena_init(capacity: int) -> bool {
    if capacity <= 0 || ml_base != null {
        return false
    }
    let candidate: ptr = null
    unsafe {
        candidate = mem.alloc(capacity)
        if mem.is_null(candidate) {
            return false
        }
    }
    ml_base = candidate
    ml_capacity = capacity
    ml_cursor = 0
    ml_payload = 0
    ml_padding = 0
    ml_count = 0
    ml_offsets = []
    ml_sizes = []
    ml_alignments = []
    ml_ids = []
    return true
}

# Supports alignments 1, 2, 4, 8, and 16. The allocator's backing allocation
# is obtained from the native allocator, whose base is suitably aligned for
# these fundamental alignments on the supported x86-64 host.
export fun arena_reserve(size: int, alignment: int) -> ptr {
    if ml_base == null || size <= 0 || alignment <= 0 || size > ml_capacity {
        return null
    }
    if alignment != 1 && alignment != 2 && alignment != 4 && alignment != 8 && alignment != 16 {
        return null
    }

    # Find the next aligned offset without a bit-mask formula. This avoids
    # addition overflow in cursor + alignment - 1.
    let start: int = ml_cursor
    while start % alignment != 0 {
        start += 1
    }
    if start > ml_capacity {
        return null
    }
    # Subtraction form avoids overflow in start + size.
    if size > ml_capacity - start {
        return null
    }
    let end: int = start + size
    let padding: int = start - ml_cursor
    let result: ptr = null
    unsafe {
        result = mem.offset(ml_base, start)
    }
    if result == null {
        return null
    }

    # Commit state only after every validation has succeeded.
    ml_offsets = arrays.concat(ml_offsets, [start])
    ml_sizes = arrays.concat(ml_sizes, [size])
    ml_alignments = arrays.concat(ml_alignments, [alignment])
    ml_ids = arrays.concat(ml_ids, [ml_count + 1])
    ml_count += 1
    ml_cursor = end
    ml_payload += size
    ml_padding += padding
    return result
}

export fun arena_reset() -> bool {
    if ml_base == null {
        return false
    }
    # Reset invalidates every prior reservation even though backing storage
    # remains allocated. Callers must stop using old pointers before reset.
    ml_cursor = 0
    ml_payload = 0
    ml_padding = 0
    ml_count = 0
    ml_offsets = []
    ml_sizes = []
    ml_alignments = []
    ml_ids = []
    return true
}

export fun arena_destroy() -> bool {
    if ml_base == null {
        ml_capacity = 0
        ml_cursor = 0
        ml_payload = 0
        ml_padding = 0
        return true
    }
    let released: bool = false
    unsafe {
        released = mem.free(ml_base)
    }
    if !released {
        return false
    }
    ml_base = null
    ml_capacity = 0
    ml_cursor = 0
    ml_payload = 0
    ml_padding = 0
    ml_count = 0
    ml_offsets = []
    ml_sizes = []
    ml_alignments = []
    ml_ids = []
    return true
}

export fun arena_is_initialized() -> bool {
    return ml_base != null
}

export fun arena_capacity() -> int {
    return ml_capacity
}

export fun arena_consumed() -> int {
    return ml_cursor
}

export fun arena_payload_bytes() -> int {
    return ml_payload
}

export fun arena_padding_bytes() -> int {
    return ml_padding
}

export fun arena_remaining() -> int {
    if ml_cursor > ml_capacity {
        return -1
    }
    return ml_capacity - ml_cursor
}

export fun arena_allocation_count() -> int {
    return ml_count
}

export fun arena_allocation_offset(index: int) -> int {
    if index < 0 || index >= ml_count {
        return -1
    }
    return ml_offsets[index]
}

export fun arena_allocation_size(index: int) -> int {
    if index < 0 || index >= ml_count {
        return -1
    }
    return ml_sizes[index]
}

export fun arena_allocation_alignment(index: int) -> int {
    if index < 0 || index >= ml_count {
        return -1
    }
    return ml_alignments[index]
}

export fun arena_invariants_hold() -> bool {
    if ml_base == null {
        return ml_capacity == 0 && ml_cursor == 0
    }
    if ml_capacity <= 0 || ml_cursor < 0 || ml_cursor > ml_capacity {
        return false
    }
    if ml_payload < 0 || ml_padding < 0 || ml_payload + ml_padding != ml_cursor {
        return false
    }
    if len(ml_offsets) != ml_count || len(ml_sizes) != ml_count || len(ml_alignments) != ml_count {
        return false
    }
    return true
}
