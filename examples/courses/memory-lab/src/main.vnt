# Multi-file demo: mixed alignments, exact accounting, reset, and independent phases.
import "./arena.vnt" as arena
import "./report.vnt" as report
import "./inspect.vnt" as inspect

let capacity: int = 128
if arena.arena_init(capacity) {
    print("Phase 1: mixed aligned reservations")
    unsafe {
        let first: ptr = arena.arena_reserve(7, 1)
        let second: ptr = arena.arena_reserve(8, 8)
        let third: ptr = arena.arena_reserve(12, 4)
        if first == null || second == null || third == null {
            print("reservation failed")
        } else {
            let a: bool = inspect.write_pattern(first, 7, 17)
            let b: bool = inspect.write_pattern(second, 8, 34)
            let c: bool = inspect.write_pattern(third, 12, 51)
            print(a)
            print(b)
            print(c)
            print(inspect.verify_pattern(first, 7, 17))
            print(inspect.verify_pattern(second, 8, 34))
            print(inspect.verify_pattern(third, 12, 51))
        }
    }
    report.print_arena_report()
    report.print_allocation_table()

    print("Phase 2: failed reservation must preserve state")
    let before: int = arena.arena_consumed()
    let rejected: ptr = arena.arena_reserve(1000, 8)
    print(rejected == null)
    print(before == arena.arena_consumed())
    print(arena.arena_invariants_hold())

    print("Phase 3: reset begins a new logical lifetime")
    print(arena.arena_reset())
    report.print_arena_report()
    let after_reset: ptr = arena.arena_reserve(16, 16)
    print(after_reset != null)
    print(arena.arena_invariants_hold())
    report.print_arena_report()
    print("destroy:")
    print(arena.arena_destroy())
    print(arena.arena_invariants_hold())
} else {
    print("Could not initialize memory lab arena.")
}
