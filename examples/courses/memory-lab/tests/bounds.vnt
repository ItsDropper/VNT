# Deterministic regression checks for rejected allocations and state atomicity.
import "../src/arena.vnt" as arena

if arena.arena_init(16) {
    let before: int = arena.arena_consumed()
    let zero_size: ptr = arena.arena_reserve(0, 1)
    let too_large: ptr = arena.arena_reserve(17, 1)
    let bad_alignment: ptr = arena.arena_reserve(1, 3)
    if zero_size != null || too_large != null || bad_alignment != null {
        print("MEMORY_LAB_FAIL: invalid request accepted")
    } else {
        print("MEMORY_LAB_PASS: invalid requests rejected")
    }
    if arena.arena_consumed() != before {
        print("MEMORY_LAB_FAIL: rejected request changed cursor")
    } else {
        print("MEMORY_LAB_PASS: failure is atomic")
    }
    if !arena.arena_invariants_hold() {
        print("MEMORY_LAB_FAIL: invariant broken")
    } else {
        print("MEMORY_LAB_PASS: invariant holds")
    }
    print(arena.arena_destroy())
} else {
    print("MEMORY_LAB_FAIL: initialization")
}
