# Ethernet/IPv4 ARP packet parser and builder for fixtures only.
import "./bytes.vnt" as bytes

export fun parse_arp(packet: array) -> array {
    # Ethernet/IPv4 ARP payload is 28 bytes for MAC(6)/IPv4(4) addresses.
    if len(packet) < 28 {
        return []
    }
    let hardware_type: int = bytes.read_be16(packet, 0)
    let protocol_type: int = bytes.read_be16(packet, 2)
    let hardware_length: int = packet[4]
    let protocol_length: int = packet[5]
    let operation: int = bytes.read_be16(packet, 6)
    if hardware_type != 1 || protocol_type != 2048 || hardware_length != 6 || protocol_length != 4 {
        return []
    }
    if operation != 1 && operation != 2 {
        return []
    }
    # [operation, sender MAC x6, sender IPv4 x4, target MAC x6, target IPv4 x4]
    let result: array = range(21)
    result[0] = operation
    let i: int = 0
    while i < 6 {
        result[1 + i] = packet[8 + i]
        result[11 + i] = packet[18 + i]
        i += 1
    }
    i = 0
    while i < 4 {
        result[7 + i] = packet[14 + i]
        result[17 + i] = packet[24 + i]
        i += 1
    }
    return result
}

export fun build_arp(operation: int, sender_mac: array, sender_ip: array, target_mac: array, target_ip: array) -> array {
    if operation != 1 && operation != 2 {
        return []
    }
    if len(sender_mac) != 6 || len(target_mac) != 6 || len(sender_ip) != 4 || len(target_ip) != 4 {
        return []
    }
    let packet: array = range(28)
    if !bytes.write_be16(packet, 0, 1) || !bytes.write_be16(packet, 2, 2048) {
        return []
    }
    packet[4] = 6
    packet[5] = 4
    if !bytes.write_be16(packet, 6, operation) {
        return []
    }
    let i: int = 0
    while i < 6 {
        packet[8 + i] = sender_mac[i]
        packet[18 + i] = target_mac[i]
        i += 1
    }
    i = 0
    while i < 4 {
        packet[14 + i] = sender_ip[i]
        packet[24 + i] = target_ip[i]
        i += 1
    }
    return packet
}
