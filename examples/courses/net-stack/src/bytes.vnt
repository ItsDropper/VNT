# Byte-oriented wire-format helpers. Protocol code must use these instead of
# repeating offset arithmetic throughout the project.
export fun read_u8(buffer: array, offset: int) -> int {
    if offset < 0 || offset >= len(buffer) {
        return -1
    }
    let value: int = buffer[offset]
    if value < 0 || value > 255 {
        return -1
    }
    return value
}

export fun read_be16(buffer: array, offset: int) -> int {
    if offset < 0 || len(buffer) < 2 || offset > len(buffer) - 2 {
        return -1
    }
    let high: int = buffer[offset]
    let low: int = buffer[offset + 1]
    if high < 0 || high > 255 || low < 0 || low > 255 {
        return -1
    }
    return high * 256 + low
}

export fun write_u8(buffer: array, offset: int, value: int) -> bool {
    if offset < 0 || offset >= len(buffer) || value < 0 || value > 255 {
        return false
    }
    buffer[offset] = value
    return true
}

export fun write_be16(buffer: array, offset: int, value: int) -> bool {
    if offset < 0 || len(buffer) < 2 || offset > len(buffer) - 2 {
        return false
    }
    if value < 0 || value > 65535 {
        return false
    }
    buffer[offset] = value / 256
    buffer[offset + 1] = value % 256
    return true
}

export fun slice(buffer: array, start: int, count: int) -> array {
    if start < 0 || count < 0 || start > len(buffer) || count > len(buffer) - start {
        return []
    }
    let result: array = range(count)
    let i: int = 0
    while i < count {
        result[i] = buffer[start + i]
        i += 1
    }
    return result
}

export fun append_bytes(left: array, right: array) -> array {
    let result: array = range(len(left) + len(right))
    let i: int = 0
    while i < len(left) {
        result[i] = left[i]
        i += 1
    }
    i = 0
    while i < len(right) {
        result[len(left) + i] = right[i]
        i += 1
    }
    return result
}
