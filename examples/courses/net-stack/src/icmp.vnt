# ICMPv4 echo message parser/builder. This module never transmits anything.
import "./bytes.vnt" as bytes
import "./checksum.vnt" as checksum

export fun parse_echo(message: array) -> array {
    if len(message) < 8 || checksum.internet_checksum(message) != 0 {
        return []
    }
    if message[0] != 8 || message[1] != 0 {
        return []
    }
    let identifier: int = bytes.read_be16(message, 4)
    let sequence: int = bytes.read_be16(message, 6)
    return [identifier, sequence, len(message) - 8]
}

export fun build_echo_reply(request: array) -> array {
    let fields: array = parse_echo(request)
    if len(fields) != 3 {
        return []
    }
    let reply: array = bytes.slice(request, 0, len(request))
    reply[0] = 0
    reply[1] = 0
    reply[2] = 0
    reply[3] = 0
    let value: int = checksum.internet_checksum(reply)
    if !bytes.write_be16(reply, 2, value) {
        return []
    }
    return reply
}
