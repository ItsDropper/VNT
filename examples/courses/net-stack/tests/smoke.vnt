# Basic parser boundary tests. Each case is a synthetic byte array.
import "../src/bytes.vnt" as bytes
import "../src/ethernet.vnt" as ethernet
import "../src/ipv4.vnt" as ipv4
import "../src/udp.vnt" as udp

let short_frame: array = [0, 1, 2, 3, 4, 5, 6]
if len(ethernet.parse_frame(short_frame)) != 0 {
    print("NET_STACK_FAIL: short Ethernet accepted")
} else {
    print("NET_STACK_PASS: short Ethernet rejected")
}

let short_udp: array = [0, 1, 0, 2, 0, 8, 0]
if len(udp.parse_udp(short_udp)) != 0 {
    print("NET_STACK_FAIL: short UDP accepted")
} else {
    print("NET_STACK_PASS: short UDP rejected")
}

let short_ipv4: array = [69, 0, 0, 20]
if len(ipv4.parse_ipv4(short_ipv4)) != 0 {
    print("NET_STACK_FAIL: short IPv4 accepted")
} else {
    print("NET_STACK_PASS: short IPv4 rejected")
}

let bad_read: int = bytes.read_be16([1], 0)
if bad_read != -1 {
    print("NET_STACK_FAIL: truncated big-endian read")
} else {
    print("NET_STACK_PASS: truncated big-endian read rejected")
}
