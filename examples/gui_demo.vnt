# VNT native GUI demo (Windows)
# Styling is loaded from examples/gui_demo.css.
# gui_button(label, x, y) returns true on a click.

gui_size(900, 620)
gui_css("examples/gui_demo.css")
if gui_open("VNT GUI Demo") {
    gui_text("VNT native GUI")
    gui_text("This window is styled with a CSS-like stylesheet.")
    gui_text("Click a button to run its VNT code.")

    running = true
    while running {
        running = gui_poll()
        if gui_button("Say hello", 32, 120) {
            gui_text("Hello from a clicked VNT button.")
        }
        if gui_button("Change status", 32, 174) {
            gui_text("Status changed: button events work.")
        }
        if gui_button("Exit", 32, 228) {
            running = false
        }
        gui_present()
        sleep_ms(16)
    }
    gui_close()
} else {
    print("Could not create the VNT GUI window.")
}
