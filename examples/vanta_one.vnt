import "../lib/vanta/gui.vnt" as gui
import "../lib/std/fs.vnt" as fs
import "../lib/std/io.vnt" as io
import "../lib/std/log.vnt" as log
import "../lib/std/config.vnt" as config
import "../lib/std/net.vnt" as net
import "../lib/std/process.vnt" as process
import "../lib/std/time.vnt" as time
import "../lib/std/math.vnt" as math
import "../lib/std/os.vnt" as os

# Vanta One: local-first native gaming hub.
# Run from the repository root: vnt.exe --compile examples/vanta_one.vnt -o examples/vanta_one.exe
# The launcher itself does not install Minecraft or resolve mod dependencies.
# Profiles point to user-owned .bat/.cmd launch scripts; no shell text is evaluated by VNT.
# Network requests happen only after the user presses a network action.

profile_one_name = "Main Minecraft"
profile_two_name = "Modded Survival"
profile_three_name = "Testing"
profile_four_name = "Custom Game"
profile_one_path = ""
profile_two_path = ""
profile_three_path = ""
profile_four_path = ""
profile_name = profile_one_name
profile_path = profile_one_path
selected_profile = 1
page = "Home"
status_message = "Ready. Your profiles and logs stay on this PC."
activity_message = "No activity yet this session."
project_response = "Look up a Modrinth project by its slug. Example: sodium"
project_slug = ""
project_url = ""
download_url_value = ""
download_destination = "downloaded-file.jar"
download_status = "Downloads only begin after you press Download."
settings_note = "Choose a launch script for each profile. Vanta One will run that script."
active_pid = 0
launch_count = 0
request_count = 0
download_count = 0
session_start = time.now_ms()
running = true
current_dir = os.current_dir()
config_text = config.load_or_create("vanta_one.settings", "theme=midnight\nnetwork=manual\n")
log.info("Vanta One started.")
if fs.exists("vanta_one_profile1_name.txt") { profile_one_name = fs.read("vanta_one_profile1_name.txt") }
if fs.exists("vanta_one_profile2_name.txt") { profile_two_name = fs.read("vanta_one_profile2_name.txt") }
if fs.exists("vanta_one_profile3_name.txt") { profile_three_name = fs.read("vanta_one_profile3_name.txt") }
if fs.exists("vanta_one_profile4_name.txt") { profile_four_name = fs.read("vanta_one_profile4_name.txt") }
if fs.exists("vanta_one_profile1_path.txt") { profile_one_path = fs.read("vanta_one_profile1_path.txt") }
if fs.exists("vanta_one_profile2_path.txt") { profile_two_path = fs.read("vanta_one_profile2_path.txt") }
if fs.exists("vanta_one_profile3_path.txt") { profile_three_path = fs.read("vanta_one_profile3_path.txt") }
if fs.exists("vanta_one_profile4_path.txt") { profile_four_path = fs.read("vanta_one_profile4_path.txt") }

if gui.vanta_gui_start("Vanta One  |  Gaming, under your control", 1180, 790, "examples/vanta_one.css") {
    while running {
        running = gui.vanta_gui_poll()
        elapsed_seconds = math.clamp(time.elapsed_ms(session_start) / 1000, 0, 999999)
        vanta_surface(0, 0, 236, 790, 0x0B1322)
        vanta_surface(18, 18, 200, 76, 0x14223A)
        vanta_surface(254, 18, 904, 86, 0x111B2D)
        vanta_surface(254, 118, 904, 636, 0x0F1828)
        vanta_surface(270, 132, 872, 3, 0x315CE8)

        gui.vanta_heading("VANTA", 34, 32)
        gui.vanta_text_style("ONE  /  GAME HUB", 36, 70, 0x66D9BE, 11)
        gui.vanta_text_style("YOUR LIBRARY", 28, 126, 0x7E93B8, 11)

        if page == "Home" { vanta_surface(20, 145, 196, 42, 0x243B60) }
        if gui.vanta_button_sized("Overview", 28, 147, 180, 38) { page = "Home"; status_message = "Overview selected." }
        if page == "Instances" { vanta_surface(20, 191, 196, 42, 0x243B60) }
        if gui.vanta_button_sized("Game profiles", 28, 193, 180, 38) { page = "Instances"; status_message = "Select a profile and configure its launch script." }
        if page == "Modrinth" { vanta_surface(20, 237, 196, 42, 0x243B60) }
        if gui.vanta_button_sized("Modrinth lookup", 28, 239, 180, 38) { page = "Modrinth"; status_message = "Project lookup is manual; no request is made until you press Lookup." }
        if page == "Downloads" { vanta_surface(20, 283, 196, 42, 0x243B60) }
        if gui.vanta_button_sized("Downloads", 28, 285, 180, 38) { page = "Downloads"; status_message = "Paste a direct file URL and choose a destination." }
        if page == "Settings" { vanta_surface(20, 329, 196, 42, 0x243B60) }
        if gui.vanta_button_sized("Settings", 28, 331, 180, 38) { page = "Settings"; status_message = "Local settings and diagnostics." }
        if page == "Activity" { vanta_surface(20, 375, 196, 42, 0x243B60) }
        if gui.vanta_button_sized("Activity log", 28, 377, 180, 38) { page = "Activity"; status_message = "Activity is stored in vnt.log." }

        vanta_separator(24, 444, 188)
        gui.vanta_text_style("SESSION", 30, 462, 0x7E93B8, 11)
        gui.vanta_text_style("Actions", 30, 490, 0xAAB9D2, 12)
        gui.vanta_text_style("Requests  " + request_count, 30, 516, 0xDCE7FF, 12)
        gui.vanta_text_style("Downloads  " + download_count, 30, 542, 0xDCE7FF, 12)
        gui.vanta_text_style("Launches  " + launch_count, 30, 568, 0xDCE7FF, 12)
        vanta_surface(22, 630, 192, 86, 0x13243A)
        gui.vanta_text_style("LOCAL FIRST", 36, 646, 0x66D9BE, 11)
        gui.vanta_text_style("No accounts. No telemetry.", 36, 672, 0xAAB9D2, 10)
        gui.vanta_text_style("Build  /  VNT native", 36, 693, 0x7E93B8, 10)

        gui.vanta_heading("VANTA ONE", 282, 34)
        gui.vanta_text_style("A native game hub that stays out of your way.", 284, 75, 0xAAB9D2, 13)
        gui.vanta_text_style("LOCAL  •  MANUAL NETWORK  •  WINDOWS", 860, 44, 0x66D9BE, 10)
        gui.vanta_text_style(status_message, 282, 91, 0xDCE7FF, 11)

        if page == "Home" {
            vanta_surface(282, 150, 548, 192, 0x142138)
            vanta_surface(844, 150, 264, 192, 0x142138)
            vanta_surface(282, 358, 826, 142, 0x142138)
            vanta_surface(282, 516, 826, 216, 0x142138)
            gui.vanta_text_style("WELCOME BACK", 304, 172, 0x7E93B8, 11)
            gui.vanta_heading("Your games. Your rules.", 304, 200)
            gui.vanta_text_style("Keep your own launch scripts and choose exactly when", 306, 248, 0xAAB9D2, 12)
            gui.vanta_text_style("to contact an external service.", 306, 270, 0xAAB9D2, 12)
            gui.vanta_text_style("Active profile", 304, 308, 0x7E93B8, 11)
            gui.vanta_text_style(profile_name, 410, 308, 0x66D9BE, 12)
            gui.vanta_text_style("THIS SESSION", 866, 174, 0x7E93B8, 11)
            gui.vanta_heading("" + launch_count, 866, 202)
            gui.vanta_text_style("launch actions", 866, 246, 0xAAB9D2, 12)
            gui.vanta_text_style("" + math.floor(elapsed_seconds) + " seconds open", 866, 286, 0x7E93B8, 11)
            gui.vanta_text_style("QUICK ACTIONS", 304, 378, 0x7E93B8, 11)
            gui.vanta_text_style("Jump directly into profile management or look up a Modrinth project.", 304, 406, 0xDCE7FF, 12)
            if gui.vanta_button_sized("Manage profiles", 304, 442, 174, 40) { page = "Instances" }
            if gui.vanta_button_sized("Open Modrinth lookup", 492, 442, 196, 40) { page = "Modrinth" }
            if gui.vanta_button_sized("Download a file", 702, 442, 150, 40) { page = "Downloads" }
            gui.vanta_text_style("RECENT ACTIVITY", 304, 536, 0x7E93B8, 11)
            gui.vanta_text_style(activity_message, 304, 568, 0xDCE7FF, 13)
            gui.vanta_text_style("Working directory", 304, 610, 0x7E93B8, 11)
            gui.vanta_text_style(current_dir, 304, 634, 0xAAB9D2, 11)
            gui.vanta_text_style("Vanta One stores profile settings as readable local text files.", 304, 688, 0x7E93B8, 11)
        }

        if page == "Instances" {
            vanta_surface(282, 150, 826, 110, 0x142138)
            vanta_surface(282, 276, 826, 300, 0x142138)
            vanta_surface(282, 592, 826, 140, 0x142138)
            gui.vanta_text_style("GAME PROFILES", 304, 170, 0x7E93B8, 11)
            gui.vanta_text_style("Four configurable launch targets. Each points to a script you control.", 304, 196, 0xAAB9D2, 12)
            if selected_profile == 1 { vanta_surface(304, 218, 174, 30, 0x315CE8) }
            if gui.vanta_button_sized("01  Main Minecraft", 304, 216, 174, 34) {
                selected_profile = 1
                profile_name = profile_one_name
                profile_path = profile_one_path
                status_message = "Editing profile 1."
            }
            if selected_profile == 2 { vanta_surface(488, 218, 174, 30, 0x315CE8) }
            if gui.vanta_button_sized("02  Modded Survival", 488, 216, 174, 34) {
                selected_profile = 2
                profile_name = profile_two_name
                profile_path = profile_two_path
                status_message = "Editing profile 2."
            }
            if selected_profile == 3 { vanta_surface(672, 218, 144, 30, 0x315CE8) }
            if gui.vanta_button_sized("03  Testing", 672, 216, 144, 34) {
                selected_profile = 3
                profile_name = profile_three_name
                profile_path = profile_three_path
                status_message = "Editing profile 3."
            }
            if selected_profile == 4 { vanta_surface(826, 218, 166, 30, 0x315CE8) }
            if gui.vanta_button_sized("04  Custom Game", 826, 216, 166, 34) {
                selected_profile = 4
                profile_name = profile_four_name
                profile_path = profile_four_path
                status_message = "Editing profile 4."
            }
            gui.vanta_text_style("PROFILE NAME", 306, 300, 0x7E93B8, 11)
            profile_name_input = gui.vanta_text_input("Name this profile", 304, 322, 760)
            gui.vanta_text_style("LAUNCH SCRIPT PATH", 306, 372, 0x7E93B8, 11)
            profile_path_input = gui.vanta_text_input("Absolute path to a .bat or .cmd file", 304, 394, 760)
            gui.vanta_text_style("Use a script you trust. Launch scripts can run arbitrary commands.", 306, 438, 0xE6B86B, 11)
            gui.vanta_text_style("The app passes the path as a process argument; it does not evaluate the file contents.", 306, 460, 0xAAB9D2, 11)
            if gui.vanta_button_sized("Load selected profile", 304, 500, 184, 40) {
                if selected_profile == 1 { profile_name_input = profile_one_name; profile_path_input = profile_one_path }
                if selected_profile == 2 { profile_name_input = profile_two_name; profile_path_input = profile_two_path }
                if selected_profile == 3 { profile_name_input = profile_three_name; profile_path_input = profile_three_path }
                if selected_profile == 4 { profile_name_input = profile_four_name; profile_path_input = profile_four_path }
                gui.vanta_input_set(profile_name_input, 304, 322)
                gui.vanta_input_set(profile_path_input, 304, 394)
                status_message = "Loaded profile fields."
            }
            if gui.vanta_button_sized("Save profile", 500, 500, 142, 40) {
                if selected_profile == 1 {
                    profile_one_name = profile_name_input
                    profile_one_path = profile_path_input
                    fs.write_text("vanta_one_profile1_name.txt", profile_one_name)
                    fs.write_text("vanta_one_profile1_path.txt", profile_one_path)
                }
                if selected_profile == 2 {
                    profile_two_name = profile_name_input
                    profile_two_path = profile_path_input
                    fs.write_text("vanta_one_profile2_name.txt", profile_two_name)
                    fs.write_text("vanta_one_profile2_path.txt", profile_two_path)
                }
                if selected_profile == 3 {
                    profile_three_name = profile_name_input
                    profile_three_path = profile_path_input
                    fs.write_text("vanta_one_profile3_name.txt", profile_three_name)
                    fs.write_text("vanta_one_profile3_path.txt", profile_three_path)
                }
                if selected_profile == 4 {
                    profile_four_name = profile_name_input
                    profile_four_path = profile_path_input
                    fs.write_text("vanta_one_profile4_name.txt", profile_four_name)
                    fs.write_text("vanta_one_profile4_path.txt", profile_four_path)
                }
                profile_name = profile_name_input
                profile_path = profile_path_input
                config.save("vanta_one.settings", "theme=midnight\nlast_profile=" + selected_profile + "\n")
                log.info("Saved profile " + selected_profile + ": " + profile_name)
                status_message = "Profile saved locally."
                activity_message = "Saved profile: " + profile_name
            }
            if gui.vanta_button_sized("Launch profile", 654, 500, 150, 40) {
                if profile_path_input == "" {
                    status_message = "Set a launch script path before launching."
                    log.warn("Launch rejected: empty script path.")
                } else {
                    if fs.exists(profile_path_input) {
                        active_process = process.start("cmd.exe", ["/c", profile_path_input])
                        active_pid = process.pid(active_process)
                        launch_count = launch_count + 1
                        status_message = "Launch script started. PID " + active_pid
                        activity_message = "Started " + profile_name_input + " (PID " + active_pid + ")"
                        log.info("Started profile " + profile_name_input + " with PID " + active_pid)
                    } else {
                        status_message = "Script not found. Check the path and save the profile."
                        log.warn("Launch script does not exist: " + profile_path_input)
                    }
                }
            }
            if gui.vanta_button_sized("Stop tracking", 816, 500, 144, 40) {
                active_pid = 0
                status_message = "Cleared the displayed process ID. This does not terminate the game."
            }
            gui.vanta_text_style("Current selection: " + selected_profile + "  /  " + profile_name, 306, 614, 0x66D9BE, 12)
            gui.vanta_text_style("Configured path: " + profile_path, 306, 642, 0xAAB9D2, 11)
            gui.vanta_text_style("Launches use Windows cmd.exe to run your chosen .bat/.cmd script.", 306, 682, 0x7E93B8, 11)
        }

        if page == "Modrinth" {
            vanta_surface(282, 150, 826, 144, 0x142138)
            vanta_surface(282, 310, 826, 422, 0x142138)
            gui.vanta_text_style("MODRINTH PROJECT LOOKUP", 304, 170, 0x7E93B8, 11)
            gui.vanta_text_style("Enter a project slug, e.g. sodium, fabric-api, or lithium.", 304, 196, 0xAAB9D2, 12)
            project_slug_input = gui.vanta_text_input("Project slug", 304, 220, 420)
            if gui.vanta_button_sized("Lookup project", 742, 218, 154, 40) {
                if project_slug_input == "" {
                    status_message = "Enter a project slug first."
                } else {
                    project_url = "https://api.modrinth.com/v2/project/" + project_slug_input
                    project_response = net.get_json(project_url)
                    project_status = net.status(project_url)
                    request_count = request_count + 2
                    status_message = "Modrinth returned HTTP " + project_status
                    activity_message = "Looked up Modrinth project: " + project_slug_input
                    log.info("Modrinth lookup for " + project_slug_input + " returned HTTP " + project_status)
                }
            }
            if gui.vanta_button_sized("Latest versions", 906, 218, 174, 40) {
                if project_slug_input == "" {
                    status_message = "Enter a project slug first."
                } else {
                    project_url = "https://api.modrinth.com/v2/project/" + project_slug_input + "/version"
                    project_response = net.get_json(project_url)
                    project_status = net.status(project_url)
                    request_count = request_count + 2
                    status_message = "Version endpoint returned HTTP " + project_status
                    activity_message = "Fetched version metadata for " + project_slug_input
                    log.info("Modrinth versions for " + project_slug_input + " returned HTTP " + project_status)
                }
            }
            gui.vanta_text_style("API RESPONSE  /  RAW JSON", 304, 330, 0x7E93B8, 11)
            response_text = gui.vanta_textarea("The response body appears here after a lookup.", 304, 354, 776, 286)
            if gui.vanta_button_sized("Show last response", 304, 658, 174, 40) {
                gui.vanta_input_set(project_response, 304, 354)
                status_message = "Restored the most recent response into the text area."
            }
            gui.vanta_text_style("This screen displays raw JSON. Structured result cards require a JSON parser.", 494, 670, 0xAAB9D2, 11)
            gui.vanta_text_style("Only public metadata endpoints are called here; no account token is stored.", 304, 710, 0x66D9BE, 11)
        }

        if page == "Downloads" {
            vanta_surface(282, 150, 826, 190, 0x142138)
            vanta_surface(282, 356, 826, 376, 0x142138)
            gui.vanta_text_style("DIRECT DOWNLOAD", 304, 170, 0x7E93B8, 11)
            gui.vanta_text_style("Paste a direct HTTPS file URL. TLS verification remains enabled by curl.", 304, 198, 0xAAB9D2, 12)
            download_url_input = gui.vanta_text_input("https://example.com/file.jar", 304, 222, 776)
            gui.vanta_text_style("DESTINATION PATH", 304, 270, 0x7E93B8, 11)
            download_path_input = gui.vanta_text_input("downloaded-file.jar", 304, 292, 530)
            if gui.vanta_button_sized("Download file", 850, 290, 154, 40) {
                if download_url_input == "" || download_path_input == "" {
                    download_status = "Enter both a URL and destination."
                    status_message = download_status
                } else {
                    download_ok = net.download(download_url_input, download_path_input)
                    request_count = request_count + 1
                    if download_ok {
                        download_count = download_count + 1
                        download_status = "Download completed: " + download_path_input
                        status_message = download_status
                        activity_message = "Downloaded file to " + download_path_input
                        log.info("Download completed: " + download_path_input)
                    } else {
                        download_status = "Download failed. Check URL, path, permissions, and curl availability."
                        status_message = download_status
                        log.warn("Download failed: " + download_url_input)
                    }
                }
            }
            gui.vanta_text_style("DOWNLOAD STATUS", 304, 382, 0x7E93B8, 11)
            gui.vanta_heading("Manual. Explicit. Visible.", 304, 410)
            gui.vanta_text_style(download_status, 304, 460, 0xDCE7FF, 13)
            gui.vanta_text_style("Vanta One does not auto-install a file or execute it after download.", 304, 506, 0x66D9BE, 12)
            gui.vanta_text_style("For mods, confirm the Minecraft version and loader compatibility yourself.", 304, 534, 0xAAB9D2, 12)
            gui.vanta_text_style("Files are saved to the path you specify, relative to:", 304, 592, 0x7E93B8, 11)
            gui.vanta_text_style(current_dir, 304, 616, 0xAAB9D2, 11)
            if gui.vanta_button_sized("Check URL status", 304, 658, 166, 40) {
                if download_url_input != "" {
                    download_status = "HTTP " + net.status(download_url_input)
                    request_count = request_count + 1
                    status_message = download_status
                    log.info("Checked download URL status: " + download_status)
                }
            }
            if gui.vanta_button_sized("Open Modrinth lookup", 482, 658, 198, 40) { page = "Modrinth" }
        }

        if page == "Settings" {
            vanta_surface(282, 150, 826, 176, 0x142138)
            vanta_surface(282, 342, 826, 390, 0x142138)
            gui.vanta_text_style("LOCAL CONFIGURATION", 304, 170, 0x7E93B8, 11)
            gui.vanta_heading("Privacy by default.", 304, 200)
            gui.vanta_text_style("No sign-in, analytics, or background requests are implemented.", 304, 248, 0xAAB9D2, 12)
            gui.vanta_text_style("Network access happens only after an explicit button click.", 304, 274, 0x66D9BE, 12)
            gui.vanta_text_style("DIAGNOSTICS", 304, 364, 0x7E93B8, 11)
            gui.vanta_text_style("Operating system", 304, 396, 0xAAB9D2, 12)
            gui.vanta_text_style("Windows native GUI", 494, 396, 0xDCE7FF, 12)
            gui.vanta_text_style("Working directory", 304, 428, 0xAAB9D2, 12)
            gui.vanta_text_style(current_dir, 494, 428, 0xDCE7FF, 11)
            gui.vanta_text_style("Configuration file", 304, 462, 0xAAB9D2, 12)
            gui.vanta_text_style("vanta_one.settings", 494, 462, 0xDCE7FF, 12)
            gui.vanta_text_style("Config loaded", 304, 496, 0xAAB9D2, 12)
            gui.vanta_text_style(config_text, 494, 496, 0xDCE7FF, 11)
            gui.vanta_text_style("Session duration", 304, 530, 0xAAB9D2, 12)
            gui.vanta_text_style("" + math.floor(elapsed_seconds) + " seconds", 494, 530, 0xDCE7FF, 12)
            gui.vanta_text_style("OS home", 304, 564, 0xAAB9D2, 12)
            gui.vanta_text_style(os.env_get("USERPROFILE"), 494, 564, 0xDCE7FF, 11)
            gui.vanta_text_style("Log file", 304, 598, 0xAAB9D2, 12)
            gui.vanta_text_style("vnt.log", 494, 598, 0xDCE7FF, 12)
            if gui.vanta_button_sized("Save settings", 304, 646, 152, 40) {
                config.save("vanta_one.settings", "theme=midnight\nnetwork=manual\nlast_profile=" + selected_profile + "\n")
                status_message = "Settings saved."
                log.info("Settings saved.")
            }
            if gui.vanta_button_sized("Write diagnostic", 468, 646, 176, 40) {
                fs.write_text("vanta_one_diagnostics.txt", "Vanta One diagnostic\nWorking directory: " + current_dir + "\nElapsed seconds: " + elapsed_seconds + "\nRequests: " + request_count + "\nDownloads: " + download_count + "\nLaunches: " + launch_count + "\n")
                status_message = "Wrote vanta_one_diagnostics.txt."
                log.info("Diagnostic report written.")
            }
            if gui.vanta_button_sized("Open activity", 656, 646, 146, 40) { page = "Activity" }
        }

        if page == "Activity" {
            vanta_surface(282, 150, 826, 582, 0x142138)
            gui.vanta_text_style("LOCAL ACTIVITY", 304, 170, 0x7E93B8, 11)
            gui.vanta_heading("What this session did", 304, 200)
            gui.vanta_text_style(activity_message, 304, 250, 0xDCE7FF, 13)
            gui.vanta_text_style("The logger appends to vnt.log in the current working directory.", 304, 284, 0xAAB9D2, 12)
            gui.vanta_text_style("SESSION COUNTERS", 304, 328, 0x7E93B8, 11)
            gui.vanta_text_style("Launch actions: " + launch_count, 304, 358, 0xDCE7FF, 13)
            gui.vanta_text_style("HTTP requests: " + request_count, 304, 390, 0xDCE7FF, 13)
            gui.vanta_text_style("Successful downloads: " + download_count, 304, 422, 0xDCE7FF, 13)
            gui.vanta_text_style("Elapsed seconds: " + math.floor(elapsed_seconds), 304, 454, 0xDCE7FF, 13)
            gui.vanta_text_style("RECENT LOG CONTENT", 304, 502, 0x7E93B8, 11)
            if gui.vanta_button_sized("Refresh log", 304, 532, 140, 40) {
                if fs.exists("vnt.log") {
                    log_content = fs.read_text("vnt.log")
                    status_message = "Read vnt.log. Use the console or a text editor for the full file."
                    activity_message = "Loaded local log content (" + math.clamp(log_content, 0, 0) + ")"
                } else {
                    status_message = "vnt.log does not exist yet."
                }
            }
            gui.vanta_text_style("Full logs remain ordinary text. No log upload exists.", 304, 590, 0x66D9BE, 12)
            gui.vanta_text_style("The activity page intentionally avoids dumping large logs into the frame.", 304, 620, 0xAAB9D2, 11)
            if gui.vanta_button_sized("Export counters", 304, 670, 170, 40) {
                fs.write_text("vanta_one_session.txt", "Vanta One session\nLaunches: " + launch_count + "\nRequests: " + request_count + "\nDownloads: " + download_count + "\nElapsed seconds: " + elapsed_seconds + "\nLast activity: " + activity_message + "\n")
                status_message = "Exported vanta_one_session.txt."
                log.info("Session counters exported.")
            }
        }

        if gui.vanta_button_sized("Quit Vanta One", 970, 746, 160, 32) {
            running = false
            log.info("Vanta One closed.")
        }
        gui.vanta_gui_present()
        time.sleep_ms(16)
    }
    gui.vanta_gui_close()
} else {
    io.write_line("Could not create the Vanta One window. This GUI currently requires Windows.")
}
