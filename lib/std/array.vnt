# Pure VNT array helpers; no compiler or runtime extensions are required.
# Numeric helpers expect numeric elements. min/max/average return 0 for an empty array.

export fun contains(values, target) {
    i = 0
    while i < len(values) {
        if values[i] == target {
            return true
        }
        i += 1
    }
    return false
}

export fun index_of(values, target) {
    i = 0
    while i < len(values) {
        if values[i] == target {
            return i
        }
        i += 1
    }
    return -1
}

export fun count(values, target) {
    matches = 0
    i = 0
    while i < len(values) {
        if values[i] == target {
            matches += 1
        }
        i += 1
    }
    return matches
}

export fun sum(values) {
    total = 0
    i = 0
    while i < len(values) {
        total += values[i]
        i += 1
    }
    return total
}

export fun average(values) {
    if len(values) == 0 {
        return 0
    }
    return sum(values) / len(values)
}

export fun min(values) {
    if len(values) == 0 {
        return 0
    }
    result = values[0]
    i = 1
    while i < len(values) {
        if values[i] < result {
            result = values[i]
        }
        i += 1
    }
    return result
}

export fun max(values) {
    if len(values) == 0 {
        return 0
    }
    result = values[0]
    i = 1
    while i < len(values) {
        if values[i] > result {
            result = values[i]
        }
        i += 1
    }
    return result
}

export fun reverse(values) {
    size = len(values)
    result = range(size)
    i = 0
    while i < size {
        result[i] = values[size - i - 1]
        i += 1
    }
    return result
}

# Joins an array of strings with a separator.
export fun join(values, separator) {
    size = len(values)
    if size == 0 {
        return ""
    }
    result = values[0]
    i = 1
    while i < size {
        result = result + separator + values[i]
        i += 1
    }
    return result
}
