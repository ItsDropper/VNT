# Pure VNT array helpers; no compiler or runtime extensions are required.
# Numeric helpers expect numeric elements. min/max/average return 0 for an empty array.
# take/drop clamp the requested count to the array bounds; unique preserves first occurrence order.

export fun contains(values, target) {
    i = 0
    while i < len(values) {
        if values[i] == target {
            return true
        }
        i += 1
    }
    return false
}

export fun index_of(values, target) {
    i = 0
    while i < len(values) {
        if values[i] == target {
            return i
        }
        i += 1
    }
    return -1
}

export fun count(values, target) {
    matches = 0
    i = 0
    while i < len(values) {
        if values[i] == target {
            matches += 1
        }
        i += 1
    }
    return matches
}

export fun sum(values) {
    total = 0
    i = 0
    while i < len(values) {
        total += values[i]
        i += 1
    }
    return total
}

export fun average(values) {
    size = len(values)
    if size == 0 {
        return 0
    }
    total = 0
    i = 0
    while i < size {
        total += values[i]
        i += 1
    }
    return total * 1.0 / size
}

export fun min(values) {
    if len(values) == 0 {
        return 0
    }
    result = values[0]
    i = 1
    while i < len(values) {
        if values[i] < result {
            result = values[i]
        }
        i += 1
    }
    return result
}

export fun max(values) {
    if len(values) == 0 {
        return 0
    }
    result = values[0]
    i = 1
    while i < len(values) {
        if values[i] > result {
            result = values[i]
        }
        i += 1
    }
    return result
}

export fun reverse(values) {
    size = len(values)
    result = range(size)
    i = 0
    while i < size {
        result[i] = values[size - i - 1]
        i += 1
    }
    return result
}

export fun concat(left, right) {
    left_size = len(left)
    right_size = len(right)
    result = range(left_size + right_size)
    i = 0
    while i < left_size {
        result[i] = left[i]
        i += 1
    }
    i = 0
    while i < right_size {
        result[left_size + i] = right[i]
        i += 1
    }
    return result
}

export fun take(values, requested) {
    size = len(values)
    count = requested
    if count < 0 {
        count = 0
    }
    if count > size {
        count = size
    }
    result = range(count)
    i = 0
    while i < count {
        result[i] = values[i]
        i += 1
    }
    return result
}

export fun drop(values, requested) {
    size = len(values)
    count = requested
    if count < 0 {
        count = 0
    }
    if count > size {
        count = size
    }
    result = range(size - count)
    i = 0
    while i < size - count {
        result[i] = values[count + i]
        i += 1
    }
    return result
}

# Stable deduplication: keeps the first occurrence of each value.
# Inline the scan so module qualification does not affect internal helper resolution.
export fun unique(values) {
    size = len(values)
    scratch = range(size)
    unique_count = 0
    i = 0
    while i < size {
        found = false
        j = 0
        while j < unique_count {
            if scratch[j] == values[i] {
                found = true
            }
            j += 1
        }
        if !found {
            scratch[unique_count] = values[i]
            unique_count += 1
        }
        i += 1
    }
    result = range(unique_count)
    i = 0
    while i < unique_count {
        result[i] = scratch[i]
        i += 1
    }
    return result
}

# Joins an array of strings with a separator.
export fun join(values, separator) {
    size = len(values)
    if size == 0 {
        return ""
    }
    result = values[0]
    i = 1
    while i < size {
        result = result + separator + values[i]
        i += 1
    }
    return result
}
