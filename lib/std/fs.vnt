# VNT standard filesystem
# Paths are interpreted relative to the process working directory unless absolute.

export fun exists(path: string) -> bool {
    return fs_exists(path)
}

export fun is_file(path: string) -> bool {
    return fs_is_file(path)
}

export fun is_dir(path: string) -> bool {
    return fs_is_dir(path)
}

export fun read_text(path: string) -> string {
    return fs_read(path)
}

export fun write_text(path: string, contents: string) -> bool {
    return fs_write(path, contents)
}

export fun append_text(path: string, contents: string) -> bool {
    return fs_append(path, contents)
}

export fun remove_file(path: string) -> bool {
    return fs_delete(path)
}

export fun rename_path(old_path: string, new_path: string) -> bool {
    return fs_rename(old_path, new_path)
}

export fun create_dir(path: string) -> bool {
    return dir_create(path)
}

export fun list_dir(path: string) {
    return fs_list(path)
}

# Line helpers use LF as the serialized newline. read_lines accepts LF and CRLF.
# A single trailing newline does not create a phantom final line.
import "string.vnt" as strutil

export fun read_lines(path) {
    if !fs_exists(path) {
        return []
    }
    text = fs_read(path)
    if len(text) == 0 {
        return []
    }
    lines = strutil.split(text, "\n")
    if strutil.ends_with(text, "\n") {
        trimmed = range(len(lines) - 1)
        i = 0
        while i < len(trimmed) {
            trimmed[i] = lines[i]
            i += 1
        }
        lines = trimmed
    }
    i = 0
    while i < len(lines) {
        line = lines[i]
        if strutil.ends_with(line, "\r") {
            lines[i] = strutil.left(line, len(line) - 1)
        }
        i += 1
    }
    return lines
}

# Writes each array item as one line and includes a trailing LF when non-empty.
export fun write_lines(path, lines) {
    contents = ""
    i = 0
    while i < len(lines) {
        contents = contents + lines[i] + "\n"
        i += 1
    }
    return fs_write(path, contents)
}

export fun append_line(path, line) {
    if !fs_exists(path) {
        return fs_write(path, line + "\n")
    }
    contents = fs_read(path)
    if len(contents) > 0 && !strutil.ends_with(contents, "\n") {
        contents = contents + "\n"
    }
    return fs_write(path, contents + line + "\n")
}
