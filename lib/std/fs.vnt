# VNT standard filesystem
# Paths are interpreted relative to the process working directory unless absolute.
import "string.vnt" as strutil

export fun exists(path: string) -> bool {
    return fs_exists(path)
}

export fun is_file(path: string) -> bool {
    return fs_is_file(path)
}

export fun is_dir(path: string) -> bool {
    return fs_is_dir(path)
}

export fun read_text(path: string) -> string {
    return fs_read(path)
}

export fun write_text(path: string, contents: string) -> bool {
    return fs_write(path, contents)
}

# Writes a sibling temporary file, flushes it, then atomically replaces the destination when supported.
# Returns false on failure; it does not create parent directories or promise that directory metadata
# survives sudden power loss on every filesystem. The destination is not opened/truncated first.
export fun write_text_atomic(path: string, contents: string) -> bool {
    return fs_write_atomic(path, contents)
}

export fun append_text(path: string, contents: string) -> bool {
    return fs_append(path, contents)
}

export fun remove_file(path: string) -> bool {
    return fs_delete(path)
}

export fun rename_path(old_path: string, new_path: string) -> bool {
    return fs_rename(old_path, new_path)
}

export fun create_dir(path: string) -> bool {
    return dir_create(path)
}

export fun list_dir(path: string) {
    return fs_list(path)
}

# Line helpers use LF as the serialized newline. read_lines accepts LF, CRLF, and CR.
# A single trailing line separator does not create a phantom final line.
export fun read_lines(path) {
    if !fs_exists(path) {
        return []
    }
    text = fs_read(path)
    if len(text) == 0 {
        return []
    }
    # Normalize CRLF first so it becomes one separator, then normalize lone CR.
    normalized = strutil.replace(text, "\r\n", "\n")
    normalized = strutil.replace(normalized, "\r", "\n")
    # Remove exactly one terminal separator before splitting. This avoids a
    # phantom final item while preserving intentional blank lines.
    has_trailing_separator = strutil.ends_with(normalized, "\n")
    if has_trailing_separator {
        normalized = strutil.remove_suffix(normalized, "\n")
    }
    return strutil.split(normalized, "\n")
}

export fun write_lines(path, lines) {
    contents = ""
    i = 0
    while i < len(lines) {
        contents = contents + lines[i] + "\n"
        i += 1
    }
    return fs_write(path, contents)
}

export fun append_line(path, line) {
    if !fs_exists(path) {
        return fs_write(path, line + "\n")
    }
    contents = fs_read(path)
    contents_is_empty = len(contents) == 0
    contents_has_trailing_lf = strutil.ends_with(contents, "\n")
    if contents_is_empty {
        return fs_append(path, line + "\n")
    }
    if contents_has_trailing_lf {
        return fs_append(path, line + "\n")
    }
    return fs_write(path, contents + "\n" + line + "\n")
}
