# VNT standard math helpers.
# Import with: import "../lib/std/math.vnt" as math
# Primitive functions are implemented by the native runtime.

export fun square(value) {
    return value * value
}

export fun clamp(value, minimum, maximum) {
    if value < minimum {
        return minimum
    } else {
        if value > maximum {
            return maximum
        } else {
            return value
        }
    }
}

export fun lerp(start, finish, amount) {
    return start + (finish - start) * amount
}

export fun sqrt(value) { return sqrt(value) }
export fun sin(value) { return sin(value) }
export fun cos(value) { return cos(value) }
export fun tan(value) { return tan(value) }
export fun abs(value) { return abs(value) }
export fun floor(value) { return floor(value) }
export fun ceil(value) { return ceil(value) }
export fun min(left, right) { return min(left, right) }
export fun max(left, right) { return max(left, right) }
export fun mod(left, right) { return mod(left, right) }
