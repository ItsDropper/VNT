export fun status(url) {
    sink = "/dev/null"
    if env_has("OS") { sink = "NUL" }
    args = ["--silent", "--show-error", "--location", "--max-time", "30", "--output", sink, "--write-out", "%{http_code}", url]
    executable = "curl"
    if env_has("OS") { executable = "curl.exe" }
    process = process_start(executable, args)
    process_wait(process, -1)
    if process_exit_code(process) == 0 { return process_stdout(process) } else { return "000" }
}

export fun status_with_header(url, header) {
    sink = "/dev/null"
    if env_has("OS") { sink = "NUL" }
    args = ["--silent", "--show-error", "--location", "--max-time", "30", "--output", sink, "--write-out", "%{http_code}", "--header", header, url]
    executable = "curl"
    if env_has("OS") { executable = "curl.exe" }
    process = process_start(executable, args)
    process_wait(process, -1)
    if process_exit_code(process) == 0 { return process_stdout(process) } else { return "000" }
}

export fun status_bearer(url, token) {
    sink = "/dev/null"
