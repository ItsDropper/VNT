export fun download(url, destination) {
    args = ["--silent", "--show-error", "--location", "--fail", "--max-time", "120", "--output", destination, url]
    executable = "curl"
    if env_has("OS") { executable = "curl.exe" }
    process = process_start(executable, args)
    process_wait(process, -1)
    return process_exit_code(process) == 0
}

