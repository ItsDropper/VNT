# VNT standard HTTP and HTTPS helpers.
# Requests are performed by VNT's native C runtime; curl is not required.
# HTTPS uses the platform TLS implementation with certificate verification.
# Body helpers return "" on transport failure. status() returns an HTTP status
# string, or "000" when the transport fails. Downloads require a 2xx response.

export fun get(url) {
    return net_request("GET", url, "", "")
}

export fun get_with_header(url, header) {
    return net_request("GET", url, header, "")
}

export fun get_bearer(url, token) {
    return net_request("GET", url, "Authorization: Bearer " + token, "")
}

export fun get_json(url) {
    return net_request("GET", url, "Accept: application/json", "")
}

export fun get_json_bearer(url, token) {
    return net_request("GET", url, "Accept: application/json\nAuthorization: Bearer " + token, "")
}

export fun post_json(url, json_body) {
    return net_request("POST", url, "Content-Type: application/json", json_body)
}

export fun post_json_bearer(url, token, json_body) {
    return net_request("POST", url, "Content-Type: application/json\nAuthorization: Bearer " + token, json_body)
}

export fun put_json(url, json_body) {
    return net_request("PUT", url, "Content-Type: application/json", json_body)
}

export fun put_json_bearer(url, token, json_body) {
    return net_request("PUT", url, "Content-Type: application/json\nAuthorization: Bearer " + token, json_body)
}

export fun patch_json(url, json_body) {
    return net_request("PATCH", url, "Content-Type: application/json", json_body)
}

export fun patch_json_bearer(url, token, json_body) {
    return net_request("PATCH", url, "Content-Type: application/json\nAuthorization: Bearer " + token, json_body)
}

export fun post_form(url, encoded_form_body) {
    return net_request("POST", url, "Content-Type: application/x-www-form-urlencoded", encoded_form_body)
}

export fun delete_request(url) {
    return net_request("DELETE", url, "", "")
}

export fun delete_bearer(url, token) {
    return net_request("DELETE", url, "Authorization: Bearer " + token, "")
}

export fun status(url) {
    return net_status("GET", url, "")
}

export fun status_with_header(url, header) {
    return net_status("GET", url, header)
}

export fun status_bearer(url, token) {
    return net_status("GET", url, "Authorization: Bearer " + token)
}

export fun head_status(url) {
    return net_status("HEAD", url, "")
}

export fun download(url, destination) {
    return net_download(url, destination, "")
}

export fun download_with_header(url, destination, header) {
    return net_download(url, destination, header)
}

export fun download_bearer(url, destination, token) {
    return net_download(url, destination, "Authorization: Bearer " + token)
}

export fun search_mods(query) {
    encoded_query = net_url_encode(query)
    url = "https://api.modrinth.com/v2/search?query=" + encoded_query + "&facets=%5B%5B%22project_type%3Amod%22%5D%5D&limit=10"
    return net_request("GET", url, "Accept: application/json\nUser-Agent: ItsDropper/Vanta-One/0.1.0 (https://github.com/ItsDropper/VNT)", "")
}
