# VNT standard HTTP and HTTPS helpers.
# Requests are performed by VNT's native C runtime; curl is not required.
# HTTPS uses the platform TLS implementation with certificate verification.
# Body helpers return "" on transport failure. Downloads stream directly to disk for direct requests. status() returns an HTTP status
# string, or "000" when the transport fails. Downloads require a 2xx response.

# Generic request helper for custom methods and headers.
export fun request(method, url, headers, body) {
    return net_request(method, url, headers, body)
}

export fun get(url) {
    return net_request("GET", url, "", "")
}

# Binary API: byte arrays contain integer values in the inclusive range 0..255.
# Unlike string helpers, these APIs preserve embedded NUL and arbitrary bytes.
export fun request_bytes(method, url, headers, body_bytes) {
    return net_request_bytes(method, url, headers, body_bytes)
}

export fun get_bytes(url) {
    return net_request_bytes("GET", url, "", [])
}

export fun get_with_header(url, header) {
    return net_request("GET", url, header, "")
}

export fun get_bearer(url, token) {
    return net_request("GET", url, "Authorization: Bearer " + token, "")
}

export fun get_json(url) {
    return net_request("GET", url, "Accept: application/json", "")
}

export fun get_json_bearer(url, token) {
    return net_request("GET", url, "Accept: application/json\nAuthorization: Bearer " + token, "")
}

export fun post_json(url, json_body) {
    return net_request("POST", url, "Content-Type: application/json", json_body)
}

export fun post_json_bearer(url, token, json_body) {
    return net_request("POST", url, "Content-Type: application/json\nAuthorization: Bearer " + token, json_body)
}

export fun put_json(url, json_body) {
    return net_request("PUT", url, "Content-Type: application/json", json_body)
}

export fun put_json_bearer(url, token, json_body) {
    return net_request("PUT", url, "Content-Type: application/json\nAuthorization: Bearer " + token, json_body)
}

export fun patch_json(url, json_body) {
    return net_request("PATCH", url, "Content-Type: application/json", json_body)
}

export fun patch_json_bearer(url, token, json_body) {
    return net_request("PATCH", url, "Content-Type: application/json\nAuthorization: Bearer " + token, json_body)
}

export fun post_form(url, encoded_form_body) {
    return net_request("POST", url, "Content-Type: application/x-www-form-urlencoded", encoded_form_body)
}

export fun delete_request(url) {
    return net_request("DELETE", url, "", "")
}

export fun delete_bearer(url, token) {
    return net_request("DELETE", url, "Authorization: Bearer " + token, "")
}

export fun status(url) {
    return net_status("GET", url, "")
}

export fun status_with_header(url, header) {
    return net_status("GET", url, header)
}

export fun status_bearer(url, token) {
    return net_status("GET", url, "Authorization: Bearer " + token)
}

export fun head_status(url) {
    return net_status("HEAD", url, "")
}

export fun download(url, destination) {
    return net_download(url, destination, "")
}

export fun download_with_header(url, destination, header) {
    return net_download(url, destination, header)
}

export fun download_bearer(url, destination, token) {
    return net_download(url, destination, "Authorization: Bearer " + token)
}

export fun search_mods(query) {
    encoded_query = net_url_encode(query)
    url = "https://api.modrinth.com/v2/search?query=" + encoded_query + "&facets=%5B%5B%22project_type%3Amod%22%5D%5D&limit=10"
    return net_request("GET", url, "Accept: application/json\nUser-Agent: ItsDropper/Vanta-One/0.1.0 (https://github.com/ItsDropper/VNT)", "")
}

# Bounded asynchronous requests. wait() returns false on timeout or invalid handle.
# cancel() cancels queued requests or interrupts an active transport.
export fun async_start(method, url, headers, body) {
    return net_async_start(method, url, headers, body)
}
export fun async_poll(handle) {
    return net_async_poll(handle)
}
export fun async_wait(handle, timeout_ms) {
    return net_async_wait(handle, timeout_ms)
}
export fun async_cancel(handle) {
    return net_async_cancel(handle)
}
export fun async_result(handle) {
    return net_async_result(handle)
}
export fun async_status(handle) {
    return net_async_status(handle)
}
export fun async_release(handle) {
    return net_async_release(handle)
}

# Caller-consumed response streaming. stream_read() blocks for data or EOF and
# returns a byte buffer. The transport uses a bounded 64 KiB queue for backpressure.
export fun stream_start(method, url, headers, body) {
    return net_stream_start(method, url, headers, body)
}
export fun stream_read(handle, maximum_bytes) {
    return net_stream_read(handle, maximum_bytes)
}
export fun stream_done(handle) {
    return net_stream_done(handle)
}
export fun stream_status(handle) {
    return net_stream_status(handle)
}
export fun stream_cancel(handle) {
    return net_stream_cancel(handle)
}
export fun stream_release(handle) {
    return net_stream_release(handle)
}

# URL/form helpers and status classifiers avoid repeating common protocol checks.
export fun url_encode(value) {
    return net_url_encode(value)
}

export fun is_success_status(status_code) {
    return len(status_code) == 3 && status_code[0] == "2"
}

export fun is_redirect_status(status_code) {
    return len(status_code) == 3 && status_code[0] == "3"
}

export fun is_client_error_status(status_code) {
    return len(status_code) == 3 && status_code[0] == "4"
}

export fun is_server_error_status(status_code) {
    return len(status_code) == 3 && status_code[0] == "5"
}

export fun is_transport_error_status(status_code) {
    return status_code == "000"
}

# Encodes matching arrays of form keys and values as application/x-www-form-urlencoded.
# Returns an empty string for mismatched arrays rather than silently dropping fields.
export fun encode_form(keys, values) {
    if len(keys) != len(values) {
        return ""
    }
    result = ""
    i = 0
    while i < len(keys) {
        if i > 0 {
            result = result + "&"
        }
        result = result + net_url_encode(keys[i]) + "=" + net_url_encode(values[i])
        i += 1
    }
    return result
}

export fun post_form_fields(url, keys, values) {
    if len(keys) != len(values) {
        return ""
    }
    encoded_body = ""
    i = 0
    while i < len(keys) {
        if i > 0 {
            encoded_body = encoded_body + "&"
        }
        encoded_body = encoded_body + net_url_encode(keys[i]) + "=" + net_url_encode(values[i])
        i += 1
    }
    return net_request("POST", url, "Content-Type: application/x-www-form-urlencoded", encoded_body)
}
