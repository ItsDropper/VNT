# VNT standard HTTPS and API helpers.
# Requires curl.exe on Windows or curl on Unix-like systems to be on PATH.
# TLS verification stays enabled. Arguments are passed without a shell.
# Body helpers return "" on transport failure; inspect status() for HTTP status.
# JSON helpers accept a JSON string; VNT does not parse/serialize JSON yet.
#
# These functions call native process primitives directly. This avoids relying
# on private helper functions being resolved across imported module namespaces.

export fun get(url) {
    args = ["--silent", "--show-error", "--location", "--max-time", "30", url]
    executable = "curl"
    if env_has("OS") { executable = "curl.exe" }
    process = process_start(executable, args)
    process_wait(process, -1)
    if process_exit_code(process) == 0 { return process_stdout(process) } else { return "" }
}

export fun get_with_header(url, header) {
    args = ["--silent", "--show-error", "--location", "--max-time", "30", "--header", header, url]
    executable = "curl"
    if env_has("OS") { executable = "curl.exe" }
    process = process_start(executable, args)
    process_wait(process, -1)
    if process_exit_code(process) == 0 { return process_stdout(process) } else { return "" }
}

export fun get_bearer(url, token) {
    args = ["--silent", "--show-error", "--location", "--max-time", "30", "--header", "Authorization: Bearer " + token, url]
    executable = "curl"
    if env_has("OS") { executable = "curl.exe" }
    process = process_start(executable, args)
    process_wait(process, -1)
    if process_exit_code(process) == 0 { return process_stdout(process) } else { return "" }
}

export fun get_json(url) {
    args = ["--silent", "--show-error", "--location", "--max-time", "30", "--header", "Accept: application/json", url]
    executable = "curl"
    if env_has("OS") { executable = "curl.exe" }
    process = process_start(executable, args)
    process_wait(process, -1)
    if process_exit_code(process) == 0 { return process_stdout(process) } else { return "" }
}

# Search public Modrinth projects by words, returning the API's result JSON.
# curl performs query encoding so spaces and punctuation do not corrupt the URL.
export fun search_mods(query) {
    args = ["--silent", "--show-error", "--location", "--max-time", "30", "--header", "Accept: application/json", "--get", "--data-urlencode", "query=" + query, "--data-urlencode", "facets=[[\"project_type:mod\"]]", "--data-urlencode", "limit=10", "https://api.modrinth.com/v2/search"]
    executable = "curl"
    if env_has("OS") { executable = "curl.exe" }
    process = process_start(executable, args)
    process_wait(process, -1)
    if process_exit_code(process) == 0 { return process_stdout(process) } else { return "" }
}

