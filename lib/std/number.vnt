# Pure VNT numeric helpers implemented with existing operators and control flow.
# factorial returns -1 for negative input or signed-i64 overflow; gcd returns -1 when 2^63 is unrepresentable.
# clamp(value, lower, upper) and is_between(value, lower, upper) normalize reversed bounds.

export fun min(left, right) {
    if left < right {
        return left
    }
    return right
}

export fun max(left, right) {
    if left > right {
        return left
    }
    return right
}

export fun clamp(value, lower, upper) {
    if lower > upper {
        temporary = lower
        lower = upper
        upper = temporary
    }
    if value < lower {
        return lower
    }
    if value > upper {
        return upper
    }
    return value
}

export fun is_between(value, lower, upper) {
    if lower > upper {
        temporary = lower
        lower = upper
        upper = temporary
    }
    return value >= lower and value <= upper
}

export fun is_even(value) {
    return value % 2 == 0
}

export fun is_odd(value) {
    return value % 2 != 0
}

export fun sign(value) {
    if value < 0 {
        return -1
    }
    if value > 0 {
        return 1
    }
    return 0
}

# Returns -1 for negative input or when the signed 64-bit result would overflow.
export fun factorial(value) {
    if value < 0 {
        return -1
    }
    result = 1
    i = 2
    while i <= value {
        # Check before multiplication so overflow never occurs in the first place.
        if result > 9223372036854775807 / i {
            return -1
        }
        result *= i
        i += 1
    }
    return result
}

# Uses non-positive operands so abs(INT64_MIN) is never evaluated.
# Returns -1 when the mathematical GCD is 2^63 and cannot fit in a signed i64.
export fun gcd(left, right) {
    if left > 0 {
        left = -left
    }
    if right > 0 {
        right = -right
    }
    while right != 0 {
        # Signed division overflows for INT64_MIN % -1; the GCD is 1.
        if left == -9223372036854775808 {
            if right == -1 {
                return 1
            }
        }
        remainder = left % right
        left = right
        right = remainder
    }
    if left == -9223372036854775808 {
        return -1
    }
    return -left
}

export fun is_prime(value) {
    if value < 2 {
        return false
    }
    if value == 2 {
        return true
    }
    if value % 2 == 0 {
        return false
    }
    # Check odd divisors only; division avoids divisor * divisor overflow.
    divisor = 3
    while divisor <= value / divisor {
        if value % divisor == 0 {
            return false
        }
        divisor += 2
    }
    return true
}
