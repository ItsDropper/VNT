# Statistical helpers for numeric arrays, implemented entirely in VNT.
# Functions do not mutate the caller's array. Empty aggregates return 0.
# variance is population variance (divide by N); percentile linearly interpolates.

fun sorted_copy(values) {
    size = len(values)
    result = range(size)
    i = 0
    while i < size {
        result[i] = values[i]
        i += 1
    }
    i = 1
    while i < size {
        current = result[i]
        j = i - 1
        while j >= 0 && result[j] > current {
            result[j + 1] = result[j]
            j -= 1
        }
        result[j + 1] = current
        i += 1
    }
    return result
}

export fun mean(values) {
    size = len(values)
    if size == 0 { return 0 }
    total = 0
    i = 0
    while i < size {
        total += values[i]
        i += 1
    }
    return total * 1.0 / size
}

export fun median(values) {
    size = len(values)
    if size == 0 { return 0 }
    ordered = sorted_copy(values)
    target = size / 2
    lower = 0
    upper = 0
    i = 0
    while i < size {
        if i == target - 1 { lower = ordered[i] }
        if i == target { upper = ordered[i] }
        i += 1
    }
    if size % 2 == 1 { return upper }
    return (lower + upper) * 1.0 / 2
}

export fun minimum(values) {
    size = len(values)
    if size == 0 { return 0 }
    result = values[0]
    i = 1
    while i < size {
        if values[i] < result { result = values[i] }
        i += 1
    }
    return result
}

export fun maximum(values) {
    size = len(values)
    if size == 0 { return 0 }
    result = values[0]
    i = 1
    while i < size {
        if values[i] > result { result = values[i] }
        i += 1
    }
    return result
}

export fun span(values) {
    size = len(values)
    if size == 0 { return 0 }
    low = values[0]
    high = values[0]
    i = 1
    while i < size {
        if values[i] < low { low = values[i] }
        if values[i] > high { high = values[i] }
        i += 1
    }
    return high - low
}

export fun variance(values) {
    size = len(values)
    if size == 0 { return 0 }
    total = 0
    i = 0
    while i < size {
        total += values[i]
        i += 1
    }
    center = total * 1.0 / size
    squared_total = 0
    i = 0
    while i < size {
        difference = values[i] - center
        squared_total += difference * difference
        i += 1
    }
    return squared_total * 1.0 / size
}

export fun standard_deviation(values) {
    size = len(values)
    if size == 0 { return 0 }
    total = 0
    i = 0
    while i < size {
        total += values[i]
        i += 1
    }
    center = total * 1.0 / size
    squared_total = 0
    i = 0
    while i < size {
        difference = values[i] - center
        squared_total += difference * difference
        i += 1
    }
    return sqrt(squared_total / size)
}

# Percentile p is clamped to [0, 100] and interpolated between adjacent sorted values.
# An empty array returns 0.
export fun percentile(values, p: float) {
    size = len(values)
    if size == 0 { return 0 }
    percent = p * 1.0
    if percent < 0 { percent = 0 }
    if percent > 100 { percent = 100 }
    ordered = sorted_copy(values)
    position = (size - 1) * percent * 1.0 / 100
    lower_target = floor(position)
    upper_target = lower_target + 1
    lower_value = 0
    upper_value = 0
    i = 0
    while i < size {
        if i == lower_target { lower_value = ordered[i] }
        if i == upper_target { upper_value = ordered[i] }
        i += 1
    }
    if upper_target >= size { return lower_value }
    fraction = position - lower_target
    return lower_value + (upper_value - lower_value) * fraction
}

export fun sorted(values) {
    return sorted_copy(values)
}
