# UTF-8 utilities backed by the native runtime.
# These count Unicode scalar encodings, not user-perceived grapheme clusters.
# Invalid UTF-8 bytes are treated as individual units.
export fun length(value: string) -> int {
    return utf8_len(value)
}

# Slice by Unicode code point index. start and count must be non-negative.
export fun slice(value: string, start: int, count: int) -> string {
    return utf8_slice(value, start, count)
}
