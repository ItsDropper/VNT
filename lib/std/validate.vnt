# Conservative ASCII/text validation helpers. These are not Unicode-aware.
# Email and URL checks are sanity checks, not complete standards parsers.

import "string.vnt"

export fun is_blank(value) {
    return trim(value) == ""
}

export fun is_digit(ch) {
    return len(ch) == 1 && ch >= "0" && ch <= "9"
}

export fun is_lower_ascii(ch) {
    return len(ch) == 1 && ch >= "a" && ch <= "z"
}

export fun is_upper_ascii(ch) {
    return len(ch) == 1 && ch >= "A" && ch <= "Z"
}

export fun is_ascii_letter(ch) {
    return is_lower_ascii(ch) || is_upper_ascii(ch)
}

export fun is_alphanumeric(ch) {
    return is_ascii_letter(ch) || is_digit(ch)
}

fun strip_digits(value) {
    result = replace(value, "0", "")
    result = replace(result, "1", "")
    result = replace(result, "2", "")
    result = replace(result, "3", "")
    result = replace(result, "4", "")
    result = replace(result, "5", "")
    result = replace(result, "6", "")
    result = replace(result, "7", "")
    result = replace(result, "8", "")
    result = replace(result, "9", "")
    return result
}

fun strip_identifier_characters(value) {
    result = strip_digits(value)
    result = replace(result, "a", "")
    result = replace(result, "b", "")
    result = replace(result, "c", "")
    result = replace(result, "d", "")
    result = replace(result, "e", "")
    result = replace(result, "f", "")
    result = replace(result, "g", "")
    result = replace(result, "h", "")
    result = replace(result, "i", "")
    result = replace(result, "j", "")
    result = replace(result, "k", "")
    result = replace(result, "l", "")
    result = replace(result, "m", "")
    result = replace(result, "n", "")
    result = replace(result, "o", "")
    result = replace(result, "p", "")
    result = replace(result, "q", "")
    result = replace(result, "r", "")
    result = replace(result, "s", "")
    result = replace(result, "t", "")
    result = replace(result, "u", "")
    result = replace(result, "v", "")
    result = replace(result, "w", "")
    result = replace(result, "x", "")
    result = replace(result, "y", "")
    result = replace(result, "z", "")
    result = replace(result, "A", "")
    result = replace(result, "B", "")
    result = replace(result, "C", "")
    result = replace(result, "D", "")
    result = replace(result, "E", "")
    result = replace(result, "F", "")
    result = replace(result, "G", "")
    result = replace(result, "H", "")
    result = replace(result, "I", "")
    result = replace(result, "J", "")
    result = replace(result, "K", "")
    result = replace(result, "L", "")
    result = replace(result, "M", "")
    result = replace(result, "N", "")
    result = replace(result, "O", "")
    result = replace(result, "P", "")
    result = replace(result, "Q", "")
    result = replace(result, "R", "")
    result = replace(result, "S", "")
    result = replace(result, "T", "")
    result = replace(result, "U", "")
    result = replace(result, "V", "")
    result = replace(result, "W", "")
    result = replace(result, "X", "")
    result = replace(result, "Y", "")
    result = replace(result, "Z", "")
    return replace(result, "_", "")
}

export fun is_integer(value) {
    if len(value) == 0 { return false }
    unsigned = value
    if starts_with(unsigned, "-") || starts_with(unsigned, "+") {
        unsigned = right(unsigned, len(unsigned) - 1)
    }
    return len(unsigned) > 0 && strip_digits(unsigned) == ""
}

# Accepts forms such as 12, -12.5, .5, and 5.; rejects exponent notation.
export fun is_decimal(value) {
    if len(value) == 0 { return false }
    unsigned = value
    if starts_with(unsigned, "-") || starts_with(unsigned, "+") {
        unsigned = right(unsigned, len(unsigned) - 1)
    }
    if len(unsigned) == 0 || count(unsigned, ".") > 1 { return false }
    without_dot = replace(unsigned, ".", "")
    remaining = strip_digits(without_dot)
    return remaining == "" && len(without_dot) > 0
}

export fun is_hex_digit(ch) {
    return is_digit(ch) || (ch >= "a" && ch <= "f") || (ch >= "A" && ch <= "F")
}

export fun is_identifier(value) {
    if len(value) == 0 { return false }
    first = left(value, 1)
    if !is_ascii_letter(first) && first != "_" { return false }
    remainder = right(value, len(value) - 1)
    return strip_identifier_characters(remainder) == ""
}

# Requires one @, a non-empty local part, and a dotted domain with non-empty labels.
export fun looks_like_email(value) {
    size = len(value)
    if size < 5 || is_blank(value) { return false }
    if count(value, "@") != 1 { return false }
    at = index_of(value, "@")
    if at <= 0 || at >= size - 3 { return false }
    domain = right(value, size - at - 1)
    if starts_with(domain, ".") || ends_with(domain, ".") { return false }
    dot = index_of(domain, ".")
    return dot > 0 && dot < len(domain) - 1 &&
        !contains(value, " ") &&
        !contains(value, "\t") &&
        !contains(value, "\r") &&
        !contains(value, "\n")
}

# Checks scheme, a non-empty host-like segment, and absence of whitespace.
export fun looks_like_http_url(value) {
    if starts_with(value, "https://") {
        remainder = remove_prefix(value, "https://")
        if len(remainder) == 0 { return false }
        if starts_with(remainder, "/") ||
            starts_with(remainder, ".") ||
            starts_with(remainder, ":") { return false }
    } else {
        if !starts_with(value, "http://") { return false }
        remainder = remove_prefix(value, "http://")
        if len(remainder) == 0 { return false }
        if starts_with(remainder, "/") ||
            starts_with(remainder, ".") ||
            starts_with(remainder, ":") { return false }
    }
    return !contains(value, " ") &&
        !contains(value, "\t") &&
        !contains(value, "\r") &&
        !contains(value, "\n")
}
