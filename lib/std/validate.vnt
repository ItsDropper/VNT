# Conservative ASCII/text validation helpers. These are not Unicode-aware.
# Email and URL checks are practical sanity checks, not complete standards parsers.

export fun is_blank(value) {
    size = len(value)
    i = 0
    while i < size {
        ch = value[i]
        if ch != " " && ch != "\t" && ch != "\r" && ch != "\n" {
            return false
        }
        i += 1
    }
    return true
}

export fun is_digit(ch) {
    return len(ch) == 1 && ch >= "0" && ch <= "9"
}

export fun is_lower_ascii(ch) {
    return len(ch) == 1 && ch >= "a" && ch <= "z"
}

export fun is_upper_ascii(ch) {
    return len(ch) == 1 && ch >= "A" && ch <= "Z"
}

export fun is_ascii_letter(ch) {
    return is_lower_ascii(ch) || is_upper_ascii(ch)
}

export fun is_alphanumeric(ch) {
    return is_ascii_letter(ch) || is_digit(ch)
}

export fun is_integer(value) {
    size = len(value)
    if size == 0 { return false }
    start = 0
    if value[0] == "-" || value[0] == "+" { start = 1 }
    if start == size { return false }
    while start < size {
        if !is_digit(value[start]) { return false }
        start += 1
    }
    return true
}

# Accepts forms such as 12, -12.5, .5, and 5.; rejects exponent notation.
export fun is_decimal(value) {
    size = len(value)
    if size == 0 { return false }
    i = 0
    if value[0] == "-" || value[0] == "+" { i = 1 }
    if i == size { return false }
    dots = 0
    digits = 0
    while i < size {
        ch = value[i]
        if is_digit(ch) {
            digits += 1
        } else {
            if ch == "." {
                dots += 1
                if dots > 1 { return false }
            } else {
                return false
            }
        }
        i += 1
    }
    return digits > 0
}

export fun is_hex_digit(ch) {
    return is_digit(ch) || (ch >= "a" && ch <= "f") || (ch >= "A" && ch <= "F")
}

export fun is_identifier(value) {
    size = len(value)
    if size == 0 { return false }
    if !is_ascii_letter(value[0]) && value[0] != "_" { return false }
    i = 1
    while i < size {
        if !is_alphanumeric(value[i]) && value[i] != "_" { return false }
        i += 1
    }
    return true
}

# Requires one @, a non-empty local part, and a dotted domain with non-empty labels.
# Deliberately does not claim to validate every legal email address.
export fun looks_like_email(value) {
    size = len(value)
    if size < 5 || is_blank(value) { return false }
    at = -1
    last_char = ""
    first_domain_char = ""
    dot = -1
    i = 0
    while i < size {
        ch = value[i]
        if ch == "@" {
            if at != -1 { return false }
            at = i
        } else {
            if at != -1 {
                if first_domain_char == "" { first_domain_char = ch }
                if ch == "." { dot = i }
            }
        }
        if ch == " " || ch == "\t" || ch == "\r" || ch == "\n" {
            return false
        }
        last_char = ch
        i += 1
    }
    if at <= 0 || at >= size - 3 { return false }
    if first_domain_char == "." || last_char == "." { return false }
    return dot > at + 1 && dot < size - 1
}

# Checks scheme, a non-empty host-like segment, and absence of whitespace.
export fun looks_like_http_url(value) {
    size = len(value)
    if size < 9 { return false }
    https = false
    if value[0] == "h" && value[1] == "t" && value[2] == "t" && value[3] == "p" && value[4] == "s" && value[5] == ":" && value[6] == "/" && value[7] == "/" {
        https = true
    }
    http = false
    if value[0] == "h" && value[1] == "t" && value[2] == "t" && value[3] == "p" && value[4] == ":" && value[5] == "/" && value[6] == "/" {
        http = true
    }
    if !https && !http { return false }
    if https {
        if size <= 8 { return false }
        if value[8] == "/" || value[8] == "." || value[8] == ":" { return false }
    } else {
        if size <= 7 { return false }
        if value[7] == "/" || value[7] == "." || value[7] == ":" { return false }
    }
    i = 0
    while i < size {
        if value[i] == " " || value[i] == "\t" || value[i] == "\r" || value[i] == "\n" {
            return false
        }
        i += 1
    }
    return true
}
