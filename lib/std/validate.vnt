# Conservative ASCII/text validation helpers. These are not Unicode-aware.
# Email accepts an unquoted local-part subset and DNS-style domain labels; it is not a full standards parser.
# URL checks are sanity checks, not complete standards parsers.

fun blank_value(value) {
    size = len(value)
    i = 0
    while i < size {
        ch = value[i]
        if ch != " " && ch != "\t" && ch != "\r" && ch != "\n" {
            return false
        }
        i += 1
    }
    return true
}

fun digit_value(ch) {
    return len(ch) == 1 && (ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9")
}

fun lower_ascii_value(ch) {
    return len(ch) == 1 && (ch == "a" || ch == "b" || ch == "c" || ch == "d" || ch == "e" || ch == "f" || ch == "g" || ch == "h" || ch == "i" || ch == "j" || ch == "k" || ch == "l" || ch == "m" || ch == "n" || ch == "o" || ch == "p" || ch == "q" || ch == "r" || ch == "s" || ch == "t" || ch == "u" || ch == "v" || ch == "w" || ch == "x" || ch == "y" || ch == "z")
}

fun upper_ascii_value(ch) {
    return len(ch) == 1 && (ch == "A" || ch == "B" || ch == "C" || ch == "D" || ch == "E" || ch == "F" || ch == "G" || ch == "H" || ch == "I" || ch == "J" || ch == "K" || ch == "L" || ch == "M" || ch == "N" || ch == "O" || ch == "P" || ch == "Q" || ch == "R" || ch == "S" || ch == "T" || ch == "U" || ch == "V" || ch == "W" || ch == "X" || ch == "Y" || ch == "Z")
}

fun letter_value(ch) {
    return lower_ascii_value(ch) || upper_ascii_value(ch)
}

fun alphanumeric_value(ch) {
    return letter_value(ch) || digit_value(ch)
}

fun hex_digit_value(ch) {
    return digit_value(ch) || ch == "a" || ch == "b" || ch == "c" || ch == "d" || ch == "e" || ch == "f" || ch == "A" || ch == "B" || ch == "C" || ch == "D" || ch == "E" || ch == "F"
}

export fun is_blank(value) { return blank_value(value) }
export fun is_digit(ch) { return digit_value(ch) }
export fun is_lower_ascii(ch) { return lower_ascii_value(ch) }
export fun is_upper_ascii(ch) { return upper_ascii_value(ch) }
export fun is_ascii_letter(ch) { return letter_value(ch) }
export fun is_alphanumeric(ch) { return alphanumeric_value(ch) }

export fun is_integer(value) {
    size = len(value)
    if size == 0 { return false }
    start = 0
    if value[0] == "-" || value[0] == "+" { start = 1 }
    if start == size { return false }
    while start < size {
        if !digit_value(value[start]) { return false }
        start += 1
    }
    return true
}

# Accepts forms such as 12, -12.5, .5, and 5.; rejects exponent notation.
export fun is_decimal(value) {
    size = len(value)
    if size == 0 { return false }
    i = 0
    if value[0] == "-" || value[0] == "+" { i = 1 }
    if i == size { return false }
    dots = 0
    digits = 0
    while i < size {
        ch = value[i]
        if digit_value(ch) {
            digits += 1
        } else {
            if ch == "." {
                dots += 1
                if dots > 1 { return false }
            } else {
                return false
            }
        }
        i += 1
    }
    return digits > 0
}

export fun is_hex_digit(ch) { return hex_digit_value(ch) }

export fun is_identifier(value) {
    size = len(value)
    if size == 0 { return false }
    if !letter_value(value[0]) && value[0] != "_" { return false }
    i = 1
    while i < size {
        if !alphanumeric_value(value[i]) && value[i] != "_" { return false }
        i += 1
    }
    return true
}

# Requires one @, a non-empty local part, and a dotted domain with non-empty labels.
export fun looks_like_email(value) {
    size = len(value)
    if size < 5 || blank_value(value) { return false }
    at = -1
    dot = -1
    first_domain_char = ""
    last_char = ""
    previous_domain_char = ""
    i = 0
    while i < size {
        ch = value[i]
        if ch == "@" {
            if at != -1 || i == 0 || value[i - 1] == "." { return false }
            at = i
        } else {
            if at == -1 {
                if ch == "." {
                    if i == 0 || value[i - 1] == "." { return false }
                } else {
                    if !alphanumeric_value(ch) && ch != "_" && ch != "%" && ch != "+" && ch != "-" {
                        return false
                    }
                }
            } else {
                if first_domain_char == "" { first_domain_char = ch }
                if ch == "." {
                    if previous_domain_char == "." || previous_domain_char == "-" { return false }
                    dot = i
                } else {
                    if !alphanumeric_value(ch) && ch != "-" { return false }
                    if previous_domain_char == "." && ch == "-" { return false }
                }
                previous_domain_char = ch
            }
        }
        if ch == " " || ch == "\t" || ch == "\r" || ch == "\n" {
            return false
        }
        last_char = ch
        i += 1
    }
    if at <= 0 || at >= size - 3 { return false }
    return first_domain_char != "." && first_domain_char != "-" &&
        last_char != "." && last_char != "-" && dot > at + 1 && dot < size - 1
}

# Checks scheme, a non-empty host-like segment, and absence of whitespace.
export fun looks_like_http_url(value) {
    size = len(value)
    if size < 8 { return false }
    https = false
    if size >= 8 && value[0] == "h" && value[1] == "t" &&
        value[2] == "t" && value[3] == "p" && value[4] == "s" &&
        value[5] == ":" && value[6] == "/" && value[7] == "/" {
        https = true
    }
    http = false
    if size >= 7 && value[0] == "h" && value[1] == "t" &&
        value[2] == "t" && value[3] == "p" &&
        value[4] == ":" && value[5] == "/" && value[6] == "/" {
        http = true
    }
    if !https && !http { return false }
    if https {
        if size <= 8 { return false }
        if value[8] == "/" || value[8] == "." || value[8] == ":" || value[8] == "?" || value[8] == "#" || value[8] == "@" { return false }
    } else {
        if size <= 7 { return false }
        if value[7] == "/" || value[7] == "." || value[7] == ":" || value[7] == "?" || value[7] == "#" || value[7] == "@" { return false }
    }
    i = 0
    while i < size {
        if value[i] == " " || value[i] == "\t" ||
            value[i] == "\r" || value[i] == "\n" {
            return false
        }
        i += 1
    }
    return true
}
