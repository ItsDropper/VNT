#
# ACPI discovery from Multiboot2 RSDP tags. All parsing and bounds checks are
# VNT code; raw physical reads are confined to explicit unsafe blocks.
#
# State slots:
# 30 RSDP, 31 root table, 32 MADT, 33 LAPIC physical address,
# 34 IOAPIC address, 35 IOAPIC GSI base, 36 enabled CPU count,
# 37 IOAPIC count, 38 interrupt-source override count, 39 root entry count,
# 40..55 APIC IDs (first 16 CPUs), 56 MADT flags, 57 RSDP revision,
# 64..111: sixteen triples of ISO source IRQ, GSI, flags.

import "../kernel/core.vnt"
import "../mm/phys.vnt"

fun acpi_read8(address: i64, offset: int) -> int {
    unsafe {
        return mem_read_u8(address, offset)
    }
}

fun acpi_read32(address: i64, offset: int) -> int {
    unsafe {
        return mem_read_u32(address, offset)
    }
}

fun acpi_read64(address: i64, offset: int) -> i64 {
    unsafe {
        return mem_read_u64(address, offset)
    }
}

fun acpi_checksum(address: i64, length: int) -> int {
    if address <= 0 || length <= 0 || address + length > 1073741824 {
        return 0
    }
    let sum: int = 0
    let i: int = 0
    while i < length {
        sum = (sum + acpi_read8(address, i)) % 256
        i = i + 1
    }
    return sum == 0
}

fun acpi_is_rsdp(address: i64) -> int {
    if address <= 0 || address + 20 > 1073741824 {
        return 0
    }
    if acpi_read8(address, 0) != 82 ||
       acpi_read8(address, 1) != 83 ||
       acpi_read8(address, 2) != 68 ||
       acpi_read8(address, 3) != 32 ||
       acpi_read8(address, 4) != 80 ||
       acpi_read8(address, 5) != 84 ||
       acpi_read8(address, 6) != 82 ||
       acpi_read8(address, 7) != 32 {
        return 0
    }
    if acpi_checksum(address, 20) != 1 {
        return 0
    }
    let revision: int = acpi_read8(address, 15)
    if revision >= 2 {
        let length: int = acpi_read32(address, 20)
        if length < 36 || length > 4096 || address + length > 1073741824 {
            return 0
        }
        if acpi_checksum(address, length) != 1 {
            return 0
        }
    }
    return 1
}

fun acpi_find_rsdp() -> i64 {
    let info: i64 = phys_info_addr()
    let total: int = phys_info_size()
    if info == 0 || total < 16 {
        return 0
    }
    let cursor: int = 8
    while cursor + 8 <= total {
        let tag_type: int = acpi_read32(info, cursor)
        let tag_size: int = acpi_read32(info, cursor + 4)
        if tag_size < 8 || cursor + tag_size > total {
            return 0
        }
        if tag_type == 0 {
            return 0
        }
        if tag_type == 14 || tag_type == 15 {
            let candidate: i64 = info + cursor + 8
            if tag_type == 14 && tag_size >= 28 && acpi_is_rsdp(candidate) == 1 {
                return candidate
            }
            if tag_type == 15 && tag_size >= 44 && acpi_is_rsdp(candidate) == 1 {
                return candidate
            }
        }
        cursor = cursor + ((tag_size + 7) / 8) * 8
    }
    return 0
}

fun acpi_table_length(address: i64) -> int {
    if address < 4096 || address + 36 > 1073741824 {
        return 0
    }
    let length: int = acpi_read32(address, 4)
    if length < 36 || length > 1048576 || address + length > 1073741824 {
        return 0
    }
    return length
}

fun acpi_signature_is(address: i64, a: int, b: int, c: int, d: int) -> int {
    if acpi_read8(address, 0) != a ||
       acpi_read8(address, 1) != b ||
       acpi_read8(address, 2) != c ||
       acpi_read8(address, 3) != d {
        return 0
    }
    return 1
}

fun acpi_find_madt_in_root(root: i64, xsdt: int) -> i64 {
    let root_length: int = acpi_table_length(root)
    if root_length < 36 {
        return 0
    }
    if acpi_checksum(root, root_length) != 1 {
        return 0
    }
    let entry_size: int = 4
    if xsdt == 1 {
        entry_size = 8
    }
    let entries: int = (root_length - 36) / entry_size
    if entries > 4096 {
        return 0
    }
    state_set(39, entries)
    let index: int = 0
    while index < entries {
        let candidate: i64 = 0
        if entry_size == 8 {
            candidate = acpi_read64(root, 36 + index * entry_size)
        } else {
            candidate = acpi_read32(root, 36 + index * entry_size)
        }
        if candidate >= 4096 && candidate + 36 <= 1073741824 {
            if acpi_signature_is(candidate, 65, 80, 73, 67) == 1 {
                let length: int = acpi_table_length(candidate)
                if length >= 44 && acpi_checksum(candidate, length) == 1 {
                    return candidate
                }
            }
        }
        index = index + 1
    }
    return 0
}

fun acpi_discover() -> int {
    state_set(30, 0)
    state_set(31, 0)
    state_set(32, 0)
    state_set(33, 0)
    state_set(34, 0)
    state_set(35, 0)
    state_set(36, 0)
    state_set(37, 0)
    state_set(38, 0)
    state_set(39, 0)
    let i: int = 0
    while i < 16 {
        state_set(40 + i, 0)
        state_set(64 + i * 3, 0)
        state_set(65 + i * 3, 0)
        state_set(66 + i * 3, 0)
        i = i + 1
    }

    let rsdp: i64 = acpi_find_rsdp()
    if rsdp == 0 {
        return 0
    }
    state_set(30, rsdp)
    state_set(57, acpi_read8(rsdp, 15))

    let root: i64 = 0
    let xsdt: int = 0
    if acpi_read8(rsdp, 15) >= 2 {
        root = acpi_read64(rsdp, 24)
        if root != 0 {
            xsdt = 1
        }
    }
    if root == 0 {
        root = acpi_read32(rsdp, 16)
        xsdt = 0
    }
    if root < 4096 || root + 36 > 1073741824 {
        return 0
    }
    if xsdt == 1 && acpi_signature_is(root, 88, 83, 68, 84) != 1 {
        return 0
    }
    if xsdt == 0 && acpi_signature_is(root, 82, 83, 68, 84) != 1 {
        return 0
    }
    state_set(31, root)
    let madt: i64 = acpi_find_madt_in_root(root, xsdt)
    if madt == 0 {
        return 0
    }
    state_set(32, madt)
    state_set(33, acpi_read32(madt, 36))
    state_set(56, acpi_read32(madt, 40))

    let length: int = acpi_table_length(madt)
    let cursor: int = 44
    while cursor + 2 <= length {
        let entry_type: int = acpi_read8(madt, cursor)
        let entry_length: int = acpi_read8(madt, cursor + 1)
        if entry_length < 2 || cursor + entry_length > length {
            return 0
        }
        if entry_type == 0 {
            if entry_length < 8 {
                return 0
            }
            let flags: int = acpi_read32(madt, cursor + 4)
            if flags % 2 == 1 || (flags / 2) % 2 == 1 {
                let count: int = state_get(36)
                if count < 16 {
                    state_set(40 + count, acpi_read8(madt, cursor + 3))
                }
                state_set(36, count + 1)
            }
        }
        if entry_type == 1 {
            if entry_length < 12 {
                return 0
            }
            let ioapic_count: int = state_get(37)
            if ioapic_count == 0 {
                state_set(34, acpi_read32(madt, cursor + 4))
                state_set(35, acpi_read32(madt, cursor + 8))
            }
            state_set(37, ioapic_count + 1)
        }
        if entry_type == 2 {
            if entry_length < 10 {
                return 0
            }
            let count: int = state_get(38)
            if count < 16 {
                state_set(64 + count * 3, acpi_read8(madt, cursor + 3))
                state_set(65 + count * 3, acpi_read32(madt, cursor + 4))
                state_set(66 + count * 3, acpi_read8(madt, cursor + 8) + acpi_read8(madt, cursor + 9) * 256)
                state_set(38, count + 1)
            }
        }
        if entry_type == 5 {
            if entry_length < 12 {
                return 0
            }
            state_set(33, acpi_read64(madt, cursor + 4))
        }
        if entry_type == 9 {
            if entry_length < 16 {
                return 0
            }
            let flags: int = acpi_read32(madt, cursor + 8)
            if flags % 2 == 1 || (flags / 2) % 2 == 1 {
                let count: int = state_get(36)
                if count < 16 {
                    state_set(40 + count, acpi_read32(madt, cursor + 4))
                }
                state_set(36, count + 1)
            }
        }
        cursor = cursor + entry_length
    }
    return 1
}

fun acpi_rsdp_address() -> i64 { return state_get(30) }
fun acpi_root_address() -> i64 { return state_get(31) }
fun acpi_madt_address() -> i64 { return state_get(32) }
fun acpi_lapic_address() -> i64 { return state_get(33) }
fun acpi_ioapic_address() -> i64 { return state_get(34) }
fun acpi_ioapic_gsi_base() -> int { return state_get(35) }
fun acpi_cpu_count() -> int { return state_get(36) }
fun acpi_ioapic_count() -> int { return state_get(37) }
fun acpi_iso_count() -> int { return state_get(38) }
fun acpi_cpu_apic_id(index: int) -> int {
    if index < 0 || index >= state_get(36) || index >= 16 {
        return -1
    }
    return state_get(40 + index)
}
fun acpi_iso_source(index: int) -> int {
    if index < 0 || index >= state_get(38) || index >= 16 {
        return -1
    }
    return state_get(64 + index * 3)
}
fun acpi_iso_gsi(index: int) -> int {
    if index < 0 || index >= state_get(38) || index >= 16 {
        return -1
    }
    return state_get(65 + index * 3)
}
fun acpi_iso_flags(index: int) -> int {
    if index < 0 || index >= state_get(38) || index >= 16 {
        return -1
    }
    return state_get(66 + index * 3)
}
