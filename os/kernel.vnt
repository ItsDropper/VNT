# COM1 initialization belongs to VNT. The port-I/O instructions remain inline
# assembly until the freestanding target exposes dedicated I/O intrinsics.
fun serial_init() {
    unsafe {
        asm volatile("movw $0x3f9, %dx\nxorb %al, %al\noutb %al, %dx\nmovw $0x3fb, %dx\nmovb $0x80, %al\noutb %al, %dx\nmovw $0x3f8, %dx\nmovb $1, %al\noutb %al, %dx\nmovw $0x3f9, %dx\nxorb %al, %al\noutb %al, %dx\nmovw $0x3fb, %dx\nmovb $3, %al\noutb %al, %dx\nmovw $0x3fa, %dx\nmovb $0xc7, %al\noutb %al, %dx\nmovw $0x3fc, %dx\nmovb $0x0b, %al\noutb %al, %dx")
    }
    return 0
}

fun kernel_main() {
    serial_init()
    unsafe {
        asm volatile("call os_shell")
    }
    return 0
}
