import "serial.vnt"
import "console.vnt"
import "ps2.vnt"
import "interrupts.vnt"
import "kernel/core.vnt"
import "kernel/shell.vnt"
import "pic.vnt"
import "mm/phys.vnt"

# Kernel entry owns initialization order. Core primitives and shell policy live
# in imported modules; the device implementations remain independently located.

fun kernel_main() {
    serial_init()
    state_set(1, 15)
    vga_clear()
    vga_puts("VNTOS\r\nVNT-compiled x86-64 kernel\r\n")
    vga_puts("VGA console active. PS/2 keyboard and mouse polling enabled.\r\n")
    vga_puts("Type help. Serial COM1 remains available for diagnostics.\r\n\r\n")
    serial_puts("VNTOS_BOOT_OK\r\nVNTOS - freestanding x86-64 console\r\nType help for commands.\r\n")
    # Keep legacy lines masked while the architecture code remaps the PIC.
    pic_disable_all()
    if phys_init() == 1 {
        console_puts("Physical page allocator initialized.\r\n")
    }
    if phys_count_usable_pages() == 0 {
        console_puts("WARNING: Multiboot2 memory map unavailable; physical allocation disabled.\r\n")
    }
    interrupts_init()
    # Input is polled for now; do not enable keyboard IRQ1 without a handler.
    pic_disable_irq(1)
    console_puts("PIT timer interrupts enabled; keyboard IRQ remains masked.\r\n")
    ps2_init()
    shell_run()
    return 0
}
