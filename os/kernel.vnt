# Only hardware I/O, raw buffer access, and CPU reset/halt remain inline
# assembly. Command handling, text processing, and shell control flow are VNT.

fun serial_init() {
    unsafe {
        asm volatile("movw $0x3f9, %dx; xorb %al, %al; outb %al, %dx; movw $0x3fb, %dx; movb $0x80, %al; outb %al, %dx; movw $0x3f8, %dx; movb $1, %al; outb %al, %dx; movw $0x3f9, %dx; xorb %al, %al; outb %al, %dx; movw $0x3fb, %dx; movb $3, %al; outb %al, %dx; movw $0x3fa, %dx; movb $0xc7, %al; outb %al, %dx; movw $0x3fc, %dx; movb $0x0b, %al; outb %al, %dx")
    }
    return 0
}

fun serial_putc(value: int) {
    unsafe {
        asm volatile("movl -8(%rbp), %eax; movw $0x3fd, %dx; 1: inb %dx, %al; testb $0x20, %al; jz 1b; movw $0x3f8, %dx; movl -8(%rbp), %eax; outb %al, %dx")
    }
    return 0
}

fun serial_getc() -> int {
    let result: int = 0
    unsafe {
        asm volatile("movw $0x3fd, %dx; 1: inb %dx, %al; testb $1, %al; jz 1b; movw $0x3f8, %dx; inb %dx, %al; movzbl %al, %eax; movl %eax, -8(%rbp)")
    }
    return result
}

fun buffer_ptr() -> string {
    let result: string = ""
    unsafe {
        asm volatile("leaq os_command(%rip), %rax; movq %rax, -8(%rbp)")
    }
    return result
}

fun buffer_get(index: int) -> int {
    let result: int = 0
    unsafe {
        asm volatile("movq -8(%rbp), %rcx; leaq os_command(%rip), %rdx; movzbl (%rdx,%rcx), %eax; movq %rax, -16(%rbp)")
    }
    return result
}

fun buffer_set(index: int, value: int) {
    unsafe {
        asm volatile("movq -8(%rbp), %rax; movq -16(%rbp), %rcx; leaq os_command(%rip), %rdx; movb %cl, (%rdx,%rax)")
    }
    return 0
}

fun serial_puts(text: string) {
    let index: int = 0
    while text[index] != 0 {
        serial_putc(text[index])
        index = index + 1
    }
    return 0
}

fun serial_puts_offset(text: string, offset: int) {
    let index: int = 0
    while text[index + offset] != 0 {
        serial_putc(text[index + offset])
        index = index + 1
    }
    return 0
}

fun str_eq(left: string, right: string) -> bool {
    let index: int = 0
    while left[index] == right[index] {
        if left[index] == 0 {
            return true
        }
        index = index + 1
    }
    return false
}

fun starts_with(text: string, prefix: string) -> bool {
    let index: int = 0
    while prefix[index] != 0 {
        if text[index] != prefix[index] {
            return false
        }
        index = index + 1
    }
    return true
}

fun serial_hex(value: i64) {
    serial_puts("0x")
    let divisor: i64 = 1152921504606846976
    let count: int = 0
    while count < 16 {
        let digit: int = (value / divisor) % 16
        serial_putc("0123456789abcdef"[digit])
        value = value % divisor
        divisor = divisor / 16
        count = count + 1
    }
    serial_puts("\r\n")
    return 0
}

fun kernel_start_addr() -> i64 {
    let result: i64 = 0
    unsafe {
        asm volatile("leaq __kernel_start(%rip), %rax; movq %rax, -8(%rbp)")
    }
    return result
}

fun kernel_end_addr() -> i64 {
    let result: i64 = 0
    unsafe {
        asm volatile("leaq __kernel_end(%rip), %rax; movq %rax, -8(%rbp)")
    }
    return result
}

fun cpu_halt() {
    unsafe {
        asm volatile("cli; 1: hlt; jmp 1b")
    }
    return 0
}

fun cpu_reboot() {
    unsafe {
        asm volatile("1: inb $0x64, %al; testb $2, %al; jnz 1b; movb $0xfe, %al; outb %al, $0x64; jmp 1b")
    }
    return 0
}

fun kernel_main() {
    # Storage is declared here in VNT; the bootstrap does not own shell state.
    unsafe {
        asm volatile(".comm os_command, 128, 16")
    }
    serial_init()
    serial_puts("VNTOS_BOOT_OK\r\nVNTOS - freestanding x86-64 serial shell\r\nType help for commands.\r\n")
    serial_puts("VNTOS> ")
    serial_puts("VNTOS_COMMAND_LINE_READY\r\n")

    let buffer: string = buffer_ptr()
    let length: int = 0
    let character: int = 0
    let handled: int = 0

    while 1 == 1 {
        character = serial_getc()
        if character == 13 || character == 10 {
            buffer_set(length, 0)
            serial_putc(10)
            handled = 0

            if str_eq(buffer, "help") {
                serial_puts("Commands: help, about, clear, echo, mem, reboot, halt\r\n")
                handled = 1
            }
            if str_eq(buffer, "about") {
                serial_puts("VNTOS: VNT-compiled freestanding kernel on x86-64.\r\n")
                handled = 1
            }
            if str_eq(buffer, "clear") {
                serial_putc(27)
                serial_puts("[2J[H")
                handled = 1
            }
            if str_eq(buffer, "mem") {
                serial_puts("Kernel start: ")
                serial_hex(kernel_start_addr())
                serial_puts("Kernel end: ")
                serial_hex(kernel_end_addr())
                serial_puts("Identity map: 0x0000000000000000-0x000000003fffffff (1 GiB)\r\n")
                handled = 1
            }
            if starts_with(buffer, "echo ") {
                serial_puts_offset(buffer, 5)
                serial_puts("\r\n")
                handled = 1
            }
            if str_eq(buffer, "reboot") {
                serial_puts("Rebooting...\r\n")
                cpu_reboot()
            }
            if str_eq(buffer, "halt") {
                serial_puts("CPU halted.\r\n")
                cpu_halt()
            }
            if handled == 0 && length != 0 {
                serial_puts("Unknown command. Type help.\r\n")
            }

            length = 0
            buffer_set(0, 0)
            serial_puts("VNTOS> ")
        } else if character == 8 || character == 127 {
            if length > 0 {
                length = length - 1
                buffer_set(length, 0)
                serial_putc(8)
                serial_putc(32)
                serial_putc(8)
            }
        } else if character >= 32 && character != 127 {
            if length < 127 {
                buffer_set(length, character)
                length = length + 1
                serial_putc(character)
            }
        }
    }
    return 0
}
