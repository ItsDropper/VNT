# VNTOS hardware I/O lives in VNT. Inline assembly is kept to port I/O,
# VGA memory access, and CPU/linker operations.

fun state_get(index: int) -> int {
    let result: int = 0
    unsafe {
        asm volatile("leaq vntos_state(%rip), %rax; movq -8(%rbp), %rcx; movq (%rax,%rcx,8), %rdx; movq %rdx, -16(%rbp)")
    }
    return result
}

fun state_set(index: int, value: int) {
    unsafe {
        asm volatile("leaq vntos_state(%rip), %rax; movq -8(%rbp), %rcx; movq -16(%rbp), %rdx; movq %rdx, (%rax,%rcx,8)")
    }
    return 0
}

fun serial_init() {
    unsafe {
        asm volatile("movw $0x3f9, %dx; xorb %al, %al; outb %al, %dx; movw $0x3fb, %dx; movb $0x80, %al; outb %al, %dx; movw $0x3f8, %dx; movb $1, %al; outb %al, %dx; movw $0x3f9, %dx; xorb %al, %al; outb %al, %dx; movw $0x3fb, %dx; movb $3, %al; outb %al, %dx; movw $0x3fa, %dx; movb $0xc7, %al; outb %al, %dx; movw $0x3fc, %dx; movb $0x0b, %al; outb %al, %dx")
    }
    return 0
}

fun serial_putc(value: int) {
    unsafe {
        asm volatile("movl -8(%rbp), %eax; movw $0x3fd, %dx; 1: inb %dx, %al; testb $0x20, %al; jz 1b; movw $0x3f8, %dx; movl -8(%rbp), %eax; outb %al, %dx")
    }
    return 0
}

fun serial_try_getc() -> int {
    let result: int = -1
    unsafe {
        asm volatile("movw $0x3fd, %dx; inb %dx, %al; testb $1, %al; jz 1f; movw $0x3f8, %dx; inb %dx, %al; movzbl %al, %eax; movl %eax, -8(%rbp); jmp 2f; 1: movl $-1, -8(%rbp); 2:")
    }
    return result
}

fun serial_puts(text: string) {
    let index: int = 0
    while text[index] != 0 {
        serial_putc(text[index])
        index = index + 1
    }
    return 0
}

fun serial_puts_offset(text: string, offset: int) {
    let index: int = 0
    while text[index + offset] != 0 {
        serial_putc(text[index + offset])
        index = index + 1
    }
    return 0
}

fun str_eq(left: string, right: string) -> bool {
    let index: int = 0
    while left[index] == right[index] {
        if left[index] == 0 {
            return true
        }
        index = index + 1
    }
    return false
}

fun starts_with(text: string, prefix: string) -> bool {
    let index: int = 0
    while prefix[index] != 0 {
        if text[index] != prefix[index] {
            return false
        }
        index = index + 1
    }
    return true
}

fun serial_hex(value: i64) {
    serial_puts("0x")
    vga_puts("0x")
    let divisor: i64 = 1152921504606846976
    let count: int = 0
    while count < 16 {
        let digit: int = (value / divisor) % 16
        serial_putc("0123456789abcdef"[digit])
        vga_putc("0123456789abcdef"[digit])
        value = value % divisor
        divisor = divisor / 16
        count = count + 1
    }
    serial_puts("\r\n")
    vga_puts("\\r\\n")
    return 0
}

fun kernel_start_addr() -> i64 {
    let result: i64 = 0
    unsafe {
        asm volatile("leaq __kernel_start(%rip), %rax; movq %rax, -8(%rbp)")
    }
    return result
}

fun kernel_end_addr() -> i64 {
    let result: i64 = 0
    unsafe {
        asm volatile("leaq __kernel_end(%rip), %rax; movq %rax, -8(%rbp)")
    }
    return result
}

fun cpu_halt() {
    unsafe {
        asm volatile("cli; 1: hlt; jmp 1b")
    }
    return 0
}

fun cpu_reboot() {
    unsafe {
        asm volatile("1: inb $0x64, %al; testb $2, %al; jnz 1b; movb $0xfe, %al; outb %al, $0x64; jmp 1b")
    }
    return 0
}

# VGA color is the standard 4-bit foreground/background attribute.
# The CRTC cursor is read/written so text output and the hardware cursor agree.
fun vga_putc(value: int) {
    let keep_cursor: int = state_get(0)
    let keep_color: int = state_get(1)
    unsafe {
        asm volatile("movl -8(%rbp), %eax; movq vntos_state(%rip), %rcx; cmpb $10, %al; je 1f; cmpb $13, %al; je 2f; cmpb $8, %al; je 3f; movabsq $0xb8000, %rdi; leaq (%rdi,%rcx,2), %rdi; movb %al, (%rdi); movq vntos_state+8(%rip), %rax; movb %al, 1(%rdi); incq %rcx; jmp 4f; 1: movq %rcx, %rax; xorq %rdx, %rdx; movq $80, %rsi; divq %rsi; incq %rax; imulq $80, %rax, %rcx; jmp 4f; 2: movq %rcx, %rax; xorq %rdx, %rdx; movq $80, %rsi; divq %rsi; imulq $80, %rax, %rcx; jmp 4f; 3: testq %rcx, %rcx; jz 4f; decq %rcx; movabsq $0xb8000, %rdi; leaq (%rdi,%rcx,2), %rdi; movw $0x0f20, (%rdi); 4: cmpq $2000, %rcx; jb 5f; movabsq $0xb8000, %rsi; leaq 160(%rsi), %rsi; movabsq $0xb8000, %rdi; movl $3840, %ecx; rep movsb; movabsq $0xb8000, %rdi; addq $3840, %rdi; movl $80, %ecx; 6: movw $0x0f20, (%rdi); addq $2, %rdi; loop 6b; movq $1920, %rcx; 5: movq %rcx, vntos_state(%rip); movw $0x3d4, %dx; movb $14, %al; outb %al, %dx; movw $0x3d5, %dx; movl %ecx, %eax; shrl $8, %eax; outb %al, %dx; movw $0x3d4, %dx; movb $15, %al; outb %al, %dx; movw $0x3d5, %dx; movl vntos_state(%rip), %eax; outb %al, %dx")
    }
    return 0
}

# Clear all 80x25 VGA text cells and reset the visible hardware cursor.
fun vga_clear() {
    unsafe {
        asm volatile("cld; movabsq $0xb8000, %rdi; movw $0x0f20, %ax; movl $2000, %ecx; rep stosw; movw $0x3d4, %dx; movb $14, %al; outb %al, %dx; movw $0x3d5, %dx; xorb %al, %al; outb %al, %dx; movw $0x3d4, %dx; movb $15, %al; outb %al, %dx; movw $0x3d5, %dx; xorb %al, %al; outb %al, %dx")
    }
    state_set(0, 0)
    return 0
}

fun vga_puts(text: string) {
    let index: int = 0
    while text[index] != 0 {
        vga_putc(text[index])
        index = index + 1
    }
    return 0
}

fun console_putc(value: int) {
    vga_putc(value)
    serial_putc(value)
    return 0
}

fun console_puts(text: string) {
    vga_puts(text)
    serial_puts(text)
    return 0
}

fun console_puts_offset(text: string, offset: int) {
    let index: int = 0
    while text[index + offset] != 0 {
        console_putc(text[index + offset])
        index = index + 1
    }
    return 0
}

# 8042 controller polling. Timeouts prevent a missing PS/2 device from hanging boot.
fun ps2_wait_input_clear() -> int {
    let status: int = 0
    let attempts: int = 0
    while attempts < 100000 {
        unsafe {
            asm volatile("movw $0x64, %dx; inb %dx, %al; movzbl %al, %eax; movl %eax, -8(%rbp)")
        }
        status = status
        if status % 4 < 2 {
            return 1
        }
        attempts = attempts + 1
    }
    return 0
}

fun ps2_wait_output_full() -> int {
    let status: int = 0
    let attempts: int = 0
    while attempts < 100000 {
        unsafe {
            asm volatile("movw $0x64, %dx; inb %dx, %al; movzbl %al, %eax; movl %eax, -8(%rbp)")
        }
        if status % 2 == 1 {
            return 1
        }
        attempts = attempts + 1
    }
    return 0
}

fun ps2_write_command(value: int) {
    ps2_wait_input_clear()
    unsafe {
        asm volatile("movl -8(%rbp), %eax; movw $0x64, %dx; outb %al, %dx")
    }
    return 0
}

fun ps2_write_data(value: int) {
    ps2_wait_input_clear()
    unsafe {
        asm volatile("movl -8(%rbp), %eax; movw $0x60, %dx; outb %al, %dx")
    }
    return 0
}

fun ps2_read_data() -> int {
    let result: int = -1
    if ps2_wait_output_full() == 0 {
        return -1
    }
    unsafe {
        asm volatile("movw $0x60, %dx; inb %dx, %al; movzbl %al, %eax; movl %eax, -8(%rbp)")
    }
    return result
}

fun ps2_mouse_command(value: int) {
    ps2_write_command(0xd4)
    ps2_write_data(value)
    return 0
}

fun ps2_init() {
    # Enable the auxiliary device port and request streaming reports.
    ps2_write_command(0xa8)
    ps2_mouse_command(0xf4)
    # Drain ACK/RESEND bytes before starting input polling.
    let count: int = 0
    while count < 8 {
        if ps2_wait_output_full() == 0 {
            break
        }
        ps2_read_data()
        count = count + 1
    }
    return 0
}

# Set-1 keyboard scan codes. Releases are filtered by the high bit.
fun keyboard_translate(scan: int) -> int {
    if scan == 0x02 {
        return 49
    }
    if scan == 0x03 {
        return 50
    }
    if scan == 0x04 {
        return 51
    }
    if scan == 0x05 {
        return 52
    }
    if scan == 0x06 {
        return 53
    }
    if scan == 0x07 {
        return 54
    }
    if scan == 0x08 {
        return 55
    }
    if scan == 0x09 {
        return 56
    }
    if scan == 0x0a {
        return 57
    }
    if scan == 0x0b {
        return 48
    }
    if scan == 0x10 {
        return 113
    }
    if scan == 0x11 {
        return 119
    }
    if scan == 0x12 {
        return 101
    }
    if scan == 0x13 {
        return 114
    }
    if scan == 0x14 {
        return 116
    }
    if scan == 0x15 {
        return 121
    }
    if scan == 0x16 {
        return 117
    }
    if scan == 0x17 {
        return 105
    }
    if scan == 0x18 {
        return 111
    }
    if scan == 0x19 {
        return 112
    }
    if scan == 0x1e {
        return 97
    }
    if scan == 0x1f {
        return 115
    }
    if scan == 0x20 {
        return 100
    }
    if scan == 0x21 {
        return 102
    }
    if scan == 0x22 {
        return 103
    }
    if scan == 0x23 {
        return 104
    }
    if scan == 0x24 {
        return 106
    }
    if scan == 0x25 {
        return 107
    }
    if scan == 0x26 {
        return 108
    }
    if scan == 0x2c {
        return 122
    }
    if scan == 0x2d {
        return 120
    }
    if scan == 0x2e {
        return 99
    }
    if scan == 0x2f {
        return 118
    }
    if scan == 0x30 {
        return 98
    }
    if scan == 0x31 {
        return 110
    }
    if scan == 0x32 {
        return 109
    }
    if scan == 0x39 {
        return 32
    }
    if scan == 0x1c {
        return 13
    }
    if scan == 0x0e {
        return 8
    }
    if scan == 0x0f {
        return 9
    }
    if scan == 0x2a || scan == 0x36 {
        state_set(9, 1)
        return -1
    }
    if scan == 0xaa || scan == 0xb6 {
        state_set(9, 0)
        return -1
    }
    if scan == 0x3a {
        state_set(10, 1 - state_get(10))
        return -1
    }
    return -1
}

fun keyboard_poll() -> int {
    let status: int = 0
    let scan: int = 0
    unsafe {
        asm volatile("movw $0x64, %dx; inb %dx, %al; movzbl %al, %eax; movl %eax, -8(%rbp)")
    }
    if status % 2 == 0 {
        return -1
    }
    if status / 32 % 2 == 1 {
        return -1
    }
    unsafe {
        asm volatile("movw $0x60, %dx; inb %dx, %al; movzbl %al, %eax; movl %eax, -8(%rbp)")
    }
    scan = status
    if scan == 0xe0 {
        return -1
    }
    if scan >= 0x80 {
        if scan == 0xaa || scan == 0xb6 {
            state_set(9, 0)
        }
        return -1
    }
    let character: int = keyboard_translate(scan)
    if character >= 97 && character <= 122 {
        if state_get(9) == 1 || state_get(10) == 1 {
            character = character - 32
        }
    }
    if character >= 0 && character <= 255 {
        return character
    }
    return -1
}

fun mouse_poll() {
    let status: int = 0
    let data: int = 0
    unsafe {
        asm volatile("movw $0x64, %dx; inb %dx, %al; movzbl %al, %eax; movl %eax, -8(%rbp)")
    }
    if status % 2 == 0 || status / 32 % 2 == 0 {
        return 0
    }
    unsafe {
        asm volatile("movw $0x60, %dx; inb %dx, %al; movzbl %al, %eax; movl %eax, -8(%rbp)")
    }
    data = status
    if state_get(5) == 0 {
        if data / 8 % 2 == 0 {
            return 0
        }
        state_set(6, data)
        state_set(5, 1)
    } else if state_get(5) == 1 {
        state_set(7, data)
        state_set(5, 2)
    } else {
        state_set(8, data)
        state_set(5, 0)
        if state_get(6) / 16 % 2 == 0 {
            state_set(2, state_get(2) + state_get(7))
        } else {
            state_set(2, state_get(2) - (256 - state_get(7)))
        }
        if state_get(6) / 32 % 2 == 0 {
            state_set(3, state_get(3) - state_get(8))
        } else {
            state_set(3, state_get(3) + (256 - state_get(8)))
        }
        if state_get(2) < 0 {
            state_set(2, 0)
        }
        if state_get(2) > 79 {
            state_set(2, 79)
        }
        if state_get(3) < 0 {
            state_set(3, 0)
        }
        if state_get(3) > 24 {
            state_set(3, 24)
        }
        state_set(4, state_get(6) % 8)
    }
    return 0
}

fun kernel_main() {
    serial_init()
    state_set(1, 15)
    vga_clear()
    vga_puts("VNTOS\r\nVNT-compiled x86-64 kernel\r\n")
    vga_puts("VGA console active. PS/2 keyboard and mouse polling enabled.\r\n")
    vga_puts("Type help. Serial COM1 remains available for diagnostics.\r\n\r\n")
    serial_puts("VNTOS_BOOT_OK\r\nVNTOS - freestanding x86-64 console\r\nType help for commands.\r\n")
    ps2_init()
    vga_puts("VNTOS> ")
    serial_puts("VNTOS_COMMAND_LINE_READY\r\n")
    serial_puts("VNTOS> ")
    let buffer: string = ""
    unsafe {
        asm volatile("subq $128, %rsp; leaq -160(%rbp), %rax; movq %rax, -8(%rbp)")
    }
    let length: int = 0
    let character: int = -1
    let handled: int = 0

    while 1 == 1 {
        mouse_poll()
        character = keyboard_poll()
        if character < 0 {
            character = serial_try_getc()
        }
        if character < 0 {
            continue
        }
        if character == 13 || character == 10 {
            buffer[length] = 0
            console_puts("\r\n")
            handled = 0
            if str_eq(buffer, "help") {
                console_puts("Commands: help, about, clear, echo, mem, mouse, reboot, halt\r\n")
                handled = 1
            }
            if str_eq(buffer, "about") {
                console_puts("VNTOS: VNT-compiled freestanding x86-64 kernel.\r\n")
                handled = 1
            }
            if str_eq(buffer, "clear") {
                vga_clear()
                console_puts("VNTOS screen cleared.\\r\\n")
                handled = 1
            }
            if str_eq(buffer, "mem") {
                console_puts("Kernel start: ")
                serial_hex(kernel_start_addr())
                console_puts("Kernel end: ")
                serial_hex(kernel_end_addr())
                console_puts("Identity map: first 1 GiB\r\n")
                handled = 1
            }
            if str_eq(buffer, "mouse") {
                console_puts("PS/2 mouse x=")
                serial_hex(state_get(2))
                console_puts("y=")
                serial_hex(state_get(3))
                console_puts("buttons=")
                serial_hex(state_get(4))
                handled = 1
            }
            if starts_with(buffer, "echo ") {
                console_puts_offset(buffer, 5)
                console_puts("\r\n")
                handled = 1
            }
            if str_eq(buffer, "reboot") {
                console_puts("Rebooting...\r\n")
                cpu_reboot()
            }
            if str_eq(buffer, "halt") {
                console_puts("CPU halted.\r\n")
                cpu_halt()
            }
            if handled == 0 && length != 0 {
                console_puts("Unknown command. Type help.\r\n")
            }
            length = 0
            buffer[0] = 0
            console_puts("VNTOS> ")
        } else if character == 8 || character == 127 {
            if length > 0 {
                length = length - 1
                buffer[length] = 0
                console_putc(8)
                console_putc(32)
                console_putc(8)
            }
        } else if character >= 32 && character != 127 {
            if length < 127 {
                buffer[length] = character
                length = length + 1
                console_putc(character)
            }
        }
        character = -1
    }
    return 0
}
