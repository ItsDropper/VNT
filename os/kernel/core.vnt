#
# Early kernel primitives. These preserve the current bootstrap ABI; they are
# intentionally isolated until the compiler has a supported global-state ABI.

fun state_get(index: int) -> int {
    let result: int = 0
    unsafe {
        asm volatile("leaq vntos_state(%rip), %rax; movq -8(%rbp), %rcx; movq (%rax,%rcx,8), %rdx; movq %rdx, -16(%rbp)")
    }
    return result
}

fun state_set(index: int, value: int) {
    unsafe {
        asm volatile("leaq vntos_state(%rip), %rax; movq -8(%rbp), %rcx; movq -16(%rbp), %rdx; movq %rdx, (%rax,%rcx,8)")
    }
    return 0
}

fun kernel_start_addr() -> i64 {
    let result: i64 = 0
    unsafe {
        asm volatile("leaq __kernel_start(%rip), %rax; movq %rax, -8(%rbp)")
    }
    return result
}

fun kernel_end_addr() -> i64 {
    let result: i64 = 0
    unsafe {
        asm volatile("leaq __kernel_end(%rip), %rax; movq %rax, -8(%rbp)")
    }
    return result
}

fun cpu_halt() {
    unsafe {
        asm volatile("cli; 1: hlt; jmp 1b")
    }
    return 0
}

fun cpu_reboot() {
    unsafe {
        asm volatile("1: inb $0x64, %al; testb $2, %al; jnz 1b; movb $0xfe, %al; outb %al, $0x64; jmp 1b")
    }
    return 0
}

# Named timer interface keeps the shared-state slot out of interrupt policy
# and shell command code. The counter remains a tick count, not wall-clock time.
fun kernel_timer_tick() {
    state_set(11, state_get(11) + 1)
    return 0
}

fun kernel_timer_ticks() -> int {
    return state_get(11)
}

# Return CR2, the linear address that triggered the most recent page fault.
# This is meaningful only in the fatal page-fault path, before another fault.
fun kernel_page_fault_address() -> i64 {
    let result: i64 = 0
    unsafe {
        asm volatile("call vntos_read_cr2; movq %rax, -8(%rbp)")
    }
    return result
}
