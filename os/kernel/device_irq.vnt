# IRQ accounting shared by device drivers and the interrupt dispatcher.
# This is not a handler registry: an IRQ is only counted until a driver owns it.

import "core.vnt"

fun device_irq_record(irq: int) {
    if irq < 0 || irq > 15 {
        return 0
    }
    state_set(12 + irq, state_get(12 + irq) + 1)
    return 0
}

fun device_irq_count(irq: int) -> int {
    if irq < 0 || irq > 15 {
        return -1
    }
    return state_get(12 + irq)
}
