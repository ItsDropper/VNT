#
# Shell command policy and line editing. Device polling remains in PS/2/serial
# drivers; this module deliberately does not enable keyboard interrupts.

import "core.vnt"
import "sync.vnt"
import "../serial.vnt"
import "../console.vnt"
import "../ps2.vnt"
import "device_irq.vnt"
import "../mm/phys.vnt"
import "../mm/virt.vnt"
import "../firmware/acpi.vnt"
import "../arch/x86_64/apic.vnt"
import "smp.vnt"

fun str_eq(left: string, right: string) -> bool {
    let index: int = 0
    while left[index] == right[index] {
        if left[index] == 0 {
            return true
        }
        index = index + 1
    }
    return false
}

fun starts_with(text: string, prefix: string) -> bool {
    let index: int = 0
    while prefix[index] != 0 {
        if text[index] != prefix[index] {
            return false
        }
        index = index + 1
    }
    return true
}

fun shell_redraw_tail(buffer: string, cursor: int, length: int) {
    let index: int = cursor
    while index < length {
        console_putc(buffer[index])
        index = index + 1
    }
    # Erase any stale final character, then return to the logical cursor.
    console_putc(32)
    let rewind: int = length - cursor + 1
    while rewind > 0 {
        console_cursor_left()
        rewind = rewind - 1
    }
    return 0
}

fun shell_run() {
    vga_puts("VNTOS> ")
    serial_puts("VNTOS_COMMAND_LINE_READY\r\n")
    serial_puts("VNTOS> ")
    let buffer: string = ""
    unsafe {
        asm volatile("subq $128, %rsp; leaq -160(%rbp), %rax; movq %rax, -8(%rbp)")
    }
    let length: int = 0
    let cursor: int = 0
    let character: int = -1
    let handled: int = 0

    while 1 == 1 {
        mouse_poll()
        character = keyboard_poll()
        if character == 256 {
            character = serial_try_getc()
        }
        if character < 0 {
            continue
        }
        if character == 13 || character == 10 {
            # Finish the visible line before advancing to the next prompt line.
            while cursor < length {
                console_putc(buffer[cursor])
                cursor = cursor + 1
            }
            buffer[length] = 0
            console_puts("\r\n")
            handled = 0
            if str_eq(buffer, "help") {
                console_puts("Commands: help, about, clear, echo, history, uptime, synctest, mem, memtest, vmtest, irq, mouse, smp, reboot, halt\r\n")
                handled = 1
            }
            if str_eq(buffer, "about") {
                console_puts("VNTOS: VNT-compiled freestanding x86-64 kernel.\r\n")
                handled = 1
            }
            if str_eq(buffer, "history") {
                if state_get(178) == 0 {
                    console_puts("No previous command.\r\n")
                } else {
                    console_puts("Last command: ")
                    let history_index: int = 0
                    while history_index < state_get(178) {
                        console_putc(state_get(180 + history_index))
                        history_index = history_index + 1
                    }
                    console_puts("\r\n")
                }
                handled = 1
            }
            if str_eq(buffer, "uptime") {
                let ticks: int = kernel_timer_ticks()
                console_puts("Timer ticks (decimal): ")
                console_decimal(ticks)
                console_puts("Approximate uptime seconds (decimal): ")
                console_decimal(ticks / 100)
                console_puts("Clock source: PIT at nominal 100 Hz; seconds are approximate.\r\n")
                handled = 1
            }
            if str_eq(buffer, "synctest") {
                if sync_self_test() == 1 {
                    console_puts("Spinlock self-test: PASS\r\n")
                } else {
                    console_puts("Spinlock self-test: FAIL\r\n")
                }
                handled = 1
            }
            if str_eq(buffer, "clear") {
                vga_clear()
                console_puts("VNTOS screen cleared.\r\n")
                handled = 1
            }
            if str_eq(buffer, "mem") {
                console_puts("Kernel start: ")
                console_hex(kernel_start_addr())
                console_puts("Kernel end: ")
                console_hex(kernel_end_addr())
                console_puts("Identity map: first 1 GiB\r\n")
                console_puts("Usable 4-KiB pages (decimal): ")
                console_decimal(phys_count_usable_pages())
                console_puts("Free 4-KiB pages (decimal): ")
                console_decimal(phys_count_free_pages())
                handled = 1
            }
            if str_eq(buffer, "memtest") {
                if phys_self_test() == 1 {
                    console_puts("Physical allocator self-test: PASS\r\n")
                } else {
                    console_puts("Physical allocator self-test: FAIL\r\n")
                }
                handled = 1
            }
            if str_eq(buffer, "vmtest") {
                if virt_self_test() == 1 {
                    console_puts("Virtual-memory self-test: PASS\r\n")
                } else {
                    console_puts("Virtual-memory self-test: FAIL\r\n")
                }
                handled = 1
            }
            if str_eq(buffer, "smp") {
                console_puts("ACPI RSDP: ")
                console_hex(acpi_rsdp_address())
                console_puts("MADT: ")
                console_hex(acpi_madt_address())
                console_puts("Discovered CPUs: ")
                console_hex(smp_discovered_cpu_count())
                console_puts("Online CPUs: ")
                console_hex(smp_online_cpu_count())
                console_puts("BSP APIC ID: ")
                console_hex(smp_bsp_apic_id())
                console_puts("Local APIC enabled: ")
                console_hex(apic_is_enabled())
                console_puts("IOAPIC GSI base: ")
                console_hex(acpi_ioapic_gsi_base())
                console_puts("Interrupt-source overrides: ")
                console_hex(acpi_iso_count())
                console_puts("IOAPIC redirection entries masked: ")
                console_hex(apic_ioapic_route_count())
                console_puts("APIC IPI responses per CPU: ")
                let cpu_index: int = 0
                while cpu_index < smp_discovered_cpu_count() && cpu_index < 16 {
                    console_hex(smp_ipi_count(cpu_index))
                    cpu_index = cpu_index + 1
                }
                console_puts("SMP startup error code: ")
                console_hex(state_get(143))
                if smp_online_cpu_count() == smp_discovered_cpu_count() {
                    console_puts("All discovered CPUs are online.\r\n")
                } else {
                    console_puts("Some discovered CPUs remain offline.\r\n")
                }
                handled = 1
            }
            if str_eq(buffer, "irq") {
                console_puts("Timer ticks (decimal): ")
                console_decimal(kernel_timer_ticks())
                console_puts("IRQ0 count (decimal): ")
                console_decimal(device_irq_count(0))
                console_puts("IRQ1 count (decimal): ")
                console_decimal(device_irq_count(1))
                handled = 1
            }
            if str_eq(buffer, "mouse") {
                console_puts("PS/2 mouse x=")
                console_hex(state_get(2))
                console_puts("y=")
                console_hex(state_get(3))
                console_puts("buttons=")
                console_hex(state_get(4))
                handled = 1
            }
            if starts_with(buffer, "echo ") {
                console_puts_offset(buffer, 5)
                console_puts("\r\n")
                handled = 1
            }
            if str_eq(buffer, "reboot") {
                console_puts("Rebooting...\r\n")
                cpu_reboot()
            }
            if str_eq(buffer, "halt") {
                console_puts("CPU halted.\r\n")
                cpu_halt()
            }
            if handled == 0 && length != 0 {
                console_puts("Unknown command. Type help.\r\n")
            }
            # Save after dispatch, so "history" reports the preceding command.
            if length > 0 {
                let history_save_index: int = 0
                while history_save_index < length {
                    state_set(180 + history_save_index, buffer[history_save_index])
                    history_save_index = history_save_index + 1
                }
                state_set(180 + length, 0)
                state_set(178, length)
            }
            length = 0
            cursor = 0
            buffer[0] = 0
            console_puts("VNTOS> ")
        } else if character == 257 {
            # Up arrow recalls the most recent completed command.
            if state_get(178) > 0 {
                while cursor > 0 {
                    console_cursor_left()
                    cursor = cursor - 1
                }
                let clear_count: int = length
                while clear_count > 0 {
                    console_putc(32)
                    clear_count = clear_count - 1
                }
                while length > 0 {
                    console_cursor_left()
                    length = length - 1
                }
                length = state_get(178)
                let history_load_index: int = 0
                while history_load_index < length {
                    buffer[history_load_index] = state_get(180 + history_load_index)
                    console_putc(buffer[history_load_index])
                    history_load_index = history_load_index + 1
                }
                buffer[length] = 0
                cursor = length
            }
        } else if character == 258 {
            # Left arrow moves the logical and hardware cursor together.
            if cursor > 0 {
                cursor = cursor - 1
                console_cursor_left()
            }
        } else if character == 259 {
            # Right arrow echoes the character under the cursor.
            if cursor < length {
                console_putc(buffer[cursor])
                cursor = cursor + 1
            }
        } else if character == 261 {
            while cursor > 0 {
                console_cursor_left()
                cursor = cursor - 1
            }
        } else if character == 262 {
            while cursor < length {
                console_putc(buffer[cursor])
                cursor = cursor + 1
            }
        } else if character == 260 {
            # Delete the character under the cursor and redraw only the tail.
            if cursor < length {
                let shift_index: int = cursor
                while shift_index < length {
                    buffer[shift_index] = buffer[shift_index + 1]
                    shift_index = shift_index + 1
                }
                length = length - 1
                buffer[length] = 0
                shell_redraw_tail(buffer, cursor, length)
            }
        } else if character == 8 || character == 127 {
            # Backspace removes the character immediately before the cursor.
            if cursor > 0 {
                let shift_index: int = cursor - 1
                while shift_index < length - 1 {
                    buffer[shift_index] = buffer[shift_index + 1]
                    shift_index = shift_index + 1
                }
                length = length - 1
                cursor = cursor - 1
                buffer[length] = 0
                console_cursor_left()
                shell_redraw_tail(buffer, cursor, length)
            }
        } else if character >= 32 && character != 127 {
            if length < 127 {
                let shift_index: int = length
                while shift_index > cursor {
                    buffer[shift_index] = buffer[shift_index - 1]
                    shift_index = shift_index - 1
                }
                buffer[cursor] = character
                length = length + 1
                buffer[length] = 0
                shell_redraw_tail(buffer, cursor, length)
                console_putc(buffer[cursor])
                cursor = cursor + 1
            }
        }
        character = -1
    }
    return 0
}
