#
# Shell command policy and line editing. Device polling remains in PS/2/serial
# drivers; this module deliberately does not enable keyboard interrupts.

import "core.vnt"
import "../serial.vnt"
import "../console.vnt"
import "../ps2.vnt"
import "device_irq.vnt"
import "../mm/phys.vnt"
import "../mm/virt.vnt"\nimport "../firmware/acpi.vnt"\nimport "../arch/x86_64/apic.vnt"\nimport "smp.vnt"

fun str_eq(left: string, right: string) -> bool {
    let index: int = 0
    while left[index] == right[index] {
        if left[index] == 0 {
            return true
        }
        index = index + 1
    }
    return false
}

fun starts_with(text: string, prefix: string) -> bool {
    let index: int = 0
    while prefix[index] != 0 {
        if text[index] != prefix[index] {
            return false
        }
        index = index + 1
    }
    return true
}

fun shell_run() {
    vga_puts("VNTOS> ")
    serial_puts("VNTOS_COMMAND_LINE_READY\r\n")
    serial_puts("VNTOS> ")
    let buffer: string = ""
    unsafe {
        asm volatile("subq $128, %rsp; leaq -160(%rbp), %rax; movq %rax, -8(%rbp)")
    }
    let length: int = 0
    let character: int = -1
    let handled: int = 0

    while 1 == 1 {
        mouse_poll()
        character = keyboard_poll()
        if character == 256 {
            character = serial_try_getc()
        }
        if character < 0 {
            continue
        }
        if character == 13 || character == 10 {
            buffer[length] = 0
            console_puts("\r\n")
            handled = 0
            if str_eq(buffer, "help") {
                console_puts("Commands: help, about, clear, echo, mem, memtest, vmtest, irq, mouse, smp, reboot, halt\r\n")
                handled = 1
            }
            if str_eq(buffer, "about") {
                console_puts("VNTOS: VNT-compiled freestanding x86-64 kernel.\r\n")
                handled = 1
            }
            if str_eq(buffer, "clear") {
                vga_clear()
                console_puts("VNTOS screen cleared.\r\n")
                handled = 1
            }
            if str_eq(buffer, "mem") {
                console_puts("Kernel start: ")
                console_hex(kernel_start_addr())
                console_puts("Kernel end: ")
                console_hex(kernel_end_addr())
                console_puts("Identity map: first 1 GiB\r\n")
                console_puts("Usable 4-KiB pages: ")
                console_hex(phys_count_usable_pages())
                console_puts("Free 4-KiB pages: ")
                console_hex(phys_count_free_pages())
                handled = 1
            }
            if str_eq(buffer, "memtest") {
                if phys_self_test() == 1 {
                    console_puts("Physical allocator self-test: PASS\r\n")
                } else {
                    console_puts("Physical allocator self-test: FAIL\r\n")
                }
                handled = 1
            }
            if str_eq(buffer, "vmtest") {
                if virt_self_test() == 1 {
                    console_puts("Virtual-memory self-test: PASS\r\n")
                } else {
                    console_puts("Virtual-memory self-test: FAIL\r\n")
                }
                handled = 1
            }
            if str_eq(buffer, "smp") {
                console_puts("ACPI RSDP: ")
                console_hex(acpi_rsdp_address())
                console_puts("MADT: ")
                console_hex(acpi_madt_address())
                console_puts("Discovered CPUs: ")
                console_hex(smp_discovered_cpu_count())
                console_puts("Online CPUs: ")
                console_hex(smp_online_cpu_count())
                console_puts("BSP APIC ID: ")
                console_hex(smp_bsp_apic_id())
                console_puts("Local APIC enabled: ")
                console_hex(apic_is_enabled())
                console_puts("IOAPIC GSI base: ")
                console_hex(acpi_ioapic_gsi_base())
                console_puts("Interrupt-source overrides: ")
                console_hex(acpi_iso_count())
                console_puts("IOAPIC redirection entries masked: ")
                console_hex(apic_ioapic_route_count())
                console_puts("Secondary CPU startup is not enabled yet.\\r\\n")
                handled = 1
            }
            if str_eq(buffer, "irq") {
                console_puts("Timer ticks: ")
                console_hex(kernel_timer_ticks())
                console_puts("IRQ0 count: ")
                console_hex(device_irq_count(0))
                console_puts("IRQ1 count: ")
                console_hex(device_irq_count(1))
                handled = 1
            }
            if str_eq(buffer, "mouse") {
                console_puts("PS/2 mouse x=")
                console_hex(state_get(2))
                console_puts("y=")
                console_hex(state_get(3))
                console_puts("buttons=")
                console_hex(state_get(4))
                handled = 1
            }
            if starts_with(buffer, "echo ") {
                console_puts_offset(buffer, 5)
                console_puts("\r\n")
                handled = 1
            }
            if str_eq(buffer, "reboot") {
                console_puts("Rebooting...\r\n")
                cpu_reboot()
            }
            if str_eq(buffer, "halt") {
                console_puts("CPU halted.\r\n")
                cpu_halt()
            }
            if handled == 0 && length != 0 {
                console_puts("Unknown command. Type help.\r\n")
            }
            length = 0
            buffer[0] = 0
            console_puts("VNTOS> ")
        } else if character == 8 || character == 127 {
            if length > 0 {
                length = length - 1
                buffer[length] = 0
                console_putc(8)
                console_putc(32)
                console_putc(8)
            }
        } else if character >= 32 && character != 127 {
            if length < 127 {
                buffer[length] = character
                length = length + 1
                console_putc(character)
            }
        }
        character = -1
    }
    return 0
}
