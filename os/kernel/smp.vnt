#
# ACPI CPU inventory and serial AP startup. The bootstrap processor starts
# secondary CPUs one at a time; each AP publishes online state and then halts
# with interrupts disabled. Scheduling and AP interrupt delivery are not enabled.

import "core.vnt"
import "../firmware/acpi.vnt"
import "../arch/x86_64/apic.vnt"
import "../mm/phys.vnt"

fun smp_prepare_trampoline() -> int {
    let source: i64 = 0
    let end: i64 = 0
    let stack_symbol: i64 = 0
    let entry_symbol: i64 = 0
    let entry_address: i64 = 0
    unsafe {
        source = symbol_address("ap_trampoline_start")
        end = symbol_address("ap_trampoline_end")
        stack_symbol = symbol_address("ap_trampoline_stack_slot")
        entry_symbol = symbol_address("ap_trampoline_entry_slot")
        entry_address = symbol_address("vnt_fn_smp_ap_entry")
    }
    let size: i64 = end - source
    if size <= 0 || size > 4096 {
        return 0
    }
    let index: int = 0
    while index < size {
        let byte: int = 0
        unsafe {
            byte = mem_read_u8(source, index)
            mem_write_u8(0x8000, index, byte)
        }
        index = index + 1
    }
    let stack_offset: int = stack_symbol - source
    let entry_offset: int = entry_symbol - source
    unsafe {
        mem_write_u64(0x8000, stack_offset, 0)
        mem_write_u64(0x8000, entry_offset, entry_address)
    }
    return 1
}

fun smp_set_trampoline_stack(stack_top: i64) -> int {
    let source: i64 = 0
    let stack_symbol: i64 = 0
    unsafe {
        source = symbol_address("ap_trampoline_start")
        stack_symbol = symbol_address("ap_trampoline_stack_slot")
        mem_write_u64(0x8000, stack_symbol - source, stack_top)
    }
    return 1
}

fun smp_wait_for_tick(previous: int) -> int {
    let spins: int = 0
    while kernel_timer_ticks() == previous && spins < 50000000 {
        spins = spins + 1
    }
    if kernel_timer_ticks() != previous {
        return 1
    }
    return 0
}

fun smp_wait_for_online(previous_online: int) -> int {
    let start_tick: int = kernel_timer_ticks()
    let spins: int = 0
    while smp_online_cpu_count() <= previous_online &&
          kernel_timer_ticks() - start_tick < 3 &&
          spins < 50000000 {
        spins = spins + 1
    }
    if smp_online_cpu_count() > previous_online {
        return 1
    }
    return 0
}

fun smp_init() -> int {
    state_set(60, 1)
    state_set(143, 0)
    let index: int = 0
    while index < acpi_cpu_count() && index < 16 {
        state_set(112 + index, 0)
        if acpi_cpu_apic_id(index) == apic_bsp_id() {
            state_set(112 + index, 1)
        }
        index = index + 1
    }
    return 1
}

# Called from the trampoline with interrupts disabled and a private stack.
# An AP only touches shared state once, then halts; no scheduler or device IRQs
# are active on secondary processors in this milestone.
export fun smp_ap_entry(apic_id: int) {
    let index: int = 0
    let matched: int = 0
    while index < acpi_cpu_count() && index < 16 && matched == 0 {
        if acpi_cpu_apic_id(index) == apic_id {
            state_set(112 + index, 1)
            state_set(60, state_get(60) + 1)
            matched = 1
        }
        index = index + 1
    }
    cpu_halt()
    return 0
}

fun smp_start_aps() -> int {
    let discovered: int = acpi_cpu_count()
    if discovered <= 1 {
        return 1
    }
    # State storage and the trampoline intentionally cap this first SMP step
    # at sixteen MADT processors. Refuse partial startup on larger topologies.
    if discovered > 16 || apic_is_enabled() != 1 {
        state_set(143, 1)
        return 0
    }
    if smp_prepare_trampoline() != 1 {
        state_set(143, 2)
        return 0
    }

    let index: int = 0
    while index < discovered {
        let apic_id: int = acpi_cpu_apic_id(index)
        if apic_id >= 0 && apic_id != smp_bsp_apic_id() {
            let stack_page: i64 = phys_alloc_page()
            if stack_page == 0 {
                state_set(143, 3)
                return 0
            }
            if phys_reserve_allocated_page(stack_page) != 1 {
                state_set(143, 4)
                return 0
            }
            let stack_top: i64 = stack_page + 4096
            state_set(128 + index, stack_top)
            smp_set_trampoline_stack(stack_top)

            let previous_online: int = smp_online_cpu_count()
            if apic_send_icr(apic_id, 0xc500) != 1 {
                state_set(143, 5)
                return 0
            }
            let tick: int = kernel_timer_ticks()
            if smp_wait_for_tick(tick) != 1 {
                state_set(143, 6)
                return 0
            }
            if apic_send_icr(apic_id, 0x8500) != 1 {
                state_set(143, 7)
                return 0
            }
            tick = kernel_timer_ticks()
            if smp_wait_for_tick(tick) != 1 {
                state_set(143, 8)
                return 0
            }
            if apic_send_icr(apic_id, 0x608) != 1 {
                state_set(143, 9)
                return 0
            }
            if smp_wait_for_online(previous_online) != 1 {
                apic_send_icr(apic_id, 0x608)
                if smp_wait_for_online(previous_online) != 1 {
                    state_set(143, 10)
                    return 0
                }
            }
        }
        index = index + 1
    }
    if smp_online_cpu_count() == discovered {
        state_set(143, 0)
        return 1
    }
    state_set(143, 11)
    return 0
}

fun smp_discovered_cpu_count() -> int {
    return acpi_cpu_count()
}

fun smp_online_cpu_count() -> int {
    return state_get(60)
}

fun smp_cpu_apic_id(index: int) -> int {
    return acpi_cpu_apic_id(index)
}

fun smp_cpu_online(index: int) -> int {
    if index < 0 || index >= acpi_cpu_count() || index >= 16 {
        return 0
    }
    return state_get(112 + index)
}

fun smp_bsp_apic_id() -> int {
    if apic_is_enabled() == 1 {
        return apic_bsp_id()
    }
    return -1
}
