import "../kernel/core.vnt"

# Multiboot2 memory-map parsing and physical-frame bitmap operations are VNT
# code. Bootstrap assembly only supplies the handoff fields and bitmap storage.

fun phys_info_addr() -> i64 {
    let magic_slot: i64 = 0
    let info_slot: i64 = 0
    unsafe {
        magic_slot = symbol_address("multiboot2_boot_magic")
        info_slot = symbol_address("multiboot2_info_ptr")
    }
    let magic: int = 0
    let info: i64 = 0
    unsafe {
        magic = mem_read_u32(magic_slot, 0)
        info = mem_read_u32(info_slot, 0)
    }
    if magic != 0x36d76289 || info == 0 || info >= 1073741824 {
        return 0
    }
    return info
}

fun phys_info_size() -> int {
    let info: i64 = phys_info_addr()
    if info == 0 {
        return 0
    }
    let size: int = 0
    unsafe {
        size = mem_read_u32(info, 0)
    }
    if size < 16 || info + size > 1073741824 {
        return 0
    }
    return size
}

fun phys_mmap_count() -> int {
    let info: i64 = phys_info_addr()
    if info == 0 {
        return -1
    }
    let total: int = phys_info_size()
    if total < 16 {
        return -1
    }
    let cursor: int = 8
    while cursor + 8 <= total {
        let tag_type: int = 0
        let tag_size: int = 0
        unsafe {
            tag_type = mem_read_u32(info, cursor)
            tag_size = mem_read_u32(info, cursor + 4)
        }
        if tag_size < 8 || cursor + tag_size > total {
            return -1
        }
        if tag_type == 0 {
            return 0
        }
        if tag_type == 6 {
            if tag_size < 16 {
                return -1
            }
            let entry_size: int = 0
            unsafe {
                entry_size = mem_read_u32(info, cursor + 8)
            }
            if entry_size < 24 {
                return -1
            }
            return (tag_size - 16) / entry_size
        }
        cursor = cursor + ((tag_size + 7) / 8) * 8
    }
    return -1
}

fun phys_mmap_field(index: int, field: int) -> i64 {
    if index < 0 || field < 0 || field > 2 {
        return 0
    }
    let info: i64 = phys_info_addr()
    if info == 0 {
        return 0
    }
    let total: int = phys_info_size()
    if total < 16 {
        return 0
    }
    let cursor: int = 8
    while cursor + 8 <= total {
        let tag_type: int = 0
        let tag_size: int = 0
        unsafe {
            tag_type = mem_read_u32(info, cursor)
            tag_size = mem_read_u32(info, cursor + 4)
        }
        if tag_size < 8 || cursor + tag_size > total {
            return 0
        }
        if tag_type == 0 {
            return 0
        }
        if tag_type == 6 {
            if tag_size < 16 {
                return 0
            }
            let entry_size: int = 0
            unsafe {
                entry_size = mem_read_u32(info, cursor + 8)
            }
            if entry_size < 24 {
                return 0
            }
            if index >= (tag_size - 16) / entry_size {
                return 0
            }
            let offset: int = cursor + 16 + index * entry_size
            if field == 0 {
                unsafe {
                    return mem_read_u64(info, offset)
                }
            }
            if field == 1 {
                unsafe {
                    return mem_read_u64(info, offset + 8)
                }
            }
            unsafe {
                return mem_read_u32(info, offset + 16)
            }
        }
        cursor = cursor + ((tag_size + 7) / 8) * 8
    }
    return 0
}

fun phys_mmap_base(index: int) -> i64 {
    return phys_mmap_field(index, 0)
}
fun phys_mmap_length(index: int) -> i64 {
    return phys_mmap_field(index, 1)
}
fun phys_mmap_type(index: int) -> i64 {
    return phys_mmap_field(index, 2)
}

fun phys_usable_bitmap_base() -> i64 {
    unsafe {
        return symbol_address("vntos_phys_usable_bitmap")
    }
}
fun phys_allocated_bitmap_base() -> i64 {
    unsafe {
        return symbol_address("vntos_phys_allocated_bitmap")
    }
}
fun phys_reserved_bitmap_base() -> i64 {
    unsafe {
        return symbol_address("vntos_phys_reserved_bitmap")
    }
}

fun phys_bitmap_set(base: i64, frame: int, value: int) -> int {
    if frame < 0 || frame >= 262144 {
        return 0
    }
    let byte_offset: int = frame / 8
    let bit: int = frame % 8
    let mask: int = 1
    let i: int = 0
    while i < bit {
        mask = mask * 2
        i = i + 1
    }
    let byte: int = 0
    unsafe {
        byte = mem_read_u8(base, byte_offset)
    }
    let present: int = (byte / mask) % 2
    if value != 0 {
        if present == 0 {
            unsafe {
                mem_write_u8(base, byte_offset, byte + mask)
            }
        }
    } else {
        if present == 1 {
            unsafe {
                mem_write_u8(base, byte_offset, byte - mask)
            }
        }
    }
    return 1
}
fun phys_bitmap_get(base: i64, frame: int) -> int {
    if frame < 0 || frame >= 262144 {
        return 0
    }
    let mask: int = 1
    let bit: int = frame % 8
    let i: int = 0
    while i < bit {
        mask = mask * 2
        i = i + 1
    }
    let byte: int = 0
    unsafe {
        byte = mem_read_u8(base, frame / 8)
    }
    return (byte / mask) % 2
}
fun phys_usable_set(frame: int, value: int) -> int {
    return phys_bitmap_set(phys_usable_bitmap_base(), frame, value)
}
fun phys_usable_get(frame: int) -> int {
    return phys_bitmap_get(phys_usable_bitmap_base(), frame)
}
fun phys_allocated_set(frame: int, value: int) -> int {
    return phys_bitmap_set(phys_allocated_bitmap_base(), frame, value)
}
fun phys_allocated_get(frame: int) -> int {
    return phys_bitmap_get(phys_allocated_bitmap_base(), frame)
}
fun phys_reserved_set(frame: int, value: int) -> int {
    return phys_bitmap_set(phys_reserved_bitmap_base(), frame, value)
}
fun phys_reserved_get(frame: int) -> int {
    return phys_bitmap_get(phys_reserved_bitmap_base(), frame)
}

# Returns 1 on success. The kernel continues in diagnostic mode if the
# bootloader did not provide a valid Multiboot2 memory-map tag.
fun phys_init() -> int {
    let region_count: int = phys_mmap_count()
    if region_count <= 0 {
        return 0
    }

    let region: int = 0
    let base: i64 = 0
    let length: i64 = 0
    let start_frame: int = 0
    let end_frame: int = 0
    let frame: int = 0
    let limit: i64 = 1073741824

    while region < region_count {
        if phys_mmap_type(region) == 1 {
            base = phys_mmap_base(region)
            length = phys_mmap_length(region)
            if base >= 0 && base < limit && length > 0 {
                if length > limit - base {
                    length = limit - base
                }
                start_frame = (base + 4096 - 1) / 4096
                end_frame = (base + length) / 4096
                if start_frame < 256 {
                    start_frame = 256
                }
                if end_frame > 262144 {
                    end_frame = 262144
                }
                frame = start_frame
                while frame < end_frame {
                    phys_usable_set(frame, 1)
                    frame = frame + 1
                }
            }
        }
        region = region + 1
    }

    # Reserve the complete low-memory range and the linked kernel image,
    # including its page tables, bootstrap stack, and all allocator bitmaps.
    let kernel_end: i64 = kernel_end_addr()
    let reserve_end: i64 = (kernel_end + 4096 - 1) / 4096
    frame = 0
    while frame < reserve_end && frame < 262144 {
        phys_allocated_set(frame, 1)
        phys_reserved_set(frame, 1)
        frame = frame + 1
    }

    # The bootloader-owned information block may live outside the kernel image.
    let info_start: i64 = phys_info_addr()
    let info_size: int = phys_info_size()
    if info_start > 0 && info_size > 0 && info_start < limit {
        let info_end: i64 = info_start + info_size
        let info_first: int = info_start / 4096
        let info_last: int = (info_end + 4096 - 1) / 4096
        if info_last > 262144 {
            info_last = 262144
        }
        frame = info_first
        while frame < info_last {
            phys_allocated_set(frame, 1)
            phys_reserved_set(frame, 1)
            frame = frame + 1
        }
    }

    # Count usable and immediately allocatable frames once during early boot.
    # Cached counters keep the interactive shell responsive.
    let total_pages: int = 0
    let free_pages: int = 0
    frame = 0
    while frame < 262144 {
        if phys_usable_get(frame) == 1 {
            total_pages = total_pages + 1
            if frame >= 256 && phys_allocated_get(frame) == 0 {
                free_pages = free_pages + 1
            }
        }
        frame = frame + 1
    }
    state_set(28, total_pages)
    state_set(29, free_pages)
    return 1
}

# Returns a 4-KiB-aligned physical address, or zero when exhausted.
fun phys_alloc_page() -> i64 {
    let frame: int = 256
    while frame < 262144 {
        if phys_usable_get(frame) == 1 && phys_allocated_get(frame) == 0 {
            phys_allocated_set(frame, 1)
            state_set(29, state_get(29) - 1)
            return frame * 4096
        }
        frame = frame + 1
    }
    return 0
}

# Only frees an allocated, usable frame in the current identity-mapped window.
# Returns 1 if freed; returns 0 for unaligned, reserved, invalid, or double frees.
fun phys_free_page(address: i64) -> int {
    if address < 256 * 4096 || address >= 1073741824 {
        return 0
    }
    let frame: int = address / 4096
    if frame * 4096 != address {
        return 0
    }
    if phys_usable_get(frame) != 1 || phys_allocated_get(frame) != 1 {
        return 0
    }
    if phys_reserved_get(frame) == 1 {
        return 0
    }
    phys_allocated_set(frame, 0)
    state_set(29, state_get(29) + 1)
    return 1
}

fun phys_count_usable_pages() -> int {
    return state_get(28)
}

fun phys_count_free_pages() -> int {
    return state_get(29)
}

# Exercise allocation, alignment, free, and double-free rejection. The test
# restores the free-page count and performs no I/O in allocator internals.
fun phys_self_test() -> int {
    let before: int = phys_count_free_pages()
    let page: i64 = phys_alloc_page()
    if page == 0 {
        return 0
    }
    let valid: int = 1
    if page / 4096 * 4096 != page {
        valid = 0
    }
    if phys_free_page(page + 1) != 0 {
        valid = 0
    }
    if phys_free_page(page) != 1 {
        valid = 0
    }
    if phys_free_page(page) != 0 {
        valid = 0
    }
    if phys_free_page(kernel_start_addr()) != 0 {
        valid = 0
    }
    if phys_count_free_pages() != before {
        valid = 0
    }
    return valid
}

# Permanently reserve a page already owned by the allocator, for page tables.
fun phys_reserve_allocated_page(address: i64) -> int {
    if address < 256 * 4096 || address >= 1073741824 {
        return 0
    }
    let frame: int = address / 4096
    if frame * 4096 != address {
        return 0
    }
    if phys_usable_get(frame) != 1 || phys_allocated_get(frame) != 1 {
        return 0
    }
    phys_reserved_set(frame, 1)
    return 1
}
