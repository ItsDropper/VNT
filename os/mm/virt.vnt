#
# Early virtual-memory operations are compiler-generated VNT. This module
# currently manages only the bootstrap's low 1-GiB identity-mapped window.

import "phys.vnt"

fun virt_page_directory_base() -> i64 {
    unsafe {
        return symbol_address("page_directory")
    }
}

fun virt_translate(address: i64) -> i64 {
    if address < 0 || address >= 1073741824 {
        return -1
    }
    let directory: i64 = virt_page_directory_base()
    let directory_index: int = (address / 2097152) % 512
    let pde: i64 = 0
    unsafe {
        pde = mem_read_u64(directory, directory_index * 8)
    }
    if pde % 2 == 0 {
        return -1
    }
    if (pde / 128) % 2 == 1 {
        let base: i64 = pde - (pde % 2097152)
        return base + (address % 2097152)
    }
    let table: i64 = pde - (pde % 4096)
    let table_index: int = (address / 4096) % 512
    let pte: i64 = 0
    unsafe {
        pte = mem_read_u64(table, table_index * 8)
    }
    if pte % 2 == 0 {
        return -1
    }
    return pte - (pte % 4096) + (address % 4096)
}

# Return 0 on rejection, 1 if a 2-MiB page was split, or 2 if its 4-KiB
# table already existed. A newly allocated table frame is reserved permanently.
fun virt_map_page(virtual_address: i64, physical_address: i64, flags: int) -> int {
    if virtual_address < 0 || virtual_address >= 1073741824 ||
       physical_address < 0 || physical_address >= 1073741824 { return 0 }
    if virtual_address % 4096 != 0 || physical_address % 4096 != 0 ||
       flags < 0 || flags >= 4096 || flags % 2 == 0 { return 0 }
    let directory: i64 = virt_page_directory_base()
    let directory_index: int = (virtual_address / 2097152) % 512
    let pde: i64 = 0
    unsafe {
        pde = mem_read_u64(directory, directory_index * 8)
    }
    if pde % 2 == 0 {
        return 0
    }
    let result: int = 2
    let table: i64 = 0
    if (pde / 128) % 2 == 1 {
        let new_table: i64 = phys_alloc_page()
        if new_table == 0 {
            return 0
        }
        let huge_base: i64 = pde - (pde % 2097152)
        let i: int = 0
        while i < 512 {
            unsafe {
                mem_write_u64(new_table, i * 8, huge_base + i * 4096 + 3)
            }
            i = i + 1
        }
        unsafe {
            mem_write_u64(directory, directory_index * 8, new_table + 3)
        }
        if phys_reserve_allocated_page(new_table) != 1 {
            return 0
        }
        table = new_table
        result = 1
    } else {
        table = pde - (pde % 4096)
    }
    let table_index: int = (virtual_address / 4096) % 512
    unsafe {
        mem_write_u64(table, table_index * 8, physical_address + flags % 4096)
        cpu_invlpg(virtual_address)
    }
    return result
}
fun virt_probe(address: i64) -> int {
    if address < 0 || address >= 1073741824 || address % 8 != 0 {
        return 0
    }
    let sentinel: i64 = 6219000865086522707
    unsafe {
        mem_write_u64(address, 0, sentinel)
        if mem_read_u64(address, 0) != sentinel {
            return 0
        }
    }
    return 1
}

fun virt_self_test() -> int {
    let target: i64 = 268435456
    let before: int = phys_count_free_pages()
    if virt_translate(target) != target {
        return 0
    }
    let page: i64 = phys_alloc_page()
    if page == 0 {
        return 0
    }
    if virt_map_page(target, page, 3) != 1 {
        phys_free_page(page)
        return 0
    }
    let valid: int = 1
    if virt_translate(target) != page {
        valid = 0
    }
    if virt_probe(target) != 1 {
        valid = 0
    }
    if virt_map_page(target, target, 3) != 2 {
        valid = 0
    }
    if virt_translate(target) != target {
        valid = 0
    }
    if phys_free_page(page) != 1 {
        valid = 0
    }
    if phys_count_free_pages() != before - 1 {
        valid = 0
    }
    return valid
}
