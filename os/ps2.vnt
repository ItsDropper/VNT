# Polled 8042 keyboard/mouse input. These routines are not IRQ-driven yet.

fun ps2_wait_input_clear() -> int {
    let status: int = 0
    let attempts: int = 0
    while attempts < 100000 {
        unsafe {
            asm volatile("movw $0x64, %dx; inb %dx, %al; movzbl %al, %eax; movq %rax, -8(%rbp)")
        }
        status = status
        if status % 4 < 2 {
            return 1
        }
        attempts = attempts + 1
    }
    return 0
}

fun ps2_wait_output_full() -> int {
    let status: int = 0
    let attempts: int = 0
    while attempts < 100000 {
        unsafe {
            asm volatile("movw $0x64, %dx; inb %dx, %al; movzbl %al, %eax; movq %rax, -8(%rbp)")
        }
        if status % 2 == 1 {
            return 1
        }
        attempts = attempts + 1
    }
    return 0
}

fun ps2_write_command(value: int) {
    ps2_wait_input_clear()
    unsafe {
        asm volatile("movl -8(%rbp), %eax; movw $0x64, %dx; outb %al, %dx")
    }
    return 0
}

fun ps2_write_data(value: int) {
    ps2_wait_input_clear()
    unsafe {
        asm volatile("movl -8(%rbp), %eax; movw $0x60, %dx; outb %al, %dx")
    }
    return 0
}

fun ps2_read_data() -> int {
    let result: int = -1
    if ps2_wait_output_full() == 0 {
        return -1
    }
    unsafe {
        asm volatile("movw $0x60, %dx; inb %dx, %al; movzbl %al, %eax; movq %rax, -8(%rbp)")
    }
    return result
}

fun ps2_mouse_command(value: int) {
    ps2_write_command(0xd4)
    ps2_write_data(value)
    return 0
}

fun ps2_init() {
    # Enable keyboard port and keyboard scan reporting explicitly.
    ps2_write_command(0xae)
    ps2_write_data(0xf4)
    # Enable auxiliary port and mouse streaming.
    ps2_write_command(0xa8)
    ps2_mouse_command(0xf4)
    # Drain ACK/RESEND bytes before starting input polling.
    let count: int = 0
    while count < 8 {
        if ps2_wait_output_full() == 0 {
            break
        }
        ps2_read_data()
        count = count + 1
    }
    return 0
}

fun keyboard_translate(scan: int) -> int {
    if scan == 0x02 {
        return 49
    }
    if scan == 0x03 {
        return 50
    }
    if scan == 0x04 {
        return 51
    }
    if scan == 0x05 {
        return 52
    }
    if scan == 0x06 {
        return 53
    }
    if scan == 0x07 {
        return 54
    }
    if scan == 0x08 {
        return 55
    }
    if scan == 0x09 {
        return 56
    }
    if scan == 0x0a {
        return 57
    }
    if scan == 0x0b {
        return 48
    }
    if scan == 0x10 {
        return 113
    }
    if scan == 0x11 {
        return 119
    }
    if scan == 0x12 {
        return 101
    }
    if scan == 0x13 {
        return 114
    }
    if scan == 0x14 {
        return 116
    }
    if scan == 0x15 {
        return 121
    }
    if scan == 0x16 {
        return 117
    }
    if scan == 0x17 {
        return 105
    }
    if scan == 0x18 {
        return 111
    }
    if scan == 0x19 {
        return 112
    }
    if scan == 0x1e {
        return 97
    }
    if scan == 0x1f {
        return 115
    }
    if scan == 0x20 {
        return 100
    }
    if scan == 0x21 {
        return 102
    }
    if scan == 0x22 {
        return 103
    }
    if scan == 0x23 {
        return 104
    }
    if scan == 0x24 {
        return 106
    }
    if scan == 0x25 {
        return 107
    }
    if scan == 0x26 {
        return 108
    }
    if scan == 0x2c {
        return 122
    }
    if scan == 0x2d {
        return 120
    }
    if scan == 0x2e {
        return 99
    }
    if scan == 0x2f {
        return 118
    }
    if scan == 0x30 {
        return 98
    }
    if scan == 0x31 {
        return 110
    }
    if scan == 0x32 {
        return 109
    }
    if scan == 0x39 {
        return 32
    }
    if scan == 0x1c {
        return 13
    }
    if scan == 0x0e {
        return 8
    }
    if scan == 0x0f {
        return 9
    }
    if scan == 0x2a || scan == 0x36 {
        state_set(9, 1)
        return 256
    }
    if scan == 0xaa || scan == 0xb6 {
        state_set(9, 0)
        return 256
    }
    if scan == 0x3a {
        state_set(10, 1 - state_get(10))
        return 256
    }
    return 256
}

fun keyboard_poll() -> int {
    let status: int = 0
    let scan: int = 0
    unsafe {
        asm volatile("movw $0x64, %dx; inb %dx, %al; movzbl %al, %eax; movq %rax, -8(%rbp)")
    }
    if status % 2 == 0 {
        return 256
    }
    if status / 32 % 2 == 1 {
        return 256
    }
    unsafe {
        asm volatile("movw $0x60, %dx; inb %dx, %al; movzbl %al, %eax; movq %rax, -8(%rbp)")
    }
    scan = status
    # Extended Set 1 keys begin with E0. Consume the prefix and translate
    # navigation keys on the following make code; key releases are ignored.
    if state_get(177) == 1 {
        state_set(177, 0)
        if scan == 0x48 {
            return 257
        }
        if scan == 0x4b {
            return 258
        }
        if scan == 0x4d {
            return 259
        }
        if scan == 0x53 {
            return 260
        }
        if scan == 0x47 {
            return 261
        }
        if scan == 0x4f {
            return 262
        }
        return 256
    }
    if scan == 0xe0 {
        state_set(177, 1)
        return 256
    }
    if scan >= 0x80 {
        if scan == 0xaa || scan == 0xb6 {
            state_set(9, 0)
        }
        return 256
    }
    let character: int = keyboard_translate(scan)
    if character >= 97 && character <= 122 {
        if state_get(9) == 1 || state_get(10) == 1 {
            character = character - 32
        }
    }
    if character != 256 && character <= 255 {
        return character
    }
    return 256
}

fun mouse_poll() {
    let status: int = 0
    let data: int = 0
    unsafe {
        asm volatile("movw $0x64, %dx; inb %dx, %al; movzbl %al, %eax; movq %rax, -8(%rbp)")
    }
    if status % 2 == 0 || status / 32 % 2 == 0 {
        return 0
    }
    unsafe {
        asm volatile("movw $0x60, %dx; inb %dx, %al; movzbl %al, %eax; movq %rax, -8(%rbp)")
    }
    data = status
    if state_get(5) == 0 {
        if data / 8 % 2 == 0 {
            return 0
        }
        state_set(6, data)
        state_set(5, 1)
    } else if state_get(5) == 1 {
        state_set(7, data)
        state_set(5, 2)
    } else {
        state_set(8, data)
        state_set(5, 0)
        if state_get(6) / 16 % 2 == 0 {
            state_set(2, state_get(2) + state_get(7))
        } else {
            state_set(2, state_get(2) - (256 - state_get(7)))
        }
        if state_get(6) / 32 % 2 == 0 {
            state_set(3, state_get(3) - state_get(8))
        } else {
            state_set(3, state_get(3) + (256 - state_get(8)))
        }
        if state_get(2) < 0 {
            state_set(2, 0)
        }
        if state_get(2) > 79 {
            state_set(2, 79)
        }
        if state_get(3) < 0 {
            state_set(3, 0)
        }
        if state_get(3) > 24 {
            state_set(3, 24)
        }
        state_set(4, state_get(6) % 8)
    }
    return 0
}
