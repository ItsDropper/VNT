# VNT Advanced Program
# Demonstrates functions, parameters, local variables,
# conditionals, while loops, arithmetic and function calls.

print("================================")
print("        VNT PROGRAM DEMO")
print("================================")

# --------------------------------------------------
# Basic functions
# --------------------------------------------------

fun banner() {
    print("Starting calculations...")
    print("")
}

fun separator() {
    print("----------------------------")
}

# --------------------------------------------------
# Multiplication table
# --------------------------------------------------

fun multiplication_table(number) {
    print("Multiplication table:")

    i = 1

    while i <= 10 {
        result = number * i
        print(result)

        i = i + 1
    }
}

# --------------------------------------------------
# Countdown
# --------------------------------------------------

fun countdown(start) {
    print("Countdown:")

    n = start

    while n > 0 {
        print(n)
        n = n - 1
    }

    print("GO!")
}

# --------------------------------------------------
# Number classification
# --------------------------------------------------

fun classify(number) {
    print("Classifying number:")

    if number > 100 {
        print("Large number")
    } else {
        if number > 50 {
            print("Medium number")
        } else {
            if number > 10 {
                print("Small number")
            } else {
                print("Tiny number")
            }
        }
    }
}

# --------------------------------------------------
# Arithmetic stress test
# --------------------------------------------------

fun arithmetic_test() {
    print("Arithmetic test:")

    a = 12
    b = 5

    add = a + b
    subtract = a - b
    multiply = a * b
    divide = a / b

    print(add)
    print(subtract)
    print(multiply)
    print(divide)
}

# --------------------------------------------------
# Power calculation
# --------------------------------------------------

fun power(base, exponent) {
    result = 1
    counter = 0

    while counter < exponent {
        result = result * base
        counter = counter + 1
    }

    print(result)
}

# --------------------------------------------------
# Repeated calculation
# --------------------------------------------------

fun calculation_series(start) {
    value = start
    counter = 0

    while counter < 8 {
        value = value * 2
        value = value - 3

        if value > 100 {
            print("Value passed 100")
        } else {
            print(value)
        }

        counter = counter + 1
    }
}

# --------------------------------------------------
# Nested function calls
# --------------------------------------------------

fun section_one() {
    separator()
    multiplication_table(7)
    separator()
}

fun section_two() {
    separator()
    arithmetic_test()
    separator()
}

fun section_three() {
    separator()
    power(2, 8)
    separator()
}

# --------------------------------------------------
# Main program
# --------------------------------------------------

banner()

section_one()

section_two()

section_three()

countdown(5)

classify(7)
classify(25)
classify(75)
classify(150)

print("Calculation series:")
calculation_series(10)

separator()

print("Program finished.")
print("================================")