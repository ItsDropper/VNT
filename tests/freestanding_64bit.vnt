fun kernel_main() {
    let signed_value: i64 = 2147483647
    signed_value = signed_value + 1
    if signed_value > 2147483647 {
        let unsigned_value: u64 = 2147483647
        unsigned_value = unsigned_value + 1
        if unsigned_value > 2147483647 {
            let pointer_width: usize = 4
            pointer_width = pointer_width + 1
            if pointer_width == 5 {
                return 0
            }
        }
    }
    return 1
}
