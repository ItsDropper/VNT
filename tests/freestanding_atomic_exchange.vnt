# Compiler regression fixture for the target-specific atomic exchange intrinsic.

fun atomic_address() -> i64 {
    return 4096
}

fun atomic_value() -> i64 {
    return 1
}

fun kernel_main() {
    let previous: i64 = 0
    unsafe {
        previous = cpu_atomic_exchange_u64(atomic_address(), atomic_value())
    }
}
