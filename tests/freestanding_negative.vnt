fun kernel_main() {
    let minus_one: i64 = -1
    let computed: i64 = -2 + 1
    if minus_one != -1 {
        return 1
    }
    if computed != -1 {
        return 2
    }
    if -7 / 2 != -3 {
        return 3
    }
    if -7 % 2 != -1 {
        return 4
    }
    return 0
}
