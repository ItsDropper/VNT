# Compiler regression fixture: these calls must become direct x86-64 operations.

fun kernel_main() {
    let address: i64 = 4096
    let value: i64 = 0
    unsafe {
        value = mem_read_u64(address, 0)
        mem_write_u64(address, 8, value)
        cpu_invlpg(address)
        value = cpu_read_cr2()
        value = symbol_address("test_memory_symbol")
    }
}
