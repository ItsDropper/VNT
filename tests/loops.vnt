# Loop control

print("break")

for i in range(1, 10) {
    if i == 5 {
        break
    }

    print(i)
}

print("continue")

for i in range(1, 6) {
    if i == 3 {
        continue
    }

    print(i)
}

print("while")

x = 0

while x < 6 {
    x = x + 1

    if x == 2 {
        continue
    }

    if x == 5 {
        break
    }

    print(x)
}
