fun add_pair(a, b) {
    return a + b
}

fun sum_five(a, b, c, d, e) {
    return a + b + c + d + e
}

fun nested_call_sum(a, b, c, d, e) {
    return sum_five(
        add_pair(a, b),
        add_pair(b, c),
        add_pair(c, d),
        add_pair(d, e),
        add_pair(e, a)
    )
}

fun sum_eight(a, b, c, d, e, f, g, h) {
    return a + b + c + d + e + f + g + h
}

fun nested_call_sum_eight(a, b, c, d, e, f, g, h) {
    return sum_eight(
        add_pair(a, b),
        add_pair(b, c),
        add_pair(c, d),
        add_pair(d, e),
        add_pair(e, f),
        add_pair(f, g),
        add_pair(g, h),
        add_pair(h, a)
    )
}

print("IR:")
print(2 + 3 * 4)
print(100 > 50)
print(true && true)
print(nested_call_sum(1, 2, 3, 4, 5))
print(nested_call_sum_eight(1, 2, 3, 4, 5, 6, 7, 8))
print("Native compiler OK")
