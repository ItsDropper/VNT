import "../lib/std/mem.vnt" as mem

unsafe {
    let storage: ptr = mem.alloc(16)
    let expected: i64 = 81985529216486895
    let wrote: bool = mem.write_u64(storage, 0, expected)
    let actual: i64 = mem.read_u64(storage, 0)
    print(wrote)
    print(actual)
    print(mem.read_u8(storage, 0))
    print(mem.read_u8(storage, 7))
    print(actual == expected)
    print(mem.free(storage))
    print("MEM_U64_OK")
}
