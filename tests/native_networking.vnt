# Native networking integration test. The Python harness starts a loopback-only server.
import "../lib/std/net.vnt" as net

body = net.get("http://127.0.0.1:18765/hello")
print(body)
print(net.get("http://127.0.0.1:18765/query?x=1#fragment"))
print(net.get("http://127.0.0.1:18765/keepalive"))
print(net.get("http://127.0.0.1:18765/pool-check"))
print(net.get("http://127.0.0.1:18765/redirect"))
print(net.get("http://127.0.0.1:18765/chunked"))
print(net.get("http://127.0.0.1:18765/mentions-framing"))
print(net.get("http://127.0.0.1:18765/bad-chunked"))
binary = net.get_bytes("http://127.0.0.1:18765/binary")
print(binary)
print(len(binary))
print(binary[2])
print(net.download("http://127.0.0.1:18765/chunked", "vnt-network-chunked.test"))
print(net.download("http://127.0.0.1:18765/conflicting-length", "vnt-network-conflicting.test"))
redirect_download_ok = net.download("http://127.0.0.1:18765/redirect", "vnt-network-redirect.test")
print(net.request_bytes("POST", "http://127.0.0.1:18765/echo-bytes", "Content-Type: application/octet-stream", binary))
print(net.get_with_header("http://127.0.0.1:18765/redirect-auth", "Authorization: Bearer secret\nCookie: session=secret"))
print(net.status("http://127.0.0.1:18765/status"))
print(net.get_with_header("http://127.0.0.1:18765/header", "X-VNT-Test: present"))
print(net.get_with_header("http://127.0.0.1:18765/header", "MalformedHeaderWithoutColon"))
print(net.post_json("http://127.0.0.1:18765/echo", "{\"native\":true}"))
print(net.request("POST", "http://127.0.0.1:18765/echo", "Content-Length: 0", "SAFE_BODY"))
print(net.status("http://127.0.0.1:18765/missing"))
print(net.download("http://127.0.0.1:18765/binary", "vnt-network-binary.test"))

# Oversized buffered responses must fail instead of growing memory without bound.
print(net.get("http://127.0.0.1:18765/oversized"))

# Async requests run on a bounded native worker pool.
async_handle = net.async_start("GET", "http://127.0.0.1:18765/hello", "", "")
print(net.async_wait(async_handle, 5000))
print(net.async_result(async_handle))
print(net.async_status(async_handle))
print(net.async_release(async_handle))
\n# Cancellation must interrupt a request already blocked on the transport.\ncancel_handle = net.async_start("GET", "http://127.0.0.1:18765/slow", "", "")\nsleep_ms(100)\nprint(net.async_cancel(cancel_handle))\nprint(net.async_wait(cancel_handle, 100))\nprint(net.async_release(cancel_handle))\n