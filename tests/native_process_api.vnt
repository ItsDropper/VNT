# Windows process API smoke test. Arguments are passed as an array, not shell text.
args = ["/c", "echo VNT_PROCESS_STDOUT_OK"]
p = process_start("cmd.exe", args)
print(process_pid(p) > 0)
print(process_wait(p, 5000))
print(process_stdout(p))
print(process_stderr(p))
print(process_exit_code(p))
print(process_poll(p))

stderr_args = ["/c", "echo VNT_PROCESS_STDERR_OK 1>&2 & exit /b 7"]
stderr_process = process_start("cmd.exe", stderr_args)
print(process_wait(stderr_process, 5000))
print(process_stdout(stderr_process))
print(process_stderr(stderr_process))
print(process_exit_code(stderr_process))

slow_args = ["/c", "timeout /t 10 /nobreak > nul"]
slow = process_start("cmd.exe", slow_args)
print(process_wait(slow, 10))
print(process_terminate(slow))
print(process_wait(slow, 5000))
print("NATIVE_PROCESS_API_OK")
