import "../lib/std/array.vnt" as array

print(array.contains(["a", "b"], "b"))
print(array.index_of([4, 8, 4], 8))
print(array.count([4, 8, 4], 4))
print(array.sum([1, 2, 3]))
print(array.average([1, 2]))
print(array.average([]))
print(array.min([-3, 2, 5]))
print(array.max([-3, 2, 5]))
reversed = array.reverse([1, 2, 3])
print(len(reversed))
print(reversed[0])
taken = array.take([1, 2, 3], 2)
print(len(taken))
dropped = array.drop([1, 2, 3], 1)
print(dropped[0])
deduplicated = array.unique(["a", "b", "a"])
print(len(deduplicated))
print(deduplicated[1])
print(array.join(["a", "b", "c"], "-"))
print(len(array.unique([])))
duplicates = array.unique(["x", "x", "x", "y", "x"])
print(len(duplicates))
print(duplicates[1])
print(len(array.take([7, 8], -1)))
print(len(array.drop([7, 8], 9)))
print("ARRAY_STANDARD_LIBRARY_OK")
