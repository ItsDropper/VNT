import "../lib/std/bigint.vnt" as bigint

print(bigint.add("999999999999999999999", "1"))
print(bigint.subtract("1000000000000000000000", "1"))
print(bigint.multiply("12345678901234567890", "9"))
print(bigint.add("-999", "1000"))
print(bigint.subtract("2", "10"))
print(bigint.multiply("-123456789", "0"))
print(bigint.compare("-100", "-2"))
print(bigint.compare("00042", "42"))
print(bigint.compare("900719925474099312345", "900719925474099312344"))
print("BIGINT_RUNTIME_OK")
