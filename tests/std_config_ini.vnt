import "../lib/std/config.vnt" as config
 
# Deliberately collide with an exported config helper. Calls made inside the
# imported module must bind to config__get, not this caller-scope function.
fun get(text, section, key, default_value) {
    return "GLOBAL_SHADOW"
}

settings = "# app settings\nroot = enabled\n\n[display]\n; comment\ntheme = \"dark mode\"\nscale=125\nfeature=true\nfeature_off=no\nfeature_mixed= TrUe \nfeature_no=No\nfeature_unknown=perhaps\nvalue=a=b\nsentinel=__VNT_CONFIG_KEY_NOT_FOUND_7F2A__\n[network]\ntimeout = 30\n"

print(config.get(settings, "", "root", "missing"))
print(config.get(settings, "display", "theme", "missing"))
print(config.get(settings, "display", "scale", "100"))
print(config.get(settings, "display", "value", "missing"))
print(config.get(settings, "display", "absent", "fallback"))
print(config.get_bool(settings, "display", "feature", false))
print(config.get_bool(settings, "display", "feature_off", true))
print(config.get_bool(settings, "display", "unknown", true))
print(config.get_bool(settings, "display", "feature_mixed", false))
print(config.get_bool(settings, "display", "feature_no", true))
print(config.get_bool(settings, "display", "feature_unknown", false))
print(config.has_key(settings, "display", "theme"))
print(config.has_key(settings, "display", "absent"))
print(config.has_key(settings, "display", "sentinel"))
print(config.section_exists(settings, "network"))
print(config.section_exists(settings, "missing"))

# INI documents may use LF, CRLF, or legacy CR line endings.
crlf_settings = "[display]\r\ntheme=light\r\n[network]\rtimeout=45\r"
print(config.get(crlf_settings, "display", "theme", "missing"))
print(config.get(crlf_settings, "network", "timeout", "missing"))
print(config.has_key(crlf_settings, "network", "timeout"))
print(config.section_exists(crlf_settings, "network"))
print("INI_CONFIG_OK")
