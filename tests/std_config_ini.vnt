import "../lib/std/config.vnt" as config

settings = "# app settings\nroot = enabled\n\n[display]\n; comment\ntheme = \"dark mode\"\nscale=125\nfeature=true\nfeature_off=no\nvalue=a=b\nsentinel=__VNT_CONFIG_KEY_NOT_FOUND_7F2A__\n[network]\ntimeout = 30\n"

print(config.get(settings, "", "root", "missing"))
print(config.get(settings, "display", "theme", "missing"))
print(config.get(settings, "display", "scale", "100"))
print(config.get(settings, "display", "value", "missing"))
print(config.get(settings, "display", "absent", "fallback"))
print(config.get_bool(settings, "display", "feature", false))
print(config.get_bool(settings, "display", "feature_off", true))
print(config.get_bool(settings, "display", "unknown", true))
print(config.has_key(settings, "display", "theme"))
print(config.has_key(settings, "display", "absent"))
print(config.has_key(settings, "display", "sentinel"))
print(config.section_exists(settings, "network"))
print(config.section_exists(settings, "missing"))
print("INI_CONFIG_OK")
