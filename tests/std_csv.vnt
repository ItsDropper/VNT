import "../lib/std/csv.vnt" as csv

source = "name,notes\r\nAda,\"likes, commas\"\r\nBob,\"line 1\nline 2\"\r\nQuote,\"a \"\"quote\"\"\"\r\n"
rows = csv.parse(source)
print(len(rows))
print(rows[0][0])
print(rows[1][0])
print(rows[1][1])
print(len(rows[2][1]))
print(rows[3][1])
encoded = csv.stringify(rows)
round_trip = csv.parse(encoded)
print(round_trip[1][1])
print(len(round_trip[2][1]))
print(round_trip[3][1])
print(csv.parse("\"unterminated"))
print(csv.parse("a\"b,c"))
print(csv.parse("\"closed\"x"))
quoted_crlf_rows = csv.parse("\"first\r\nsecond\",tail")
print(len(quoted_crlf_rows))
print(len(quoted_crlf_rows[0][0]))
print(quoted_crlf_rows[0][1])
trailing_empty_rows = csv.parse("left,")
print(len(trailing_empty_rows[0]))
print(len(trailing_empty_rows[0][1]))
lone_cr_rows = csv.parse("left\rright")
print(len(lone_cr_rows))
print(lone_cr_rows[0][0])
print(lone_cr_rows[1][0])
empty_field_csv = csv.stringify([[""]])
print(empty_field_csv)
empty_field_rows = csv.parse(empty_field_csv)
print(len(empty_field_rows))
print(len(empty_field_rows[0]))
print(len(empty_field_rows[0][0]))
multiple_empty_csv = csv.stringify([["", "middle", ""]])
print(multiple_empty_csv)
multiple_empty_rows = csv.parse(multiple_empty_csv)
print(len(multiple_empty_rows[0]))
print(len(multiple_empty_rows[0][0]))
print(multiple_empty_rows[0][1])
print(len(multiple_empty_rows[0][2]))
print("CSV_STANDARD_LIBRARY_OK")
