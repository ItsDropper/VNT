import "../lib/std/fs.vnt" as fs

directory = "tests/out/std_fs_tmp"
first_path = directory + "/sample.txt"
renamed_path = directory + "/renamed.txt"

created_dir = fs.create_dir(directory)
removed_first = fs.remove_file(first_path)
removed_renamed = fs.remove_file(renamed_path)

if !fs.is_dir(directory) {
    print("FS_FAIL_DIR")
} else {
    if !fs.write_text(first_path, "hello") {
        print("FS_FAIL_WRITE")
    } else {
        appended = fs.append_text(first_path, " world")
        if fs.read_text(first_path) != "hello world" {
            print("FS_FAIL_READ_APPEND")
        } else {
            entries = fs.list_dir(directory)
            found = false
            i = 0
            while i < len(entries) {
                if entries[i] == "sample.txt" {
                    found = true
                }
                i = i + 1
            }
            if !found {
                print("FS_FAIL_LIST")
            } else {
                if !fs.is_file(first_path) {
                    print("FS_FAIL_IS_FILE")
                } else {
                    if !fs.rename_path(first_path, renamed_path) {
                        print("FS_FAIL_RENAME")
                    } else {
                        if !fs.exists(renamed_path) {
                            print("FS_FAIL_RENAMED_FILE")
                        } else {
                            if !fs.is_file(renamed_path) {
                                print("FS_FAIL_RENAMED_FILE")
                            } else {
                                if !fs.remove_file(renamed_path) {
                                    print("FS_FAIL_DELETE")
                                } else {
                                    print("FS_OK")
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

line_checks_ok = true
line_path = directory + "/lines.txt"
missing_path = directory + "/missing.txt"
empty_path = directory + "/empty.txt"
append_empty_path = directory + "/append-empty.txt"
append_plain_path = directory + "/append-plain.txt"
append_lf_path = directory + "/append-lf.txt"

removed_lines = fs.remove_file(line_path)
removed_missing = fs.remove_file(missing_path)
removed_empty = fs.remove_file(empty_path)
removed_append_empty = fs.remove_file(append_empty_path)
removed_append_plain = fs.remove_file(append_plain_path)
removed_append_lf = fs.remove_file(append_lf_path)

missing_lines = fs.read_lines(missing_path)
if len(missing_lines) != 0 {
    line_checks_ok = false
}
if !fs.write_text(empty_path, "") {
    line_checks_ok = false
} else {
    empty_lines = fs.read_lines(empty_path)
    if len(empty_lines) != 0 {
        line_checks_ok = false
    }
}

if !fs.write_text(line_path, "one\ntwo\nthree\n") {
    line_checks_ok = false
} else {
    line_items = fs.read_lines(line_path)
    if len(line_items) != 3 {
        line_checks_ok = false
    } else {
        if line_items[0] != "one" {
            line_checks_ok = false
        }
        if line_items[1] != "two" {
            line_checks_ok = false
        }
        if line_items[2] != "three" {
            line_checks_ok = false
        }
    }
}

if !fs.write_text(line_path, "one\r\ntwo\r\nthree\r\n") {
    line_checks_ok = false
} else {
    line_items = fs.read_lines(line_path)
    if len(line_items) != 3 {
        line_checks_ok = false
    } else {
        if line_items[0] != "one" {
            line_checks_ok = false
        }
        if line_items[1] != "two" {
            line_checks_ok = false
        }
        if line_items[2] != "three" {
            line_checks_ok = false
        }
    }
}

if !fs.write_text(line_path, "one\rtwo\rthree\r") {
    line_checks_ok = false
} else {
    line_items = fs.read_lines(line_path)
    if len(line_items) != 3 {
        line_checks_ok = false
    } else {
        if line_items[0] != "one" {
            line_checks_ok = false
        }
        if line_items[1] != "two" {
            line_checks_ok = false
        }
        if line_items[2] != "three" {
            line_checks_ok = false
        }
    }
}

if !fs.write_text(line_path, "one\rtwo\r\nthree\n") {
    line_checks_ok = false
} else {
    line_items = fs.read_lines(line_path)
    if len(line_items) != 3 {
        line_checks_ok = false
    } else {
        if line_items[0] != "one" {
            line_checks_ok = false
        }
        if line_items[1] != "two" {
            line_checks_ok = false
        }
        if line_items[2] != "three" {
            line_checks_ok = false
        }
    }
}

if !fs.write_text(line_path, "one\n\n") {
    line_checks_ok = false
} else {
    line_items = fs.read_lines(line_path)
    if len(line_items) != 2 {
        line_checks_ok = false
    } else {
        if line_items[0] != "one" {
            line_checks_ok = false
        }
        if line_items[1] != "" {
            line_checks_ok = false
        }
    }
}

if !fs.write_text(line_path, "\n") {
    line_checks_ok = false
} else {
    blank_only_lines = fs.read_lines(line_path)
    if len(blank_only_lines) != 1 {
        line_checks_ok = false
    } else {
        if blank_only_lines[0] != "" {
            line_checks_ok = false
        }
    }
}

empty_write_lines_path = directory + "/write-lines-empty.txt"
removed_empty_write_lines = fs.remove_file(empty_write_lines_path)
empty_source_lines = []
if !fs.write_lines(empty_write_lines_path, empty_source_lines) {
    line_checks_ok = false
} else {
    empty_round_trip_lines = fs.read_lines(empty_write_lines_path)
    if len(empty_round_trip_lines) != 0 {
        line_checks_ok = false
    }
}

if !fs.write_text(append_empty_path, "") {
    line_checks_ok = false
} else {
    if !fs.append_line(append_empty_path, "first") {
        line_checks_ok = false
    } else {
        if fs.read_text(append_empty_path) != "first\n" {
            line_checks_ok = false
        }
    }
}

if !fs.write_text(append_plain_path, "alpha") {
    line_checks_ok = false
} else {
    if !fs.append_line(append_plain_path, "beta") {
        line_checks_ok = false
    } else {
        if fs.read_text(append_plain_path) != "alpha\nbeta\n" {
            line_checks_ok = false
        }
    }
}

if !fs.write_text(append_lf_path, "alpha\n") {
    line_checks_ok = false
} else {
    if !fs.append_line(append_lf_path, "beta") {
        line_checks_ok = false
    } else {
        if fs.read_text(append_lf_path) != "alpha\nbeta\n" {
            line_checks_ok = false
        }
    }
}

append_blank_path = directory + "/append-blank.txt"
if !fs.write_text(append_blank_path, "alpha\n\n") {
    line_checks_ok = false
} else {
    if !fs.append_line(append_blank_path, "beta") {
        line_checks_ok = false
    } else {
        if fs.read_text(append_blank_path) != "alpha\n\nbeta\n" {
            line_checks_ok = false
        }
    }
}


write_lines_path = directory + "/write-lines.txt"
removed_write_lines = fs.remove_file(write_lines_path)
sample_lines = ["red", "green", "blue"]
if !fs.write_lines(write_lines_path, sample_lines) {
    line_checks_ok = false
} else {
    round_trip_lines = fs.read_lines(write_lines_path)
    if len(round_trip_lines) != 3 {
        line_checks_ok = false
    } else {
        if round_trip_lines[0] != "red" {
            line_checks_ok = false
        }
        if round_trip_lines[1] != "green" {
            line_checks_ok = false
        }
        if round_trip_lines[2] != "blue" {
            line_checks_ok = false
        }
    }
}

if line_checks_ok {
    print("FS_READ_LINES_OK")
} else {
    print("FS_FAIL_LINE_REGRESSION")
}

fs.remove_file(line_path)
fs.remove_file(empty_path)
fs.remove_file(append_empty_path)
fs.remove_file(append_plain_path)
fs.remove_file(append_lf_path)
cleanup_append_blank = fs.remove_file(append_blank_path)
fs.remove_file(write_lines_path)
cleanup_empty_write_lines = fs.remove_file(empty_write_lines_path)

atomic_path = directory + "/atomic.txt"
if !fs.write_text(atomic_path, "before-atomic-replacement") {
    print("FS_FAIL_ATOMIC_SETUP")
} else {
    if !fs.write_text_atomic(atomic_path, "atomic-content") {
        print("FS_FAIL_ATOMIC_WRITE")
    } else {
        if fs.read_text(atomic_path) != "atomic-content" {
            print("FS_FAIL_ATOMIC_CONTENT")
        }
        if !fs.write_text_atomic(atomic_path, "") {
            print("FS_FAIL_ATOMIC_EMPTY_WRITE")
        } else {
            if !fs.exists(atomic_path) {
                print("FS_FAIL_ATOMIC_EMPTY_EXISTS")
            } else {
                if fs.read_text(atomic_path) != "" {
                    print("FS_FAIL_ATOMIC_EMPTY_CONTENT")
                }
            }
        }
    }
}
missing_parent_atomic_path = directory + "/missing-parent/atomic.txt"
if fs.write_text_atomic(missing_parent_atomic_path, "must-not-exist") {
    print("FS_FAIL_ATOMIC_MISSING_PARENT")
}
fs.remove_file(atomic_path)

print("STANDARD_FS_OK")
