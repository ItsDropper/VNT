import "../lib/std/time.vnt" as time
import "../lib/std/path.vnt" as path
import "../lib/std/net.vnt" as net
import "../lib/std/json.vnt" as json

print(time.minutes_to_ms(2))
print(time.hours_to_ms(1))
print(time.days_to_ms(1))
print(time.ms_to_minutes(120000))
print(time.ms_to_hours(3600000))
print(time.ms_to_days(86400000))
deadline = time.deadline_after(5000)
print(time.remaining_ms(deadline) > 0)
print(time.remaining_ms(deadline) <= 5000)
print(time.has_elapsed(0, 0))
print(path.is_absolute("/usr/bin/vnt"))
print(path.is_absolute("C:\\VNT\\main.vnt"))
print(path.is_absolute("relative/file"))
print(path.change_extension("src/main.vnt", "exe"))
print(path.change_extension("C:\\VNT\\main.vnt", ".elf"))
print(path.change_extension(".env", "txt"))
print(net.is_success_status("200"))
print(net.is_success_status("299"))
print(net.is_redirect_status("302"))
print(net.is_client_error_status("404"))
print(net.is_server_error_status("503"))
print(net.is_transport_error_status("000"))
print(net.encode_form(["name", "theme"], ["Ada", "dark"]))
print(net.encode_form(["only-one"], []))
payload = "{\"title\":\"VNT\",\"empty\":\"\",\"count\":42}"
print(json.value_or(payload, "title", 0, "fallback"))
print(json.value_or(payload, "missing", 0, "fallback"))
print(json.has_key(payload, "title", 0))
print(json.has_key(payload, "missing", 0))
print(time.is_leap_year(2000))
print(time.is_leap_year(1900))
print(time.is_leap_year(2024))
print(time.days_in_month(2024, 2))
print(time.is_valid_date(2023, 2, 29))
print(time.day_of_year(2024, 3, 1))
print(time.weekday(2024, 1, 1))
print(time.weekday(2000, 1, 1))
print(time.weekday(2024, 13, 1))
print("STD_IMPROVED_MODULES_OK")
