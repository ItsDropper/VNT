# Compile-only test: deliberately makes no network requests.
import "../lib/std/net.vnt" as net

body = net.get("https://example.com/")
header_body = net.get_with_header("https://example.com/", "Accept: text/plain")
bearer_body = net.get_bearer("https://example.com/api", "test-token")
json_body = net.get_json("https://example.com/api")
json_bearer_body = net.get_json_bearer("https://example.com/api", "test-token")
created = net.post_json("https://example.com/api", "{\"ready\":true}")
created_auth = net.post_json_bearer("https://example.com/api", "test-token", "{\"ready\":true}")
updated = net.put_json("https://example.com/api/item", "{\"ready\":true}")
updated_auth = net.put_json_bearer("https://example.com/api/item", "test-token", "{\"ready\":true}")
patched = net.patch_json("https://example.com/api/item", "{\"ready\":true}")
patched_auth = net.patch_json_bearer("https://example.com/api/item", "test-token", "{\"ready\":true}")
form_result = net.post_form("https://example.com/form", "name=test&ready=true")
deleted = net.delete_request("https://example.com/api/item")
deleted_auth = net.delete_bearer("https://example.com/api/item", "test-token")
status_code = net.status("https://example.com/")
header_status = net.status_with_header("https://example.com/", "Accept: application/json")
auth_status = net.status_bearer("https://example.com/api", "test-token")
head_code = net.head_status("https://example.com/")
downloaded = net.download("https://example.com/file", "tests/out/network-download.bin")
downloaded_auth = net.download_bearer("https://example.com/private-file", "tests/out/private-download.bin", "test-token")
print("STD_NETWORK_COMPILE_OK")
