import "../lib/std/number.vnt" as number

print(number.min(4, 9))
print(number.min(-4, -9))
print(number.max(4, 9))
print(number.max(-4, -9))
print(number.clamp(5, 0, 10))
print(number.clamp(-5, 0, 10))
print(number.clamp(15, 0, 10))
print(number.clamp(5, 10, 0))
print(number.is_between(5, 0, 10))
print(number.is_between(10, 0, 10))
print(number.is_between(-1, 0, 10))
print(number.is_between(5, 10, 0))
print(number.is_between(5, 5, 5))
print(number.is_even(0))
print(number.is_even(-4))
print(number.is_odd(-3))
print(number.sign(-7))
print(number.sign(0))
print(number.sign(9))
print(number.factorial(0))
print(number.factorial(5))
print(number.factorial(-1))
print(number.factorial(20))
print(number.factorial(21))
print(number.gcd((-9223372036854775807 - 1), 2))
print(number.gcd((-9223372036854775807 - 1), 0))
print(number.gcd((-9223372036854775807 - 1), 1))
print(number.gcd(-1, (-9223372036854775807 - 1)))
print(number.gcd(54, 24))
print(number.gcd(-54, 24))
print(number.gcd(0, 0))
print(number.is_prime(-1))
print(number.is_prime(0))
print(number.is_prime(1))
print(number.is_prime(2))
print(number.is_prime(3))
print(number.is_prime(4))
print(number.is_prime(97))
print(number.is_prime(99))
print(number.is_prime(2147483647))
print(number.is_prime(2147483646))
print(number.is_prime(2147483645))
print(number.is_divisible_by(12, 3))
print(number.is_divisible_by(12, 5))
print(number.is_divisible_by(0, 7))
print(number.is_divisible_by(7, 0))
print(number.is_divisible_by((-9223372036854775807 - 1), -1))
print(number.is_power_of_two(1))
print(number.is_power_of_two(2))
print(number.is_power_of_two(1024))
print(number.is_power_of_two(2147483648))
print(number.is_power_of_two(0))
print(number.is_power_of_two(-2))
print(number.is_power_of_two(12))
print("NUMBER_STANDARD_LIBRARY_OK")
