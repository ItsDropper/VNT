import "../lib/std/number.vnt" as number

print(number.min(4, 9))
print(number.min(-4, -9))
print(number.max(4, 9))
print(number.max(-4, -9))
print(number.clamp(5, 0, 10))
print(number.clamp(-5, 0, 10))
print(number.clamp(15, 0, 10))
print(number.clamp(5, 10, 0))
print(number.is_even(0))
print(number.is_even(-4))
print(number.is_odd(-3))
print(number.sign(-7))
print(number.sign(0))
print(number.sign(9))
print(number.factorial(0))
print(number.factorial(5))
print(number.factorial(-1))
print(number.gcd(54, 24))
print(number.gcd(-54, 24))
print(number.gcd(0, 0))
print(number.is_prime(-1))
print(number.is_prime(0))
print(number.is_prime(1))
print(number.is_prime(2))
print(number.is_prime(3))
print(number.is_prime(4))
print(number.is_prime(97))
print(number.is_prime(99))
print(number.is_prime(2147483647))
print(number.is_prime(2147483646))
print("NUMBER_STANDARD_LIBRARY_OK")
