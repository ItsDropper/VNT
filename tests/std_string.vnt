import "../lib/std/string.vnt" as string

print(string.is_empty(""))
print(string.is_not_empty("vnt"))
print(string.starts_with("vnt compiler", "vnt"))
print(string.starts_with("vnt", "compiler"))
print(string.ends_with("main.vnt", ".vnt"))
print(string.index_of("banana", "na"))
print(string.last_index_of("banana", "na"))
print(string.contains("banana", "nan"))
print(string.count("aaaa", "aa"))
print(string.repeat("ab", 3))
print(string.replace("one two one", "one", "1"))
print(string.trim(" \tvalue\r\n"))
parts = string.split("a,,b,", ",")
print(len(parts))
print(parts[0])
print(len(parts[1]))
print(parts[2])
print(len(parts[3]))
empty_parts = string.split("", "")
print(len(empty_parts))
print(len(empty_parts[0]))
empty_input_parts = string.split("", ",")
print(len(empty_input_parts))
print(len(empty_input_parts[0]))
empty_delimiter_parts = string.split("abc", "")
print(len(empty_delimiter_parts))
print(empty_delimiter_parts[0])
print(string.left("abcdef", 3))
print(string.left("abc", -1))
print(string.right("abcdef", 2))
print(string.right("abc", 9))
print(string.remove_prefix("vnt compiler", "vnt "))
print(string.remove_suffix("main.vnt", ".vnt"))
print(string.remove_prefix("vnt", "x"))
print(string.remove_suffix("vnt", "x"))
print(string.pad_left("7", 3, "0"))
print(string.pad_right("x", 4, "ab"))
print(string.pad_left("x", 3, ""))
print(string.pad_left("abcdef", 3, "0"))
print(string.pad_right("abcdef", 3, "0"))
print(string.pad_left("x", 4, "ab"))
print(string.pad_right("x", 4, "ab"))
print(string.pad_left("", 3, "ab"))
print(string.pad_right("", 3, "ab"))
print(string.count_lines(""))
print(string.count_lines("a\nb\n"))
print(string.count_lines("a\n\n"))
print(string.count_lines("a\r\nb\r\n"))
print(string.count_lines("a\rb\r"))
print(string.count_lines("a\r\nb\nc\r"))
print(string.starts_with("vnt", ""))
print(string.ends_with("vnt", ""))
print(string.index_of("banana", ""))
print(string.count("aaaaa", "aa"))
print(string.count("banana", "ana"))
print(string.replace("abc", "", "-"))
print(string.replace("abc", "x", "y"))
print(string.index_of("ababac", "abac"))
print(string.contains("abab", "ac"))
print(string.last_index_of("abcabc", "abd"))
print(string.replace("abcabc", "abd", "x"))
parts_multi = string.split("one::two::", "::")
print(len(parts_multi))
print(parts_multi[0])
print(parts_multi[1])
print(len(parts_multi[2]))
print("STRING_STANDARD_LIBRARY_OK")
