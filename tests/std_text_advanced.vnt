import "../lib/std/string.vnt" as text

parts = text.split("alpha,,gamma,", ",")
print(len(parts))
print(parts[0])
print(parts[1] == "")
print(parts[2])
print(parts[3] == "")
print(text.last_index_of("one two one", "one"))
print(text.left("abcdef", 3))
print(text.right("abcdef", 2))
print(text.remove_prefix("prefix-value", "prefix-"))
print(text.remove_suffix("filename.txt", ".txt"))
print(text.pad_left("42", 5, "0"))
print(text.pad_right("vnt", 6, "."))
print(text.count_lines("one\ntwo\n"))
print(text.count_lines(""))
print("STD_TEXT_ADVANCED_OK")
