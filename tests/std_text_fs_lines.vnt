import "../lib/std/fs.vnt" as fs

line_path = "tests/out/std_lines.txt"
written = fs.write_lines(line_path, ["first", "second"])
read_back = fs.read_lines(line_path)
print(written)
print(len(read_back))
print(read_back[0])
print(read_back[1])
appended = fs.append_line(line_path, "third")
read_back = fs.read_lines(line_path)
print(appended)
print(len(read_back))
print(read_back[2])
print("STD_FS_LINES_OK")
