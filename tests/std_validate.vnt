import "../lib/std/validate.vnt" as validate

print(validate.is_blank(""))
print(validate.is_blank(" \t\r\n"))
print(validate.is_blank(" vnt "))
print(validate.is_digit("7"))
print(validate.is_digit("x"))
print(validate.is_ascii_letter("Z"))
print(validate.is_ascii_letter("4"))
print(validate.is_alphanumeric("a"))
print(validate.is_alphanumeric("_"))
print(validate.is_integer("0"))
print(validate.is_integer("-123"))
print(validate.is_integer("+42"))
print(validate.is_integer("+"))
print(validate.is_integer("12.0"))
print(validate.is_decimal("-12.5"))
print(validate.is_decimal(".5"))
print(validate.is_decimal("5."))
print(validate.is_decimal("."))
print(validate.is_decimal("1.2.3"))
print(validate.is_hex_digit("F"))
print(validate.is_hex_digit("g"))
print(validate.is_identifier("_private2"))
print(validate.is_identifier("2bad"))
print(validate.looks_like_email("dev@example.com"))
print(validate.looks_like_email("dev@@example.com"))
print(validate.looks_like_email("dev@example"))
print(validate.looks_like_http_url("https://example.com/path"))
print(validate.looks_like_http_url("http://localhost:8080"))
print(validate.looks_like_http_url("file:///tmp/a"))
print(validate.looks_like_http_url("https://bad host"))
print(validate.is_lower_ascii("m"))
print(validate.is_lower_ascii("M"))
print(validate.is_upper_ascii("Z"))
print(validate.is_upper_ascii("z"))
print(validate.looks_like_email("dev@.example.com"))
print(validate.looks_like_email("dev@example..com"))
print(validate.looks_like_email("@example.com"))
print(validate.looks_like_email("dev@example.com."))
print(validate.looks_like_http_url("https://?query"))
print(validate.looks_like_http_url("https://#fragment"))
print(validate.looks_like_http_url("https://"))
print(validate.looks_like_http_url("http://example.com?q=x"))
print(validate.looks_like_email("dev..ops@example.com"))
print(validate.looks_like_email("dev.@example.com"))
print(validate.looks_like_email("dev@-example.com"))
print(validate.looks_like_email("dev@example-.com"))
print(validate.looks_like_email("dev+tag_1@example-domain.com"))
print("STDLIB_VALIDATE_OK")
