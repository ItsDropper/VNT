fun add(a: int, b: int) -> int {
    return a + b
}

fun label(active: bool) -> string {
    if active {
        return "active"
    } else {
        return "inactive"
    }
}

fun circle_area(radius: float) -> float {
    return radius * radius * 3.14
}

print(add(20, 22))
print(label(true))
print(circle_area(2.0))
print("TYPED_FUNCTIONS_OK")
