import "../lib/std/mem.vnt" as mem

unsafe {
    let first: ptr = mem.alloc(16)
    let second: ptr = mem.alloc(16)

    let wrote_first: bool = mem.write_u32(first, 0, 305419896)
    let resized: ptr = mem.realloc(first, 32)
    if !mem.is_null(resized) {
        first = resized
    }
    print(mem.read_u32(first, 0))

    let copied: bool = mem.copy(second, first, 4)
    print(mem.read_u32(second, 0))

    let filled: bool = mem.set(first, 255, 4)
    print(mem.read_u8(first, 0))

    let shifted: ptr = mem.offset(second, 4)
    let wrote_shifted: bool = mem.write_u8(shifted, 0, 42)
    print(mem.read_u8(second, 4))

    # mem.copy must behave like memmove when source and destination overlap.
    let write0: bool = mem.write_u8(first, 0, 1)
    let write1: bool = mem.write_u8(first, 1, 2)
    let write2: bool = mem.write_u8(first, 2, 3)
    let write3: bool = mem.write_u8(first, 3, 4)
    let overlap_destination: ptr = mem.offset(first, 1)
    let overlap_source: ptr = mem.offset(first, 0)
    let overlap_copy: bool = mem.copy(overlap_destination, overlap_source, 3)
    print(overlap_copy)
    print(mem.read_u8(first, 0))
    print(mem.read_u8(first, 1))
    print(mem.read_u8(first, 2))
    print(mem.read_u8(first, 3))

    # mem.set fills exactly the requested byte range.
    let filled_second: bool = mem.set(second, 165, 4)
    print(filled_second)
    print(mem.read_u8(second, 0))
    print(mem.read_u8(second, 3))

    # Empty ranges are valid no-ops and must not modify memory.
    let empty_copy: bool = mem.copy(second, first, 0)
    let empty_set: bool = mem.set(second, 0, 0)
    print(empty_copy)
    print(empty_set)

    # Zero-length operations do not dereference their pointer arguments.
    let null_pointer: ptr = null
    let null_empty_copy: bool = mem.copy(null_pointer, null_pointer, 0)
    let null_empty_set: bool = mem.set(null_pointer, 0, 0)
    print(null_empty_copy)
    print(null_empty_set)

    let freed_first: bool = mem.free(first)
    let freed_second: bool = mem.free(second)
    print(freed_first)
    print(freed_second)
    print("RAW_MEMORY_OK")
}
